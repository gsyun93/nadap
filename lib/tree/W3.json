{"start":"W3-0","nodes":{"W3-0":{"q":"누구 때문에 제일 힘들어요?","o":["바로 위 상사","같이 일하는 동료","팀 분위기 전체","회사 높은 사람들"],"n":["W3-1","W3-2","W3-3","W3-4"]},"W3-1":{"q":"상사의 어떤 점이 제일 힘들어요?","o":["말투가 너무 거칠어서 힘들어","일을 나한테 다 떠넘겨","나만 미워하는 것 같아","기분 따라 태도가 달라져"],"n":["W3-1.1","W3-1.2","W3-1.3","W3-1.4"]},"W3-2":{"q":"동료와는 어떤 게 제일 힘들어요?","o":["일을 안 하고 자꾸 미뤄","뒤에서 말이 너무 많아","은근히 나랑 경쟁해","나만 겉도는 느낌이야"],"n":["W3-2.1","W3-2.2","W3-2.3","W3-2.4"]},"W3-3":{"q":"팀 분위기가 어떻길래 힘들어요?","o":["다들 너무 날카로워","말이 없고 분위기가 차가워","일이 몰려서 다 지쳤어","편 가르기가 있는 것 같아"],"n":["W3-3.1","W3-3.2","W3-3.3","W3-3.4"]},"W3-4":{"q":"높은 사람들의 어떤 점이 힘들어요?","o":["현장을 너무 모르는 것 같아","방향이 자꾸 바뀌어서 힘들어","무리한 목표를 자꾸 줘","사람을 소모품처럼 보는 것 같아"],"n":["W3-4.1","W3-4.2","W3-4.3","W3-4.4"]},"W3-1.1":{"q":"그 말투를 들으면 어떤 기분이에요?","o":["듣고 나면 자꾸 위축돼","화가 나는데 그냥 참아","그 말이 하루 종일 맴돌아","이젠 좀 무뎌진 것 같아"],"n":["W3-1.1.1","W3-1.1.2","W3-1.1.3","W3-1.1.4"]},"W3-1.2":{"q":"떠넘기는 일은 어느 정도예요?","o":["내 일보다 더 많아","꼭 마감 직전에 줘","공은 자기가 가져가","거절하면 눈치를 줘"],"n":["W3-1.2.1","W3-1.2.2","W3-1.2.3","W3-1.2.4"]},"W3-1.3":{"q":"미워한다고 느끼는 순간은?","o":["나한테만 지적하는 것 같아","다른 사람만 챙기는 것 같아","내 말을 무시하는 것 같아","대놓고 차갑게 대하더라"],"n":["W3-1.3.1","W3-1.3.2","W3-1.3.3","W3-1.3.4"]},"W3-1.4":{"q":"기분이 바뀌면 어떻게 대해요?","o":["기분 좋을 땐 잘해줘","기분 안 좋으면 화풀이해","어떻게 나올지 예측이 안 돼","말 걸기가 무서울 때가 있어"],"n":["W3-1.4.1","W3-1.4.2","W3-1.4.3","W3-1.4.4"]},"W3-2.1":{"q":"그 사람 몫까지 하면 어떤 마음이에요?","o":["그 사람 몫까지 하니 너무 억울해","몸도 마음도 완전히 지쳐버렸어","말하고 싶은데 입이 안 떨어져","그냥 내가 하는 게 더 편해"],"n":["W3-2.1.1","W3-2.1.2","W3-2.1.3","W3-2.1.4"]},"W3-2.2":{"q":"뒷말을 들으면 어떤 기분이에요?","o":["사람이 무서워지기 시작해","나도 대상일까 봐 불안해","듣기만 해도 너무 지쳐","나도 모르게 같이 끼게 돼"],"n":["W3-2.2.1","W3-2.2.2","W3-2.2.3","W3-2.2.4"]},"W3-2.3":{"q":"경쟁이 느껴지는 건 어떤 때예요?","o":["내 성과를 가로챌 때야","은근히 나를 깎아내릴 때야","윗사람 앞에서만 달라질 때야","정보를 안 나눠줄 때야"],"n":["W3-2.3.1","W3-2.3.2","W3-2.3.3","W3-2.3.4"]},"W3-2.4":{"q":"겉돈다고 느끼는 순간은?","o":["점심을 늘 혼자 먹을 때야","대화에 못 낄 때가 많아","나만 정보가 늦을 때야","회식 자리가 너무 불편해"],"n":["W3-2.4.1","W3-2.4.2","W3-2.4.3","W3-2.4.4"]},"W3-3.1":{"q":"날카로운 분위기는 언제부터였어요?","o":["일이 몰리면서 그랬던 것 같아","사람이 바뀌면서 달라진 것 같아","원래부터 그랬던 분위기야","언제부터인지 잘 모르겠어"],"n":["W3-3.1.1","W3-3.1.2","W3-3.1.3","W3-3.1.4"]},"W3-3.2":{"q":"차가운 분위기에서 제일 힘든 건?","o":["물어볼 사람이 하나도 없어","그냥 많이 외로워","내가 일만 하는 기계 같아","실수해도 아무 말이 없어"],"n":["W3-3.2.1","W3-3.2.2","W3-3.2.3","W3-3.2.4"]},"W3-3.3":{"q":"다들 지친 팀에서 나는 어때요?","o":["나도 이미 바닥이야","내가 챙기느라 더 지쳐","아직은 그럭저럭 버틸 만해","나만 덜 지쳐서 미안해"],"n":["W3-3.3.1","W3-3.3.2","W3-3.3.3","W3-3.3.4"]},"W3-3.4":{"q":"편 가르기는 어떤 식이에요?","o":["친한 무리끼리만 서로 챙겨","윗사람 라인이 따로 있어","뒷말 때문에 갈라져 있어","나도 어느새 한 편이 됐어"],"n":["W3-3.4.1","W3-3.4.2","W3-3.4.3","W3-3.4.4"]},"W3-4.1":{"q":"현장을 모른다고 느끼는 순간은?","o":["말도 안 되는 지시를 내려","현장 목소리를 그냥 무시해","숫자만 보고 판단하는 것 같아","얼굴 볼 일도 거의 없어"],"n":["W3-4.1.1","W3-4.1.2","W3-4.1.3","W3-4.1.4"]},"W3-4.2":{"q":"방향이 바뀌면 나한테 무슨 일이 생겨요?","o":["하던 일이 그냥 날아가 버려","처음부터 다시 해야 해","일이 두 배로 늘어나 버려","뭘 해야 할지 모르겠어"],"n":["W3-4.2.1","W3-4.2.2","W3-4.2.3","W3-4.2.4"]},"W3-4.3":{"q":"목표가 얼마나 무리해요?","o":["절대 못 맞출 것 같아","맞추려다 몸이 망가질 것 같아","목표가 매번 계속 올라가","왜 그런지 이유도 모르겠어"],"n":["W3-4.3.1","W3-4.3.2","W3-4.3.3","W3-4.3.4"]},"W3-4.4":{"q":"소모품처럼 느껴지는 순간은?","o":["고생해도 인정을 안 해줘","사람이 나가도 회사는 그대로야","언제든 쉽게 대체한다고 해","연봉에서 그런 게 느껴져"],"n":["W3-4.4.1","W3-4.4.2","W3-4.4.3","W3-4.4.4"]},"W3-1.1.1":{"q":"위축되면 일할 때 어떻게 돼요?","o":["그러다 보니 실수가 늘어","점점 말을 아끼게 돼","눈치만 보게 되는 것 같아","자신감이 계속 떨어져"],"n":null},"W3-1.1.2":{"q":"참은 화는 어디로 가요?","o":["집에 와서 결국 터져","혼자서 그냥 삭여","친구한테 털어놓게 돼","몸이 아파오는 것 같아"],"n":null},"W3-1.1.3":{"q":"그 말이 맴돌면 어떻게 버텨요?","o":["잠을 제대로 못 자","다른 걸로 잊으려고 해","그냥 계속 떠올라","누구한테든 얘기하게 돼"],"n":null},"W3-1.1.4":{"q":"무뎌진 지금은 괜찮은 거예요?","o":["괜찮은 척하는 중이야","정말 무덤덤해진 것 같아","가끔 확 올라오긴 해","나도 잘 모르겠어"],"n":null},"W3-1.2.1":{"q":"일이 넘칠 때 주로 어떻게 해요?","o":["야근으로 겨우 버텨","그냥 대충 끝내버려","혼자서 끙끙대고 있어","동료한테 부탁하게 돼"],"n":null},"W3-1.2.2":{"q":"마감 직전에 받으면 어떤 생각이 들어요?","o":["일부러 그러나 싶어","계획이 다 무너져버려","화나지만 그냥 해","이젠 당연하게 느껴져"],"n":null},"W3-1.2.3":{"q":"공을 뺏기면 어떤 마음이에요?","o":["내 공을 뺏기니 너무 억울해","의욕이 완전히 사라져 버렸어","나도 내 공을 티 내고 싶어","그냥 포기하고 놓아버렸어"],"n":null},"W3-1.2.4":{"q":"거절을 못 하는 이유는?","o":["평가가 걱정돼서 못 해","분위기가 무서워서 못 해","원래 거절을 잘 못 해","해봤는데 안 통했어"],"n":null},"W3-1.3.1":{"q":"지적받을 때 맞는 말도 있어요?","o":["가끔은 맞는 말일 때도 있어","대부분은 그냥 트집 같아","맞는 말도 방식이 너무 싫어","맞는 건지 잘 모르겠어"],"n":null},"W3-1.3.2":{"q":"다른 사람을 챙기는 걸 보면 어때요?","o":["그냥 좀 서운해","비교돼서 비참해","나도 잘하고 싶어져","신경 끄려고 해봐"],"n":null},"W3-1.3.3":{"q":"무시당할 때 어떻게 해요?","o":["그냥 입 다물게 돼","다시 한번 말해봐","다른 사람을 통해 말해","속으로만 화를 내"],"n":null},"W3-1.3.4":{"q":"왜 그러는 것 같아요?","o":["나랑 안 맞아서 그런가 봐","내가 실수한 게 있나 봐","원래 그런 사람인 것 같아","이유를 모르겠어"],"n":null},"W3-1.4.1":{"q":"잘해줄 땐 어떤 마음이에요?","o":["그래도 고마운 마음이 들어","오히려 더 헷갈려","언제 바뀔까 불안해","별 감흥이 없어"],"n":null},"W3-1.4.2":{"q":"화풀이를 당하면 어떻게 버텨요?","o":["그 자리에서 그냥 참아","화장실로 피하게 돼","동료랑 같이 풀어","그냥 견디는 거지"],"n":null},"W3-1.4.3":{"q":"예측이 안 되면 뭐가 제일 힘들어요?","o":["늘 긴장해 있는 게 힘들어","보고 타이밍 잡기가 어려워","일에 집중이 안 돼","출근하는 게 무서워"],"n":null},"W3-1.4.4":{"q":"말 걸기 무서우면 일은 어떻게 해요?","o":["꼭 필요한 말만 하게 돼","메신저로만 이야기해","다른 사람이 대신해줘","최대한 미루게 돼"],"n":null},"W3-2.1.1":{"q":"억울한 마음, 누가 알아줬으면 해요?","o":["상사가 알아줬으면 좋겠어","그 동료가 직접 알았으면 해","다른 동료들이 알아줬으면 해","아무도 몰라도 괜찮아"],"n":null},"W3-2.1.2":{"q":"지쳐도 계속하는 이유는?","o":["일이 안 되면 내가 혼나","책임감 때문에 못 놓겠어","싫은 소리 하기가 싫어","어쩔 수 없어서 하는 거야"],"n":null},"W3-2.1.3":{"q":"말을 못 하는 이유는?","o":["사이가 나빠질까 봐 걱정돼","내가 예민해 보일까 봐 겁나","말해도 안 바뀔 것 같아","말솜씨가 없어서 어려워"],"n":null},"W3-2.1.4":{"q":"내가 하는 게 편한 이유는?","o":["내가 하면 결과가 더 좋아","부탁하는 게 싫어서 그래","내가 하는 게 더 빨라","이미 습관이 돼버렸어"],"n":null},"W3-2.2.1":{"q":"사람이 무서워지면 어떻게 돼요?","o":["점점 말을 아끼게 돼","혼자 다니게 되는 것 같아","다 의심하게 돼버려","회사 가기가 싫어져"],"n":null},"W3-2.2.2":{"q":"내 얘기도 나올까 봐 어떻게 해요?","o":["더 조심하게 돼","잘 보이려고 애쓰게 돼","그냥 신경 끄려고 해","계속 신경이 쓰여"],"n":null},"W3-2.2.3":{"q":"듣기 싫은데 피하기 어려운 이유는?","o":["매일 같이 밥을 먹어야 해","자리가 가까워서 들려","빠지면 내가 대상이 될 것 같아","피할 곳이 마땅히 없어"],"n":null},"W3-2.2.4":{"q":"같이 끼고 나면 어떤 마음이에요?","o":["끝나고 나면 좀 찝찝해","그래도 소속감은 들어","나도 별로인 사람 같아","어쩔 수 없다 싶어"],"n":null},"W3-2.3.1":{"q":"성과를 뺏기면 어떻게 했어요?","o":["그냥 넘겨버렸어","상사한테 말했어","직접 가서 따졌어","다음부터는 조심하려고 해"],"n":null},"W3-2.3.2":{"q":"깎아내릴 때 나는 어떻게 반응해요?","o":["그냥 웃어넘기고 말아","겉으론 참고 속으로 화가 나","나도 맞받아치게 돼","점점 자신감이 떨어져"],"n":null},"W3-2.3.3":{"q":"그런 모습을 보면 어떤 생각이 들어요?","o":["저렇게까지 해야 하나 싶어","나도 저래야 하나 싶어","그냥 보기가 싫어","솔직히 좀 부럽기도 해"],"n":null},"W3-2.3.4":{"q":"정보를 안 나눠주면 일은 어떻게 해요?","o":["어떻게든 혼자 찾아서 해","다른 사람한테 물어보곤 해","정보가 없어서 실수가 생겨","굳이 그 사람한테 안 물어봐"],"n":null},"W3-2.4.1":{"q":"혼자 먹는 게 싫어요, 편해요?","o":["사실은 좀 서운해","편하긴 한데 눈치가 보여","완전 편하고 좋아","그때그때 상황에 따라 달라"],"n":null},"W3-2.4.2":{"q":"대화에 못 끼는 이유는 뭐 같아요?","o":["관심사가 달라서 그런 것 같아","나이 차이가 있어서 그래","이미 친한 무리가 있거든","내가 먼저 안 다가가서 그래"],"n":null},"W3-2.4.3":{"q":"정보가 늦으면 일에 어떤 문제가 생겨요?","o":["그러다 실수가 생겨","나만 혼자 뒤처져","일을 다시 해야 해","눈치로 알아내야 해"],"n":null},"W3-2.4.4":{"q":"회식이 불편한 이유는?","o":["할 말이 없어서 어색해","술자리 자체가 싫어","윗사람 비위 맞추기 힘들어","그냥 집에 가고 싶어"],"n":null},"W3-3.1.1":{"q":"일이 몰리면 팀에서 무슨 일이 생겨요?","o":["서로 일을 떠넘기게 돼","말투가 점점 거칠어져","실수가 계속 늘어나","다들 말이 없어져"],"n":null},"W3-3.1.2":{"q":"누가 바뀌고 나서 달라졌어요?","o":["팀장이 바뀌고 달라졌어","친하던 동료가 바뀌었어","새로 온 사람 때문인 것 같아","회사 윗선이 바뀌었어"],"n":null},"W3-3.1.3":{"q":"원래 그랬다면 왜 지금 더 힘들어요?","o":["내가 지쳐서 그런 것 같아","연차가 쌓여서 그런가 봐","다른 일들이 겹쳐서 그래","참을 만큼 참아서 그래"],"n":null},"W3-3.1.4":{"q":"그 분위기에서 나는 어떻게 지내요?","o":["최대한 조용히 지내려 해","나도 같이 날카로워져","그냥 혼자 버텨","분위기 풀려고 애써봐"],"n":null},"W3-3.2.1":{"q":"모르는 게 생기면 어떻게 해요?","o":["혼자 찾아보는 편이야","눈치 보다가 겨우 물어","그냥 대충 해버려","다른 팀에 물어봐"],"n":null},"W3-3.2.2":{"q":"외로울 때 기댈 곳이 있어요?","o":["회사 밖 친구한테 기대","가족한테 기대게 돼","다른 팀 사람한테 기대","딱히 기댈 곳이 없어"],"n":null},"W3-3.2.3":{"q":"일만 하는 느낌이 들면 어때요?","o":["일의 의미가 없어지는 것 같아","빨리 퇴근하고 싶어져","그래도 버틸 만해","차라리 그게 편해"],"n":null},"W3-3.2.4":{"q":"말없이 넘어가면 더 불안해요?","o":["뒤에서 평가할까 봐 불안해","차라리 혼나는 게 나을 것 같아","나도 별로 신경 안 써","알다가도 모르겠어"],"n":null},"W3-3.3.1":{"q":"바닥까지 지친 신호가 있어요?","o":["아침에 일어나기가 힘들어","주말에도 제대로 못 쉬어","작은 일에도 화가 나","아무 의욕이 없어"],"n":null},"W3-3.3.2":{"q":"남까지 챙기게 되는 이유는?","o":["보고 있기가 너무 안쓰러워","내가 해야 일이 돌아가","원래 그런 성격이긴 해","거절을 잘 못 해서 그래"],"n":null},"W3-3.3.3":{"q":"버틸 수 있는 힘은 어디서 와요?","o":["퇴근 후 내 시간 덕분이야","그래도 월급이 있잖아","그래도 좋은 동료가 있어","곧 끝날 거라고 생각해"],"n":null},"W3-3.3.4":{"q":"미안한 마음은 어떻게 하고 있어요?","o":["내가 일을 더 받아주고 있어","괜히 눈치를 보게 돼","그냥 신경 안 쓰려고 해","표현은 아직 못 했어"],"n":null},"W3-3.4.1":{"q":"무리에 끼지 못하면 어떤 일이 생겨요?","o":["정보가 나한테 안 와","일이 나한테 몰려","평가에 불리할 것 같아","그냥 많이 외로워"],"n":null},"W3-3.4.2":{"q":"라인이 있다는 건 어떻게 느껴요?","o":["승진이 이미 정해진 것 같아","일 배분이 다르게 느껴져","말할 때 조심해야 해","그냥 다 눈에 보여"],"n":null},"W3-3.4.3":{"q":"갈라진 분위기에서 나는 어디에 있어요?","o":["중간에 끼어 있는 것 같아","한쪽에 좀 가까운 편이야","아무 데도 속하지 않아","그냥 피해 다니고 있어"],"n":null},"W3-3.4.4":{"q":"어느 편이 된 게 마음 편해요?","o":["솔직히 편하긴 해","반대편 눈치가 보여","원해서 된 건 아니었어","언제 바뀔지 몰라 불안해"],"n":null},"W3-4.1.1":{"q":"말이 안 되는 지시를 받으면 어떻게 해요?","o":["그냥 시키는 대로 따라","돌려서 말해보기도 해","아래에서 알아서 처리해","대충 하는 척만 해"],"n":null},"W3-4.1.2":{"q":"목소리가 무시당할 때 어떤 마음이에요?","o":["말해봐야 소용없는 것 같아","솔직히 화가 나","그래도 더 말하고 싶어","이제는 그냥 체념했어"],"n":null},"W3-4.1.3":{"q":"숫자로만 평가받으면 어때요?","o":["내 노력이 안 보이는 것 같아","숫자 맞추느라 너무 지쳐","그래도 공정하긴 한 것 같아","의미가 없어지는 것 같아"],"n":null},"W3-4.1.4":{"q":"그래도 회사에 바라는 게 있다면?","o":["한 번이라도 들어줬으면 해","현실적인 목표를 줬으면 해","제대로 된 보상을 받고 싶어","솔직히 기대 안 해"],"n":null},"W3-4.2.1":{"q":"하던 일이 날아가면 어떤 기분이에요?","o":["공들인 게 날아가서 허무해","너무 화가 나서 참기 힘들어","이젠 이런 일도 익숙해졌어","하려던 의욕이 꺾여 버려"],"n":null},"W3-4.2.2":{"q":"다시 시작할 때 제일 힘든 건?","o":["몸이 너무 지쳐 있어","마음이 안 따라와","또 바뀔까 봐 불안해","팀 분위기가 힘들어"],"n":null},"W3-4.2.3":{"q":"늘어난 일은 어떻게 감당해요?","o":["야근으로 어떻게든 해","우선순위를 정해서 해","일부는 포기하게 돼","도저히 감당이 안 돼"],"n":null},"W3-4.2.4":{"q":"길을 잃은 느낌일 때 어떻게 해요?","o":["상사한테 물어보는 편이야","그냥 기다려보기도 해","내 판단대로 해버려","아무것도 못 하겠어"],"n":null},"W3-4.3.1":{"q":"못 맞추면 어떻게 돼요?","o":["그러면 혼나게 돼","평가가 깎이는 것 같아","그냥 넘어가기도 해","다음 목표가 더 커져"],"n":null},"W3-4.3.2":{"q":"몸이 상해도 맞추려는 이유는?","o":["평가 때문에 어쩔 수 없어","팀에 피해 줄까 봐 그래","자존심 때문이기도 해","다른 방법이 없어서 그래"],"n":null},"W3-4.3.3":{"q":"목표가 계속 오르면 어떤 생각이 들어요?","o":["끝이 없겠구나 싶어","언젠가 무너질 것 같아","나도 성장하겠지 싶어","이제 떠나야겠다 싶어"],"n":null},"W3-4.3.4":{"q":"이유를 알면 좀 나을까요?","o":["이유를 알면 훨씬 나을 것 같아","알아도 여전히 힘들 것 같아","이유 따윈 알고 싶지도 않아","나도 잘 모르겠어"],"n":null},"W3-4.4.1":{"q":"어떤 인정을 받고 싶어요?","o":["수고했다는 한마디면 돼","정당한 평가를 받고 싶어","보상을 받고 싶어","내 이름이 기억됐으면 해"],"n":null},"W3-4.4.2":{"q":"사람들이 나가는 걸 보면 어때요?","o":["나도 나가야 하나 싶어","남은 일이 너무 무서워","솔직히 좀 부러워","이젠 그냥 익숙해"],"n":null},"W3-4.4.3":{"q":"대체될 수 있다는 말이 어떻게 들려요?","o":["듣고 상처받았어","사실이라 더 아파","나도 떠날 수 있겠다 싶어","그냥 흘려듣고 있어"],"n":null},"W3-4.4.4":{"q":"연봉에서 그렇게 느낀 이유는?","o":["연봉이 오래 안 올랐어","남보다 적은 것 같아","일에 비해 너무 적어","협상이 아예 안 돼"],"n":null}}}