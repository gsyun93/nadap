{"start":"R3-0","nodes":{"R3-0":{"q":"주로 어떤 일로 부딪혀요?","o":["연락이나 표현 문제","말투나 태도","돈이나 생활 습관","나를 존중 안 하는 느낌"],"n":["R3-1","R3-2","R3-3","R3-4"]},"R3-1":{"q":"연락이나 표현에서 뭐가 제일 서운해요?","o":["왜 먼저 연락을 안 하는 거야","고맙다는 말 한마디가 없어","내 마음을 몰라주는 것 같아","표현이 너무 차갑게 느껴져"],"n":["R3-1.1","R3-1.2","R3-1.3","R3-1.4"]},"R3-2":{"q":"어떤 말투나 태도가 제일 힘들어요?","o":["걸핏하면 화부터 내서 힘들어","날 무시하듯 말하는 게 싫어","말도 없이 피해서 답답해","비꼬듯 말하는 게 힘들어"],"n":["R3-2.1","R3-2.2","R3-2.3","R3-2.4"]},"R3-3":{"q":"돈이나 생활 습관에서 뭐가 제일 부딪혀요?","o":["돈 쓰는 방식이 서로 달라","돈을 누가 내는지 늘 걸려","정리나 청소 때문에 부딪혀","시간 약속 문제로 자꾸 걸려"],"n":["R3-3.1","R3-3.2","R3-3.3","R3-3.4"]},"R3-4":{"q":"존중받지 못한다고 느끼는 순간은?","o":["내 의견을 안 들어주는 것 같아","내 결정에 자꾸 간섭을 해","남들 앞에서 날 깎아내려","내 선을 자꾸 넘어오는 것 같아"],"n":["R3-4.1","R3-4.2","R3-4.3","R3-4.4"]},"R3-1.1":{"q":"연락이 없을 때 어떤 생각이 들어요?","o":["내가 중요하지 않나 싶어","바쁘겠지 하고 그냥 참아","나도 연락하기 싫어져","계속 기다리게 되더라"],"n":["R3-1.1.1","R3-1.1.2","R3-1.1.3","R3-1.1.4"]},"R3-1.2":{"q":"고마움을 표현 안 하면 어떤 마음이에요?","o":["당연하게 여기는 것 같아","내가 왜 해주나 싶어","그냥 마음이 서운해","나도 그만하고 싶어져"],"n":["R3-1.2.1","R3-1.2.2","R3-1.2.3","R3-1.2.4"]},"R3-1.3":{"q":"내 마음을 몰라준다고 느끼는 때는?","o":["힘들다고 해도 너무 무심해","기념일이나 약속을 자꾸 잊어","내 얘기에 관심이 없어 보여","내가 말해야만 알더라"],"n":["R3-1.3.1","R3-1.3.2","R3-1.3.3","R3-1.3.4"]},"R3-1.4":{"q":"차가운 표현이 어떻게 느껴져요?","o":["정이 없는 사람 같아 보여","날 싫어하나 싶기도 해","원래 그런 사람이라 이해는 해","나도 덩달아 차가워져"],"n":["R3-1.4.1","R3-1.4.2","R3-1.4.3","R3-1.4.4"]},"R3-2.1":{"q":"화부터 낼 때 나는 어떻게 반응해요?","o":["겁이 나서 움츠러들어","나도 같이 화를 내게 돼","일단 참고 넘기는 편이야","나중에 따로 얘기하려고 해"],"n":["R3-2.1.1","R3-2.1.2","R3-2.1.3","R3-2.1.4"]},"R3-2.2":{"q":"무시당한다고 느끼는 말은?","o":["넌 몰라도 된다는 말이 아파","내 의견을 비웃을 때 속상해","남들 앞에서 깎아내릴 때 힘들어","대답을 안 할 때 무시당해"],"n":["R3-2.2.1","R3-2.2.2","R3-2.2.3","R3-2.2.4"]},"R3-2.3":{"q":"말없이 피할 때 어떤 마음이에요?","o":["말 없이 피하면 너무 답답해","이러다 멀어질까 불안해","나도 슬슬 지치는 것 같아","그냥 기다리는 수밖에 없어"],"n":["R3-2.3.1","R3-2.3.2","R3-2.3.3","R3-2.3.4"]},"R3-2.4":{"q":"비꼬는 말은 주로 언제 나와요?","o":["서운하다고 할 때 꼭 나와","사소한 실수만 해도 나오더라","다른 사람이랑 비교할 때 그래","장난처럼 아무 때나 해"],"n":["R3-2.4.1","R3-2.4.2","R3-2.4.3","R3-2.4.4"]},"R3-3.1":{"q":"돈 쓰는 방식이 어떻게 달라요?","o":["그 사람은 너무 아끼는 편이야","그 사람은 너무 많이 써","나한테 상의 없이 돈을 써","돈 얘기는 자꾸 피하려고 해"],"n":["R3-3.1.1","R3-3.1.2","R3-3.1.3","R3-3.1.4"]},"R3-3.2":{"q":"비용 부담이 어떻게 기울어 있어요?","o":["내가 거의 다 내는 편이야","그 사람이 거의 다 내줘","반반인데 기준이 서로 달라","서로 눈치만 보게 돼"],"n":["R3-3.2.1","R3-3.2.2","R3-3.2.3","R3-3.2.4"]},"R3-3.3":{"q":"정리나 청소 문제, 어떤 상황이에요?","o":["나만 치우는 것 같아","정리 기준이 너무 달라","말해도 하나도 안 바뀌어","말하면 잔소리가 돼버려"],"n":["R3-3.3.1","R3-3.3.2","R3-3.3.3","R3-3.3.4"]},"R3-3.4":{"q":"시간 약속에서 뭐가 문제예요?","o":["약속에 자주 늦어서 힘들어","갑자기 약속을 취소해버려","내 시간을 존중 안 하는 것 같아","계획을 아예 안 세워서 답답해"],"n":["R3-3.4.1","R3-3.4.2","R3-3.4.3","R3-3.4.4"]},"R3-4.1":{"q":"의견을 안 들을 때 어떤 마음이에요?","o":["내가 없는 사람 같아","솔직히 화가 나","말해봐야 소용없다 싶어","그냥 따라가게 돼"],"n":["R3-4.1.1","R3-4.1.2","R3-4.1.3","R3-4.1.4"]},"R3-4.2":{"q":"어떤 결정에 간섭해요?","o":["옷이나 외모에 간섭을 해","내가 만나는 사람에 간섭해","내 일이나 진로에 간섭해","내가 돈 쓰는 데도 간섭해"],"n":["R3-4.2.1","R3-4.2.2","R3-4.2.3","R3-4.2.4"]},"R3-4.3":{"q":"남들 앞에서 깎아내릴 때 어떻게 해요?","o":["그냥 웃어넘기고 말아","그 자리에서 바로 정색해","나중에 따로 따져 묻는 편이야","아무 말도 못 하고 있어"],"n":["R3-4.3.1","R3-4.3.2","R3-4.3.3","R3-4.3.4"]},"R3-4.4":{"q":"어떤 경계를 넘는 것 같아요?","o":["내 폰이나 사생활을 넘봐","내 시간을 마음대로 써","내 몸이나 공간을 침범해","내 감정을 함부로 대해"],"n":["R3-4.4.1","R3-4.4.2","R3-4.4.3","R3-4.4.4"]},"R3-1.1.1":{"q":"중요하지 않다고 느끼면 어떻게 돼요?","o":["서운함이 자꾸 쌓여가","나도 슬슬 거리를 두게 돼","오히려 내가 더 매달려","혼자 상처받고 말아"],"n":null},"R3-1.1.2":{"q":"참는 게 계속되면 어떻게 될 것 같아요?","o":["언젠가 터질 것 같아","지쳐서 포기할 것 같아","그냥 익숙해질 것 같아","어떻게 될지 모르겠어"],"n":null},"R3-1.1.3":{"q":"나도 연락을 끊어본 적 있어요?","o":["끊어봤는데 아무 반응 없었어","끊어봤는데 결국 내가 먼저 했어","그러고 싶은데 잘 못 하겠어","그런 적은 한 번도 없어"],"n":null},"R3-1.1.4":{"q":"기다리는 동안 마음은 어때요?","o":["기다리는 내내 불안해","기다리다 보면 화가 나","이제 거의 체념하게 돼","그래도 은근히 기대하게 돼"],"n":null},"R3-1.2.1":{"q":"당연하게 여긴다고 느끼는 순간은?","o":["부탁할 때만 나를 찾는 것 같아","내가 해준 걸 몰라줘서 속상해","오히려 불평할 때 더 서운해","내가 안 하면 서운해해서 억울해"],"n":null},"R3-1.2.2":{"q":"그래도 계속 해주는 이유는?","o":["그 사람을 좋아하니까 하는 거야","책임감 때문에 하게 되는 것 같아","안 하면 싸울까 봐 계속 해","어느새 습관이 돼버렸어"],"n":null},"R3-1.2.3":{"q":"그 서운함을 말해본 적 있어요?","o":["말했는데도 안 바뀌더라","말하기 치사한 것 같아 못 해","돌려서 말해본 적은 있어","아직 말해본 적은 없어"],"n":null},"R3-1.2.4":{"q":"그만두면 어떻게 될 것 같아요?","o":["관계가 멀어질 것 같아","오히려 알아줄지도 몰라","싸움이 날 것 같아","어떻게 될지 잘 모르겠어"],"n":null},"R3-1.3.1":{"q":"힘들 때 그 사람에게 바라는 건?","o":["그냥 내 얘기를 들어줬으면 해","위로 한마디면 충분할 것 같아","말없이 옆에 있어줬으면 해","해결하는 걸 도와줬으면 해"],"n":null},"R3-1.3.2":{"q":"잊어버릴 때 어떤 마음이에요?","o":["내가 별거 아닌가 싶어","솔직히 화가 나","그러려니 하고 넘겨","다음엔 기대도 안 해"],"n":null},"R3-1.3.3":{"q":"내 얘기에 관심 없다고 느끼는 순간은?","o":["내가 말하는데 폰만 봐","대충 대답하는 게 느껴져","자기 얘기로 돌려버려","내가 한 말을 기억 못 해"],"n":null},"R3-1.3.4":{"q":"말로 해야만 아는 게 왜 서운해요?","o":["알아서 알아줬으면 좋겠거든","말하면 구걸하는 것 같아서 싫어","말해도 금방 잊어버리는 것 같아","나만 노력하는 것 같아서 지쳐"],"n":null},"R3-1.4.1":{"q":"따뜻한 표현을 바라는 건 어떤 거예요?","o":["다정한 말을 해줬으면 좋겠어","칭찬 한마디가 듣고 싶어","따뜻한 몸짓이라도 보여줬으면 해","작은 관심이라도 보여줬으면 해"],"n":null},"R3-1.4.2":{"q":"싫어하나 싶은 생각이 들 때 어떻게 해요?","o":["나도 모르게 눈치를 보게 돼","더 잘하려고 애쓰게 돼","직접 물어보는 편이야","그냥 거리를 두게 돼"],"n":null},"R3-1.4.3":{"q":"원래 그런 사람이라도 바라는 게 있어요?","o":["가끔은 표현해줬으면 좋겠어","나한테만은 달랐으면 좋겠어","내 방식도 이해해줬으면 해","딱히 바라는 건 없어"],"n":null},"R3-1.4.4":{"q":"나도 차가워지면 관계는 어때져요?","o":["관계가 더 멀어질 것 같아","오히려 마음이 편해지기도 해","싸움은 확실히 줄어들어","결국 서로 지치게 되는 것 같아"],"n":null},"R3-2.1.1":{"q":"움츠러들면 어떤 생각이 들어요?","o":["내가 잘못했나 싶어","이 관계가 무섭게 느껴져","빨리 끝났으면 좋겠어","왜 이러나 싶어"],"n":null},"R3-2.1.2":{"q":"같이 화내고 나면 어떤 마음이에요?","o":["같이 화내고 나면 후회돼","속은 좀 시원해지기도 해","오히려 더 꼬이는 것 같아","끝나고 나면 많이 지쳐"],"n":null},"R3-2.1.3":{"q":"참고 넘긴 화는 어떻게 돼요?","o":["참은 화가 계속 쌓여 있어","엉뚱한 데서 터지기도 해","시간 지나면 금방 잊어","몸이 먼저 아픈 것 같아"],"n":null},"R3-2.1.4":{"q":"따로 얘기하면 대화가 돼요?","o":["따로 얘기하면 잘 풀리는 편이야","얘기하다 다시 싸움이 돼","그냥 대충 넘어가게 돼","결국 그 얘기를 피하게 돼"],"n":null},"R3-2.2.1":{"q":"그 말을 들으면 어떤 마음이에요?","o":["내가 작아지는 기분이야","너무 억울한 마음이 들어","솔직히 화가 나","그냥 포기하게 돼"],"n":null},"R3-2.2.2":{"q":"의견을 비웃으면 나는 어떻게 해요?","o":["그 뒤론 다시 말 안 해","끝까지 설명하려고 해","나도 똑같이 해주고 싶어","그냥 속으로 삭이고 말아"],"n":null},"R3-2.2.3":{"q":"남들 앞에서 그러면 어때요?","o":["너무 창피해서 얼굴이 화끈거려","그 자리를 당장 떠나고 싶어","나중에 따로 따져야겠어","이제는 이것도 익숙해진 것 같아"],"n":null},"R3-2.2.4":{"q":"대답 없는 침묵이 어떻게 느껴져요?","o":["무시당하는 것 같아","침묵이 길어져서 더 불안해","나도 같이 말을 안 해","그냥 가만히 기다려"],"n":null},"R3-2.3.1":{"q":"답답할 때 나는 어떻게 해요?","o":["계속 말을 걸게 돼","메시지를 길게 보내게 돼","혼자 속으로 삭이게 돼","다른 사람한테 털어놓게 돼"],"n":null},"R3-2.3.2":{"q":"피하는 동안 가장 불안한 건?","o":["이러다 관계가 끝날까 봐 겁나","나를 미워할까 봐 불안해","문제가 그대로일까 봐 걱정돼","같은 일이 반복될까 봐 무서워"],"n":null},"R3-2.3.3":{"q":"지쳐서 나도 피하고 싶을 때가 있어요?","o":["나도 자주 그러고 싶어져","가끔은 그러고 싶을 때가 있어","그러면 안 될 것 같아","이미 나도 피하고 있어"],"n":null},"R3-2.3.4":{"q":"결국 어떻게 풀려요?","o":["시간 지나면 흐지부지 넘어가","결국 내가 먼저 사과하게 돼","그 사람이 먼저 다가오기도 해","잘 안 풀리는 것 같아"],"n":null},"R3-2.4.1":{"q":"서운하다고 했는데 비꼬면 어때요?","o":["말한 걸 후회하게 돼","오히려 더 서운해져","다시는 말하고 싶지 않아","솔직히 화가 나"],"n":null},"R3-2.4.2":{"q":"작은 실수에도 그러면 어떤 기분이에요?","o":["숨이 턱 막히는 기분이야","내가 부족한 것 같아","너무 억울한 마음이 들어","자꾸 조심하게 돼"],"n":null},"R3-2.4.3":{"q":"누구와 비교당해요?","o":["형제나 친척이랑 비교해","그 사람 친구랑 비교해","예전 사람이랑 비교하기도 해","남들 전부랑 비교하는 것 같아"],"n":null},"R3-2.4.4":{"q":"장난이라고 하면 어떻게 해요?","o":["그냥 웃어넘기려고 해","기분 나쁘다고 말하는 편이야","속으로만 쌓아두게 돼","나도 장난으로 받아쳐"],"n":null},"R3-3.1.1":{"q":"너무 아끼는 게 왜 불편해요?","o":["같이 하는 게 줄어들어","나까지 눈치를 보게 돼","좀 쩨쩨해 보이기도 해","그래도 이해는 해"],"n":null},"R3-3.1.2":{"q":"너무 쓰는 걸 보면 어떤 걱정이 들어요?","o":["앞으로가 걱정돼","나한테 기댈까 봐 걱정돼","빚이 생길까 봐 불안해","말려도 안 들어서 답답해"],"n":null},"R3-3.1.3":{"q":"상의 없이 쓰면 어떤 마음이에요?","o":["무시당한 느낌이 들어","솔직히 화가 나","다음엔 나도 그러고 싶어","딱히 할 말이 없어"],"n":null},"R3-3.1.4":{"q":"돈 얘기를 피하는 이유는 뭐 같아요?","o":["부끄러워서 피하는 것 같아","싸울까 봐 피하는 것 같아","그냥 관심이 없는 것 같아","숨기는 게 있는 것 같아"],"n":null},"R3-3.2.1":{"q":"내가 다 낼 때 어떤 마음이에요?","o":["내가 많이 내서 지쳐","이용당하는 느낌이 들어","괜찮은데 고마워했으면 해","형편이 걱정이 돼"],"n":null},"R3-3.2.2":{"q":"그 사람이 다 내면 어때요?","o":["내가 너무 미안해져","괜히 눈치가 보여","한편으론 고마워","내가 자꾸 작아지는 것 같아"],"n":null},"R3-3.2.3":{"q":"기준이 달라 부딪히는 건?","o":["큰돈이랑 작은 돈 기준이 달라","누가 더 버는지가 걸려","누가 원해서 쓴 건지가 걸려","기념일 비용이 늘 문제야"],"n":null},"R3-3.2.4":{"q":"서로 눈치 보는 게 어떻게 바뀌었으면 해요?","o":["솔직하게 기준을 정했으면 해","같이 모으는 방법이 좋겠어","각자 내는 게 편할 것 같아","어떻게 되면 좋을지 모르겠어"],"n":null},"R3-3.3.1":{"q":"나만 치울 때 어떤 생각이 들어요?","o":["내가 왜 해야 하나 싶어","그냥 내가 하는 게 편해","너무 지치는 것 같아","해도 알아주지도 않아"],"n":null},"R3-3.3.2":{"q":"기준 차이는 어느 정도예요?","o":["나는 깔끔한데 그 사람은 대충이야","나는 대충인데 그 사람이 깔끔해","정리하는 방식이 서로 달라","공간 쓰는 방식이 서로 달라"],"n":null},"R3-3.3.3":{"q":"안 바뀌면 어떻게 하고 있어요?","o":["이젠 말하는 걸 포기했어","그래도 계속 말하고 있어","결국 내가 다 하게 돼","나도 모르게 화를 내게 돼"],"n":null},"R3-3.3.4":{"q":"잔소리가 되는 게 싫은 이유는?","o":["내가 나쁜 사람 같아서 싫어","관계가 피곤해지는 게 싫어","말해봐야 효과도 없는 것 같아","꼭 엄마처럼 느껴져서 싫어"],"n":null},"R3-3.4.1":{"q":"늦을 때 나는 어떻게 해요?","o":["그냥 참고 기다리는 편이야","결국 화를 내게 돼","나도 일부러 늦게 가","다음 약속을 안 잡게 돼"],"n":null},"R3-3.4.2":{"q":"갑자기 취소하면 어떤 기분이에요?","o":["내가 뒷순위 같아서 속상해","솔직히 화가 나","이젠 기대도 안 해","그래도 이해는 하려고 해"],"n":null},"R3-3.4.3":{"q":"존중받지 못한다고 느끼는 부분은?","o":["내 일정은 생각도 안 해줘","사과를 안 하는 게 서운해","당연하게 여기는 것 같아","나만 계속 맞추고 있어"],"n":null},"R3-3.4.4":{"q":"계획 없는 게 왜 힘들어요?","o":["내가 다 정해야 해서 힘들어","계획이 없으면 불안해","시간이 낭비되는 것 같아","성의가 없어 보여서 서운해"],"n":null},"R3-4.1.1":{"q":"없는 사람 같을 때 어떻게 버텨요?","o":["그냥 혼자 삭이면서 버텨","다른 데서 인정받으려 하게 돼","점점 말수가 줄어들어","슬슬 거리를 두게 돼"],"n":null},"R3-4.1.2":{"q":"화가 나면 표현하는 편이에요?","o":["화나면 바로 표현하는 편이야","참다가 한꺼번에 터져","돌려서 말하는 편이야","거의 표현을 안 해"],"n":null},"R3-4.1.3":{"q":"소용없다는 생각은 언제부터였어요?","o":["최근에 그런 생각이 들었어","꽤 오래된 생각인 것 같아","처음부터 그랬던 것 같아","언제부터인지 잘 모르겠어"],"n":null},"R3-4.1.4":{"q":"따라가는 게 편한 이유는?","o":["싸우기 싫어서 따라가는 거야","그 사람이 더 잘 알아서 그래","결정하는 게 어려워서 그래","이젠 포기해서 그런 것 같아"],"n":null},"R3-4.2.1":{"q":"외모 간섭을 받으면 어떤 기분이에요?","o":["내가 부족한 것 같아","숨이 막히는 기분이야","솔직히 화가 나","결국 맞춰주게 돼"],"n":null},"R3-4.2.2":{"q":"만나는 사람까지 간섭하면 어때요?","o":["나 혼자 고립되는 느낌이야","나를 못 믿는 것 같아","눈치 보면서 만나게 돼","결국 안 만나게 되더라"],"n":null},"R3-4.2.3":{"q":"진로 간섭은 어떤 식이에요?","o":["무조건 반대부터 해","자기 뜻대로 하라고 해","내 일을 무시하는 것 같아","걱정한다면서 막아서"],"n":null},"R3-4.2.4":{"q":"돈 간섭은 어떤 부분이에요?","o":["쓴 걸 다 확인하려 해","내 돈인데 허락받아야 해","맨날 아끼라는 말만 해","자기 돈은 자유롭게 써"],"n":null},"R3-4.3.1":{"q":"웃어넘기고 나서 혼자 있을 땐 어때요?","o":["혼자 있으면 너무 비참해","시간이 지나면 화가 나","계속 그 일이 생각나","괜찮은 척하게 돼"],"n":null},"R3-4.3.2":{"q":"정색하면 그 사람 반응은?","o":["장난이었다고 말해","오히려 더 화를 내","미안하다고 사과해","분위기가 얼어붙어"],"n":null},"R3-4.3.3":{"q":"나중에 따지면 달라져요?","o":["그때뿐이고 또 반복돼","조금은 나아졌던 것 같아","오히려 싸움이 더 커져","따져본 적은 없어"],"n":null},"R3-4.3.4":{"q":"아무 말 못 하는 이유는?","o":["분위기 깰까 봐 말을 못 해","무서워서 아무 말도 못 해","말이 아예 안 나와","이제는 익숙해져버렸어"],"n":null},"R3-4.4.1":{"q":"사생활을 들여다볼 때 어떤 마음이에요?","o":["감시받는 것 같아","숨길 건 없는데 불쾌해","싸우기 싫어서 그냥 둬","나도 똑같이 해주고 싶어"],"n":null},"R3-4.4.2":{"q":"내 시간을 존중 안 하면 어떻게 돼요?","o":["혼자 있을 틈이 하나도 없어","약속을 다 맞춰야 해서 힘들어","너무 지치는 것 같아","다른 관계가 점점 줄어들어"],"n":null},"R3-4.4.3":{"q":"공간을 침범하면 어떤 기분이에요?","o":["그냥 많이 불편해","숨이 막히는 것 같아","말하기가 어려워","솔직히 화가 나"],"n":null},"R3-4.4.4":{"q":"내 감정을 무시당할 때 어떻게 해요?","o":["내 감정을 숨기게 돼","더 크게 표현하게 돼","혼자 울면서 삭이게 돼","그 사람을 피하게 돼"],"n":null}}}