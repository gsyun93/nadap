{"start":"M4-0","nodes":{"M4-0":{"q":"이런 상태, 얼마나 됐어요?","o":["요 며칠 사이","몇 주째","몇 달째","1년 넘게 이래"],"n":["M4-1","M4-2","M4-3","M4-4"]},"M4-1":{"q":"요 며칠 사이에 무슨 일이 있었어요?","o":["일이 한꺼번에 몰아쳤어","누구랑 크게 부딪혔어","몸이 좀 안 좋았어","딱히 특별한 일은 없어"],"n":["M4-1.1","M4-1.2","M4-1.3","M4-1.4"]},"M4-2":{"q":"몇 주째 지친 이유는 뭐 같아요?","o":["쉬지도 못하고 계속 달려왔어","계속 신경 쓰이는 일이 있어","요즘 즐거운 일이 하나도 없어","이유를 도무지 모르겠어"],"n":["M4-2.1","M4-2.2","M4-2.3","M4-2.4"]},"M4-3":{"q":"몇 달째 이어지는 동안 무엇이 달라졌어요?","o":["잠이 예전이랑 달라졌어","사람을 점점 덜 만나게 돼","일이나 공부가 손에 안 잡혀","웃는 일이 확 줄었어"],"n":["M4-3.1","M4-3.2","M4-3.3","M4-3.4"]},"M4-4":{"q":"1년 넘게 이어지면서 나를 어떻게 보게 됐어요?","o":["원래 이런 사람인 것 같아","내가 그냥 게으른 것 같아","지쳐서 그런 거야","나도 잘 모르겠어"],"n":["M4-4.1","M4-4.2","M4-4.3","M4-4.4"]},"M4-1.1":{"q":"몰아친 일은 지금 어떻게 됐어요?","o":["그 일이 아직 진행 중이야","그 일이 막 끝났어","끝이 도무지 안 보여","내가 망친 것 같아"],"n":["M4-1.1.1","M4-1.1.2","M4-1.1.3","M4-1.1.4"]},"M4-1.2":{"q":"누구랑 부딪혔어요?","o":["가족이랑 부딪혔어","연인이랑 부딪혔어","친구랑 부딪혔어","직장 사람이랑 부딪혔어"],"n":["M4-1.2.1","M4-1.2.2","M4-1.2.3","M4-1.2.4"]},"M4-1.3":{"q":"몸은 지금 좀 괜찮아요?","o":["몸은 아직도 안 좋아","조금은 나아진 것 같아","몸은 괜찮은데 마음이 지쳐","자꾸 아픈 게 반복돼"],"n":["M4-1.3.1","M4-1.3.2","M4-1.3.3","M4-1.3.4"]},"M4-1.4":{"q":"특별한 일 없이 지칠 때 어떤 상태예요?","o":["아무것도 하기 싫어","그냥 잠만 자고 싶어","다 귀찮기만 해","그냥 멍한 상태야"],"n":["M4-1.4.1","M4-1.4.2","M4-1.4.3","M4-1.4.4"]},"M4-2.1":{"q":"마지막으로 제대로 쉰 게 언제예요?","o":["언제였는지 기억도 안 나","한 몇 달 전인 것 같아","쉬어도 쉰 것 같지가 않아","쉬는 게 오히려 불안해"],"n":["M4-2.1.1","M4-2.1.2","M4-2.1.3","M4-2.1.4"]},"M4-2.2":{"q":"계속 신경 쓰이는 일은 어떤 거예요?","o":["일이나 진로가 걸려","사람 관계가 신경 쓰여","돈 문제가 마음에 걸려","건강이 자꾸 걱정돼"],"n":["M4-2.2.1","M4-2.2.2","M4-2.2.3","M4-2.2.4"]},"M4-2.3":{"q":"예전엔 뭘 할 때 즐거웠어요?","o":["사람 만날 때 즐거웠어","취미 할 때 즐거웠어","맛있는 거 먹을 때 좋았어","잘 기억이 안 나"],"n":["M4-2.3.1","M4-2.3.2","M4-2.3.3","M4-2.3.4"]},"M4-2.4":{"q":"이유를 모르겠으면 몸과 마음 중 어디가 더 무거워요?","o":["몸이 더 무거운 것 같아","마음이 더 무거운 것 같아","몸도 마음도 둘 다 무거워","어디가 더 무거운지 모르겠어"],"n":["M4-2.4.1","M4-2.4.2","M4-2.4.3","M4-2.4.4"]},"M4-3.1":{"q":"잠이 어떻게 달라졌어요?","o":["잠들기가 너무 어려워","자다가 자주 깨","너무 많이 자게 돼","자도 계속 피곤해"],"n":["M4-3.1.1","M4-3.1.2","M4-3.1.3","M4-3.1.4"]},"M4-3.2":{"q":"사람을 덜 만나게 된 이유는?","o":["만날 기운이 없어","얘기할 거리가 없어","내 상태를 보이기 싫어","연락이 다 끊겨버렸어"],"n":["M4-3.2.1","M4-3.2.2","M4-3.2.3","M4-3.2.4"]},"M4-3.3":{"q":"일이나 공부가 안 될 때 어떤 상태예요?","o":["집중이 전혀 안 돼","시작 자체를 못 하겠어","해도 머리에 안 들어와","자꾸 실수가 늘어나"],"n":["M4-3.3.1","M4-3.3.2","M4-3.3.3","M4-3.3.4"]},"M4-3.4":{"q":"마지막으로 크게 웃은 게 언제예요?","o":["언제 웃었는지 기억이 안 나","최근에 조금 웃긴 했어","혼자 영상 보다가 웃었어","누구랑 있을 때 웃었어"],"n":["M4-3.4.1","M4-3.4.2","M4-3.4.3","M4-3.4.4"]},"M4-4.1":{"q":"원래 이런 사람이라고 느끼는 이유는?","o":["너무 오래된 일이라 그래","기운 있던 때가 기억 안 나","다들 나한테 그렇게 말해","나아진 적이 한 번도 없어"],"n":["M4-4.1.1","M4-4.1.2","M4-4.1.3","M4-4.1.4"]},"M4-4.2":{"q":"게으르다고 생각하는 이유는?","o":["할 일을 자꾸 미루거든","하루를 그냥 흘려보내","남들보다 덜 하는 것 같아","누가 나보고 그렇게 말해"],"n":["M4-4.2.1","M4-4.2.2","M4-4.2.3","M4-4.2.4"]},"M4-4.3":{"q":"지친 이유가 쌓인 게 뭐라고 생각해요?","o":["오래 버텨온 일이 쌓였어","반복된 관계 문제가 쌓였어","돈 걱정이 쌓인 것 같아","나를 너무 몰아붙였어"],"n":["M4-4.3.1","M4-4.3.2","M4-4.3.3","M4-4.3.4"]},"M4-4.4":{"q":"모르겠다면 지금 제일 필요한 건 뭐 같아요?","o":["푹 쉬는 게 필요해","누군가 들어줬으면 좋겠어","환경을 바꾸고 싶어","그것도 잘 모르겠어"],"n":["M4-4.4.1","M4-4.4.2","M4-4.4.3","M4-4.4.4"]},"M4-1.1.1":{"q":"진행 중인 일에서 제일 버거운 건?","o":["일의 양이 너무 많아","마감이 계속 날 조여와","혼자 다 해야 해서 버거워","결과에 대한 압박이 커"],"n":null},"M4-1.1.2":{"q":"끝났는데도 지친 이유는?","o":["긴장이 확 풀려서 그런가 봐","보상이 없어서 허탈해","또 올 것 같아서 불안해","몸이 아직 회복이 안 됐어"],"n":null},"M4-1.1.3":{"q":"끝이 안 보이면 어떤 생각이 들어요?","o":["이게 맞나 싶은 생각이 들어","그냥 버티자는 생각뿐이야","도망치고 싶은 마음이 커","아무 생각도 안 나"],"n":null},"M4-1.1.4":{"q":"망쳤다는 생각이 드는 이유는?","o":["내가 실수를 한 게 있어","기대만큼 못 해낸 것 같아","누가 지적을 하더라고","그냥 그런 느낌이 들어"],"n":null},"M4-1.2.1":{"q":"가족과 어떤 일로 부딪혔어요?","o":["내 결정을 반대해서 싸웠어","말투 때문에 부딪혔어","오래된 문제가 터져버렸어","사소한 일이 커져버렸어"],"n":null},"M4-1.2.2":{"q":"연인과의 다툼은 아직 이어지고 있어요?","o":["아직 냉전 중이야","화해했는데 찝찝해","헤어질까 고민이 돼","이제 다 정리됐어"],"n":null},"M4-1.2.3":{"q":"친구와 부딪힌 일이 왜 이렇게 지치게 해요?","o":["믿던 친구라서 더 힘들어","내가 잘못한 것 같아서 그래","관계가 끝날까 봐 겁나","다른 친구들도 얽혀 있어"],"n":null},"M4-1.2.4":{"q":"직장 사람과의 일이 계속 신경 쓰여요?","o":["매일 마주쳐야 해서 힘들어","평가에 영향 줄까 봐 걱정돼","생각할수록 억울해","또 부딪힐까 봐 불안해"],"n":null},"M4-1.3.1":{"q":"아픈데도 쉬지 못하는 이유는?","o":["일 때문에 쉴 수가 없어","혼자라서 쉬기가 어려워","쉬면 더 불안해져서 못 쉬어","별거 아닌 줄 알았어"],"n":null},"M4-1.3.2":{"q":"나아지는 동안 마음은 어때요?","o":["마음은 아직 무기력해","조금씩 기운이 나는 것 같아","밀린 일이 자꾸 걱정돼","그냥 멍한 느낌이야"],"n":null},"M4-1.3.3":{"q":"몸은 괜찮은데 마음이 지친 이유는?","o":["아프면서 혼자라 외로웠어","할 일이 밀려서 지친 것 같아","나를 못 돌본 것 같아서 그래","잘 모르겠어, 그냥 지쳐"],"n":null},"M4-1.3.4":{"q":"반복되는 이유가 짐작돼요?","o":["제대로 쉬지 않아서 그런 듯해","스트레스 때문인 것 같아","생활 습관 탓인 것 같아","이유를 잘 모르겠어"],"n":null},"M4-1.4.1":{"q":"하기 싫은 것 중 제일 힘든 건?","o":["출근이나 등교가 제일 힘들어","사람 만나는 게 제일 힘들어","집안일이 제일 하기 싫어","씻고 먹는 것도 힘들어"],"n":null},"M4-1.4.2":{"q":"자고 나면 좀 나아요?","o":["자고 나면 조금 나아져","자도 계속 피곤해","잠이 잘 안 오기도 해","자고 나면 더 처져"],"n":null},"M4-1.4.3":{"q":"귀찮음이 언제 제일 커요?","o":["아침에 제일 귀찮아","퇴근하고 나면 제일 귀찮아","주말에 특히 더 귀찮아","하루 종일 다 귀찮아"],"n":null},"M4-1.4.4":{"q":"멍할 때 주로 뭘 하고 있어요?","o":["멍할 땐 폰만 보고 있어","그냥 누워만 있어","천장만 멍하니 보게 돼","뭘 했는지 기억도 안 나"],"n":null},"M4-2.1.1":{"q":"쉴 틈이 안 나는 이유는?","o":["일이 끝이 없어서 못 쉬어","해야 할 일이 너무 많아","쉬면 뒤처질까 봐 불안해","누가 쉬지 못하게 해"],"n":null},"M4-2.1.2":{"q":"그때 쉬었을 때 뭐가 좋았어요?","o":["아무것도 안 해서 좋았어","멀리 떠나서 좋았어","좋아하는 사람과 있어서 좋았어","푹 자서 좋았던 것 같아"],"n":null},"M4-2.1.3":{"q":"쉬어도 개운하지 않은 이유는?","o":["머릿속이 계속 일하고 있어","폰을 계속 보게 돼","쉬는 법을 모르겠어","몸만 쉬고 마음은 못 쉬어"],"n":null},"M4-2.1.4":{"q":"쉬는 게 불안한 이유는?","o":["게을러 보일까 봐 불안해","할 일이 쌓일까 봐 걱정돼","쉬면 생각이 너무 많아져","원래 쉬면 불안한 편이야"],"n":null},"M4-2.2.1":{"q":"일이나 진로에서 뭐가 제일 걸려요?","o":["계속 다닐지 고민이 돼","미래가 전혀 안 보여","실적 압박이 너무 커","하고 싶은 게 없어"],"n":null},"M4-2.2.2":{"q":"신경 쓰이는 관계는 누구예요?","o":["가족 관계가 신경 쓰여","연인 관계가 신경 쓰여","친구 관계가 신경 쓰여","직장 사람이 신경 쓰여"],"n":null},"M4-2.2.3":{"q":"돈 걱정 중 제일 큰 건?","o":["생활비 걱정이 제일 커","빚이 제일 걱정돼","미래의 돈이 제일 걱정돼","갑자기 나갈 돈이 무서워"],"n":null},"M4-2.2.4":{"q":"건강에서 신경 쓰이는 건?","o":["잠 문제가 제일 신경 쓰여","소화나 몸 상태가 걸려","체력이 너무 떨어졌어","마음 상태가 제일 걱정돼"],"n":null},"M4-2.3.1":{"q":"요즘은 사람 만나는 게 어때요?","o":["사람 만나는 게 귀찮아","만나면 좋은데 나가기 힘들어","사람 만나면 너무 피곤해","만날 사람이 없어"],"n":null},"M4-2.3.2":{"q":"그 취미는 지금 왜 안 해요?","o":["취미 할 시간이 없어","의욕이 안 나서 못 해","돈이 들어서 부담돼","해도 이젠 재미없어"],"n":null},"M4-2.3.3":{"q":"요즘 입맛은 어때요?","o":["입맛이 없어서 잘 안 먹혀","오히려 너무 많이 먹어","대충 때우고 말아","입맛은 그대로야"],"n":null},"M4-2.3.4":{"q":"즐거움이 기억나지 않으면 어떤 마음이에요?","o":["생각하면 좀 무서워","생각하면 슬퍼져","그냥 그렇게 느껴져","다시 찾고 싶은 마음이야"],"n":null},"M4-2.4.1":{"q":"몸이 무거운 느낌은 어떤 거예요?","o":["아침에 도저히 못 일어나","계속 졸리기만 해","어깨나 머리가 무거워","움직이는 게 싫어"],"n":null},"M4-2.4.2":{"q":"마음이 무거운 느낌은 어떤 거예요?","o":["가슴이 너무 답답해","아무 의욕이 없어","눈물이 날 것 같아","속이 텅 빈 느낌이야"],"n":null},"M4-2.4.3":{"q":"둘 다 무거울 때 하루는 어떻게 지나가요?","o":["하루를 겨우 버텨내","해야 할 것만 겨우 해","거의 누워서 지내","어떻게 지나갔는지 몰라"],"n":null},"M4-2.4.4":{"q":"원인을 알면 좀 나아질 것 같아요?","o":["알면 나아질 것 같아","알아도 똑같을 것 같아","알고 싶은데 좀 무서워","잘 모르겠어"],"n":null},"M4-3.1.1":{"q":"잠들기 전에 주로 무슨 생각을 해요?","o":["걱정이 계속 머리에 맴돌아","지난 일이 자꾸 후회돼","내일 할 일을 생각해","아무 생각 없이 폰만 봐"],"n":null},"M4-3.1.2":{"q":"깨고 나면 어떻게 해요?","o":["깨면 다시 잠을 못 자","깨면 일단 폰부터 봐","누워서 이런저런 생각해","깨도 금방 다시 자"],"n":null},"M4-3.1.3":{"q":"많이 자는 건 피하고 싶어서일까요?","o":["피하고 싶어서 자는 것 같아","진짜 너무 피곤해서 자","할 게 없어서 자는 거야","잘 모르겠어, 그냥 자"],"n":null},"M4-3.1.4":{"q":"피로가 풀리지 않을 때 해본 게 있어요?","o":["운동을 해본 적 있어","영양제를 먹어본 적 있어","일찍 자보려고 했어","아무것도 안 해봤어"],"n":null},"M4-3.2.1":{"q":"기운이 생긴다면 누구를 만나고 싶어요?","o":["기운 나면 오랜 친구 만날래","기운 나면 가족을 만날래","기운 나면 편한 동료 만날래","기운이 나도 아무도 싫어"],"n":null},"M4-3.2.2":{"q":"얘기할 게 없다는 건 어떤 느낌이에요?","o":["내 일상이 텅 빈 것 같아","털어놓기가 싫은 것 같아","대화하는 게 귀찮아","다 비슷한 얘기뿐이야"],"n":null},"M4-3.2.3":{"q":"지친 모습을 보이기 싫은 이유는?","o":["괜히 걱정시킬까 봐 그래","약해 보일까 봐 싫어","설명하기가 너무 힘들어","원래 그런 모습 안 보여줘"],"n":null},"M4-3.2.4":{"q":"끊긴 연락을 다시 잇고 싶은 사람이 있어요?","o":["다시 이어보고 싶은 사람 있어","있는지 잘 모르겠어","이어도 부담될 것 같아","그런 사람은 없는 것 같아"],"n":null},"M4-3.3.1":{"q":"집중이 안 될 때 뭘 하게 돼요?","o":["집중 안 되면 폰을 보게 돼","집중 안 되면 멍해져","딴 일을 하게 돼","그 자리를 피하게 돼"],"n":null},"M4-3.3.2":{"q":"시작을 못 하는 이유는 뭐 같아요?","o":["일이 너무 커 보여서 그래","잘 못할까 봐 겁나","의미가 없어 보여서 그래","그냥 몸이 안 움직여"],"n":null},"M4-3.3.3":{"q":"머리에 안 들어오면 어떤 마음이에요?","o":["내가 왜 이러나 싶어","좀 무서운 기분이 들어","다 포기하고 싶어져","그냥 그런 기분이야"],"n":null},"M4-3.3.4":{"q":"실수가 늘면서 나를 어떻게 보게 됐어요?","o":["내가 무능한 것 같아","지쳐서 그런 거야","이러다 큰일 날까 걱정돼","나도 잘 모르겠어"],"n":null},"M4-3.4.1":{"q":"웃음이 줄어든 게 언제부터인지 알아요?","o":["어떤 일 이후로 줄은 것 같아","서서히 줄어들었던 것 같아","원래 잘 안 웃는 편이야","언제부터인지 모르겠어"],"n":null},"M4-3.4.2":{"q":"조금이라도 웃을 수 있었던 순간은?","o":["친구와 통화할 때 웃었어","좋아하는 콘텐츠 볼 때 웃었어","맛있는 음식 먹을 때 웃었어","동물이나 아이 보면 웃게 돼"],"n":null},"M4-3.4.3":{"q":"혼자 웃을 때와 같이 웃을 때 뭐가 달라요?","o":["혼자 웃는 게 더 편해","같이 웃는 게 좋은데 어려워","혼자든 같이든 드물게 웃어","잘 모르겠어, 비슷해"],"n":null},"M4-3.4.4":{"q":"누구와 있을 때 제일 편해요?","o":["가족이랑 있을 때 제일 편해","오랜 친구랑 있을 때 편해","연인이랑 있을 때 편해","혼자 있을 때가 제일 편해"],"n":null},"M4-4.1.1":{"q":"기운 있던 내가 있었다면 그땐 어땠을까요?","o":["하고 싶은 게 많았겠지","사람을 좋아했겠지","잘 웃고 다녔겠지","그런 내가 상상이 안 돼"],"n":null},"M4-4.1.2":{"q":"정말 기억나는 활기찬 때가 없어요?","o":["어릴 때는 활기찬 때 있었어","학생 때는 활기찼던 것 같아","잠깐씩은 기운 난 적 있어","정말 기억나는 때가 없어"],"n":null},"M4-4.1.3":{"q":"누가 그렇게 말해요?","o":["가족들이 그렇게 말해","친구들이 그렇게 말해","회사 사람들이 그렇게 말해","내가 나한테 그렇게 말해"],"n":null},"M4-4.1.4":{"q":"조금이라도 나아졌던 때가 있었어요?","o":["쉬었을 때 조금 나아졌어","환경이 바뀌었을 때 나아졌어","좋은 사람 만났을 때 나아졌어","나아진 적이 없었어"],"n":null},"M4-4.2.1":{"q":"미룰 때 마음속은 어때요?","o":["하고 싶은데 몸이 안 따라줘","그냥 다 귀찮아서 미뤄","시작하기가 무서워","아무 생각도 안 들어"],"n":null},"M4-4.2.2":{"q":"하루를 그냥 보내면 어떤 기분이에요?","o":["죄책감이 확 밀려와","허무한 마음이 들어","오히려 마음이 편해","별로 아무렇지 않아"],"n":null},"M4-4.2.3":{"q":"남들과 비교하면 어떻게 느껴져요?","o":["남들보다 한참 뒤처진 것 같아","나만 못 하는 것 같아","사람마다 각자 다르겠지","비교하는 것 자체가 싫어"],"n":null},"M4-4.2.4":{"q":"그 말을 들으면 어떤 마음이에요?","o":["그 말에 상처받아","맞는 말 같아서 찔려","솔직히 좀 억울해","이제는 무뎌졌어"],"n":null},"M4-4.3.1":{"q":"버텨온 일 중 제일 힘들었던 건?","o":["일이 제일 힘들었어","학업이나 시험이 힘들었어","가족 돌봄이 제일 힘들었어","여러 개가 한꺼번에 겹쳤어"],"n":null},"M4-4.3.2":{"q":"반복된 관계 문제는 어떤 거예요?","o":["가족 관계가 계속 반복돼","연애 문제가 계속 반복돼","친구 문제가 계속 반복돼","직장 관계가 계속 반복돼"],"n":null},"M4-4.3.3":{"q":"돈 걱정이 마음을 어떻게 지치게 해요?","o":["늘 계산하느라 지쳐","하고 싶은 걸 못 해서 답답해","미래가 안 보여서 막막해","남들과 비교돼서 위축돼"],"n":null},"M4-4.3.4":{"q":"나를 몰아붙이는 건 어떤 식이에요?","o":["쉬면 안 된다고 나를 다그쳐","늘 부족하다고 나를 몰아","남 기준에 나를 맞추고 있어","내 실수를 용서를 못 해"],"n":null},"M4-4.4.1":{"q":"쉰다면 얼마나 쉬고 싶어요?","o":["며칠만 쉬어도 좋겠어","몇 주는 쉬고 싶어","몇 달은 쉬어야 할 것 같아","아주 오래 쉬고 싶어"],"n":null},"M4-4.4.2":{"q":"누가 들어줬으면 좋겠어요?","o":["가족이 들어줬으면 좋겠어","친구가 들어줬으면 좋겠어","전혀 모르는 사람이 편할 것 같아","그냥 누구라도 들어줬으면 해"],"n":null},"M4-4.4.3":{"q":"어떤 환경을 바꾸고 싶어요?","o":["일 환경을 바꾸고 싶어","사는 곳을 바꾸고 싶어","만나는 사람들을 바꾸고 싶어","하루 루틴을 바꾸고 싶어"],"n":null},"M4-4.4.4":{"q":"모를 때 작은 것 하나만 해본다면?","o":["산책 정도는 해볼 수 있겠어","일찍 자는 건 해볼 만해","누구한테 연락해볼까 싶어","정말 뭘 해야 할지 모르겠어"],"n":null}}}