{"start":"W4-0","nodes":{"W4-0":{"q":"돈 고민, 어느 쪽이 제일 커요?","o":["월급이 일에 비해 적어","나갈 돈이 너무 많아","모아둔 게 없어 불안해","갚아야 할 게 있어"],"n":["W4-1","W4-2","W4-3","W4-4"]},"W4-1":{"q":"월급이 적다고 느끼는 기준은 뭐예요?","o":["하는 일에 비해 적은 것 같아","또래랑 비교하면 적어 보여","오래 동안 월급이 안 올랐어","생활하기엔 늘 빠듯해"],"n":["W4-1.1","W4-1.2","W4-1.3","W4-1.4"]},"W4-2":{"q":"어디로 나가는 돈이 제일 커요?","o":["집세랑 생활비가 제일 커","가족한테 드리는 돈이 커","카드값이랑 할부가 커","나도 모르게 새는 것 같아"],"n":["W4-2.1","W4-2.2","W4-2.3","W4-2.4"]},"W4-3":{"q":"모아둔 게 없어서 제일 불안한 순간은?","o":["갑자기 돈 나갈 때 불안해","미래를 생각하면 불안해","남들이랑 비교하면 불안해","일이 끊길까 봐 불안해"],"n":["W4-3.1","W4-3.2","W4-3.3","W4-3.4"]},"W4-4":{"q":"갚아야 할 건 어떤 거예요?","o":["학자금이 남아 있어","카드값이나 할부가 있어","대출을 갚고 있어","가족이나 지인한테 빌렸어"],"n":["W4-4.1","W4-4.2","W4-4.3","W4-4.4"]},"W4-1.1":{"q":"일에 비해 적다고 느끼는 부분은?","o":["내가 맡은 책임이 너무 커","야근이 너무 많은 것 같아","남들 몫까지 내가 하고 있어","결과를 내도 그대로야"],"n":["W4-1.1.1","W4-1.1.2","W4-1.1.3","W4-1.1.4"]},"W4-1.2":{"q":"또래와 비교하게 되는 계기는?","o":["친구 연봉 얘기를 들으면 그래","SNS 소비 보면 비교돼","결혼이나 집 얘기가 나오면 그래","같은 업계 공고를 보면 그래"],"n":["W4-1.2.1","W4-1.2.2","W4-1.2.3","W4-1.2.4"]},"W4-1.3":{"q":"연봉이 안 오른 이유는 뭐 같아요?","o":["회사 사정이 안 좋은 것 같아","내가 평가를 못 받아서 같아","내가 협상을 못 해서 같아","원래 안 올려주는 곳이야"],"n":["W4-1.3.1","W4-1.3.2","W4-1.3.3","W4-1.3.4"]},"W4-1.4":{"q":"빠듯한 생활에서 제일 아끼는 건?","o":["식비부터 아끼게 돼","취미나 여가를 제일 아껴","사람 만나는 돈을 아끼게 돼","나를 위한 돈을 아끼게 돼"],"n":["W4-1.4.1","W4-1.4.2","W4-1.4.3","W4-1.4.4"]},"W4-2.1":{"q":"집세와 생활비, 얼마나 부담돼요?","o":["월급 반이 거기로 나가","겨우 맞추는 정도야","더 아낄 데가 없어","비용이 계속 오르고 있어"],"n":["W4-2.1.1","W4-2.1.2","W4-2.1.3","W4-2.1.4"]},"W4-2.2":{"q":"가족한테 드리는 돈은 어떤 의미예요?","o":["가족이니까 당연한 책임이야","부담스러운데 말을 못 해","이러다 내 미래가 걱정돼","기쁜 마음으로 드리고 있어"],"n":["W4-2.2.1","W4-2.2.2","W4-2.2.3","W4-2.2.4"]},"W4-2.3":{"q":"카드값은 주로 어디서 쌓여요?","o":["생활비로 카드를 쓰게 돼","쇼핑이나 충동구매가 많아","큰 할부가 쌓여 있어","경조사나 모임에서 쌓여"],"n":["W4-2.3.1","W4-2.3.2","W4-2.3.3","W4-2.3.4"]},"W4-2.4":{"q":"새는 돈은 대충 어디로 가는 것 같아요?","o":["배달이나 외식에 새는 것 같아","구독 서비스에 새는 것 같아","커피나 간식에 새는 것 같아","진짜 어디서 새는지 모르겠어"],"n":["W4-2.4.1","W4-2.4.2","W4-2.4.3","W4-2.4.4"]},"W4-3.1":{"q":"갑자기 돈 나갈 일이 생기면 어떻게 해요?","o":["일단 카드로 막아","가족한테 빌리게 돼","대출을 생각하게 돼","아직 그런 적은 없어"],"n":["W4-3.1.1","W4-3.1.2","W4-3.1.3","W4-3.1.4"]},"W4-3.2":{"q":"미래 중에 제일 크게 걸리는 건?","o":["결혼이 제일 걸려","내 집 마련이 제일 걸려","노후가 제일 걸려","아플 때가 제일 걸려"],"n":["W4-3.2.1","W4-3.2.2","W4-3.2.3","W4-3.2.4"]},"W4-3.3":{"q":"누구와 비교할 때 제일 불안해요?","o":["친구들이랑 비교할 때 그래","회사 동료랑 비교할 때 그래","형제나 친척이랑 비교할 때 그래","SNS 속 사람들 보면 그래"],"n":["W4-3.3.1","W4-3.3.2","W4-3.3.3","W4-3.3.4"]},"W4-3.4":{"q":"일이 끊길까 봐 걱정되는 이유는?","o":["회사가 불안해서 걱정돼","계약직이라 걱정돼","몸이 안 좋아서 걱정돼","그냥 늘 불안한 마음이야"],"n":["W4-3.4.1","W4-3.4.2","W4-3.4.3","W4-3.4.4"]},"W4-4.1":{"q":"학자금은 얼마나 남은 것 같아요?","o":["아직 한참 남은 것 같아","절반쯤은 갚은 것 같아","거의 다 갚아가고 있어","잘 안 봐서 잘 모르겠어"],"n":["W4-4.1.1","W4-4.1.2","W4-4.1.3","W4-4.1.4"]},"W4-4.2":{"q":"카드값을 갚을 때 어떤 상황이에요?","o":["월급 대부분이 빠져나가","최소 결제만 겨우 해","지금 돌려막고 있어","겨우겨우 맞추고 있어"],"n":["W4-4.2.1","W4-4.2.2","W4-4.2.3","W4-4.2.4"]},"W4-4.3":{"q":"대출은 어떤 이유로 받았어요?","o":["집 때문에 받은 대출이야","생활비가 모자라서 받았어","사업이나 투자 때문에 받았어","다른 빚 갚으려고 받았어"],"n":["W4-4.3.1","W4-4.3.2","W4-4.3.3","W4-4.3.4"]},"W4-4.4":{"q":"빌린 돈 때문에 어떤 마음이 제일 커요?","o":["그냥 너무 미안한 마음이야","관계가 어색해져서 마음이 그래","빨리 갚고 싶은 마음뿐이야","갚을 방법이 안 보여서 답답해"],"n":["W4-4.4.1","W4-4.4.2","W4-4.4.3","W4-4.4.4"]},"W4-1.1.1":{"q":"책임만큼 받으려면 뭐가 필요할까요?","o":["승진을 해야 할 것 같아","연봉 협상을 해야 할 것 같아","이직을 해야 할 것 같아","뭐가 필요한지 잘 모르겠어"],"n":null},"W4-1.1.2":{"q":"야근은 보상받고 있어요?","o":["야근 보상은 전혀 안 돼","조금은 보상이 되는 편이야","포괄임금이라 보상이 없어","따질 엄두가 안 나"],"n":null},"W4-1.1.3":{"q":"남의 몫까지 하는 이유는?","o":["사람이 부족해서 하게 돼","거절을 못 해서 하게 돼","내가 잘해서 맡게 되는 것 같아","어쩌다 보니 이렇게 됐어"],"n":null},"W4-1.1.4":{"q":"결과를 내도 그대로면 어떤 마음이에요?","o":["의욕이 완전히 꺾여","회사가 좀 원망스러워","나가야겠다는 생각이 들어","그냥 그러려니 해"],"n":null},"W4-1.2.1":{"q":"친구 얘기 들으면 어떤 생각이 들어요?","o":["내가 잘못 온 건가 싶어","솔직히 좀 부러워","나도 올려야겠다 싶어","그래도 난 괜찮아"],"n":null},"W4-1.2.2":{"q":"SNS를 보고 나면 어때요?","o":["보고 나면 내가 초라해져","보고 나면 소비가 늘어","오히려 자극이 돼","봐도 금방 잊어버려"],"n":null},"W4-1.2.3":{"q":"그 얘기가 부담되는 이유는?","o":["나도 해야 할 것 같아서 그래","시작도 못 할 것 같아서 그래","가족이 기대하는 게 느껴져","나만 늦은 것 같아서 그래"],"n":null},"W4-1.2.4":{"q":"공고를 보면 내 연봉은 어때요?","o":["내 연봉이 꽤 많이 낮아","내 연봉이 비슷한 편이야","내 연봉이 조금 낮은 편이야","확인하는 게 좀 무서워"],"n":null},"W4-1.3.1":{"q":"회사 사정이 좋아질 것 같아요?","o":["전혀 기대가 안 돼","조금은 기대해 보게 돼","오히려 더 나빠질 것 같아","잘 모르겠어, 감이 안 와"],"n":null},"W4-1.3.2":{"q":"평가가 낮은 이유는 뭐 같아요?","o":["상사랑 잘 안 맞는 것 같아","내 성과가 안 보이는 것 같아","평가 기준이 불공정한 것 같아","나도 이유를 잘 모르겠어"],"n":null},"W4-1.3.3":{"q":"협상이 어려운 이유는?","o":["말을 꺼내기가 너무 어려워","내세울 근거가 부족해","잘릴까 봐 겁이 나","해봤는데 안 됐어"],"n":null},"W4-1.3.4":{"q":"그래도 남아 있는 이유는?","o":["다른 데 갈 자신이 없어서야","그래도 안정적이라서야","같이 일하는 사람이 좋아서야","곧 옮길 생각이야"],"n":null},"W4-1.4.1":{"q":"식비를 줄이면 어떻게 지내요?","o":["편의점 음식으로 버티고 있어","끼니를 거를 때도 있어","도시락을 싸서 다녀","그래도 먹는 건 쓰는 편이야"],"n":null},"W4-1.4.2":{"q":"취미를 줄이고 나서 어때요?","o":["요즘 삶이 재미없어","괜찮아, 버틸 만해","스트레스가 계속 쌓여","원래 취미가 별로 없었어"],"n":null},"W4-1.4.3":{"q":"사람을 덜 만나면서 어떤 마음이에요?","o":["요즘 많이 외로워","한편으로는 편하기도 해","관계가 멀어질까 걱정돼","사람들한테 미안해"],"n":null},"W4-1.4.4":{"q":"나를 위해 쓰는 돈, 언제가 마지막이었어요?","o":["언제였는지 기억이 안 나","몇 달 전이었던 것 같아","최근에 조금 썼어","쓰면 죄책감이 들어"],"n":null},"W4-2.1.1":{"q":"지금 집을 바꿀 생각도 있어요?","o":["더 싼 곳으로 가고 싶어","본가로 들어갈까 고민 중이야","이사도 돈이라 못 하겠어","지금 집이 최선인 것 같아"],"n":null},"W4-2.1.2":{"q":"겨우 맞출 때 제일 불안한 건?","o":["갑자기 돈 나갈 일이 불안해","아플 때가 제일 불안해","일이 끊길까 봐 불안해","미래가 안 보여서 불안해"],"n":null},"W4-2.1.3":{"q":"줄일 데가 없으면 늘릴 방법은요?","o":["부업을 해볼까 생각 중이야","이직을 해볼까 생각 중이야","방법을 모르겠어","너무 지쳐서 생각도 못 해"],"n":null},"W4-2.1.4":{"q":"오르는 비용, 어떻게 감당하고 있어요?","o":["저축을 줄여서 버티고 있어","카드로 버티고 있어","가족 도움을 받고 있어","아직은 감당할 만해"],"n":null},"W4-2.2.1":{"q":"책임감이 무겁게 느껴질 때는?","o":["내 계획을 미룰 때 무거워","혼자 감당할 때 무거워","끝이 안 보일 때 무거워","고마워하지 않을 때 무거워"],"n":null},"W4-2.2.2":{"q":"말 못 하는 이유는?","o":["실망하실까 봐 말을 못 해","싸움이 날까 봐 말을 못 해","나밖에 없어서 말을 못 해","이기적으로 보일까 봐 못 해"],"n":null},"W4-2.2.3":{"q":"내 미래 중 제일 걱정되는 건?","o":["결혼이 제일 걱정돼","내 집이 제일 걱정돼","노후가 제일 걱정돼","하고 싶은 일이 제일 걱정돼"],"n":null},"W4-2.2.4":{"q":"그래도 기쁘게 드릴 수 있는 이유는?","o":["받은 게 많아서 드리는 거야","내가 할 수 있어서 드리는 거야","가족이 제일 소중하니까 그래","드리면 마음이 편해져"],"n":null},"W4-2.3.1":{"q":"생활비를 카드로 돌리게 된 건 언제부터?","o":["최근 몇 달 사이부터야","꽤 오래된 일이야","월급날 전마다 그렇게 돼","언제부턴지 기억이 안 나"],"n":null},"W4-2.3.2":{"q":"충동구매는 주로 언제 해요?","o":["스트레스 받을 때 지르게 돼","밤에 폰 볼 때 지르게 돼","할인할 때 지르게 돼","기분 좋을 때 지르게 돼"],"n":null},"W4-2.3.3":{"q":"큰 할부는 어떤 거예요?","o":["차 할부가 제일 커","전자기기 할부가 제일 커","이사나 가구 할부가 제일 커","교육이나 자기계발 할부야"],"n":null},"W4-2.3.4":{"q":"모임 돈이 부담돼도 가는 이유는?","o":["빠지면 눈치가 보여서 가","관계가 끊길까 봐 가","그래도 즐거워서 가는 거야","거절을 못 해서 가게 돼"],"n":null},"W4-2.4.1":{"q":"배달을 자주 시키는 이유는?","o":["요리할 힘이 없어서 시켜","시간이 없어서 시켜","혼자라 편해서 시켜","먹는 게 낙이라서 시켜"],"n":null},"W4-2.4.2":{"q":"구독 중에 안 쓰는 게 있어요?","o":["안 쓰는 게 꽤 있을 것 같아","다 쓰는 편이야","확인을 안 해봤어","끊기가 귀찮아서 둬"],"n":null},"W4-2.4.3":{"q":"작은 돈을 쓸 때 어떤 마음이에요?","o":["이 정도는 괜찮겠지 싶어","이게 유일한 낙이야","쓰고 나면 후회돼","아무 생각 없이 써"],"n":null},"W4-2.4.4":{"q":"돈 관리를 해본 적 있어요?","o":["가계부 써봤는데 포기했어","앱만 깔아놓고 안 썼어","돈 관리는 한 번도 안 해봤어","하긴 하는데 잘 안 돼"],"n":null},"W4-3.1.1":{"q":"카드로 막고 나면 어떻게 돼요?","o":["다음 달이 더 힘들어져","계속 돌려막게 돼","겨우겨우 갚고 있어","생각하기도 싫어"],"n":null},"W4-3.1.2":{"q":"빌릴 때 어떤 마음이에요?","o":["미안하고 창피한 마음이야","어쩔 수 없다는 마음이야","고마운 마음이 커","다시는 안 하고 싶어"],"n":null},"W4-3.1.3":{"q":"대출이 걱정되는 이유는?","o":["이자가 너무 무서워","갚을 자신이 없어","처음이라 잘 몰라서 걱정돼","신용에 문제 생길까 걱정돼"],"n":null},"W4-3.1.4":{"q":"그런 일이 생길까 늘 대비하는 편이에요?","o":["늘 불안해서 대비하는 편이야","생기면 그때 생각하는 편이야","비상금을 모으려고 하고 있어","대비할 여유가 없어"],"n":null},"W4-3.2.1":{"q":"결혼을 생각하면 어떤 마음이에요?","o":["돈 때문에 엄두가 안 나","하고 싶은데 너무 막막해","아직은 생각이 없어","상대에게 미안한 마음이야"],"n":null},"W4-3.2.2":{"q":"집은 어떻게 생각하고 있어요?","o":["평생 못 살 것 같아","언젠간 꼭 사고 싶어","전세라도 갔으면 좋겠어","이제 그냥 포기했어"],"n":null},"W4-3.2.3":{"q":"노후 걱정은 언제부터 들었어요?","o":["최근에 부쩍 걱정되기 시작했어","부모님 보면서 걱정이 됐어","늘 걱정하고 있었어","아직 먼 얘기 같아"],"n":null},"W4-3.2.4":{"q":"아플 때 대비가 안 된 게 걱정돼요?","o":["보험이 없어서 걱정돼","쉬면 수입이 끊겨서 걱정돼","혼자라서 더 무서워","그냥 생각 안 하려고 해"],"n":null},"W4-3.3.1":{"q":"친구들은 어느 정도 모은 것 같아요?","o":["다 나보다 많이 모았을 것 같아","나랑 비슷할 것 같아","사실 잘 모르겠어","물어보기가 무서워"],"n":null},"W4-3.3.2":{"q":"동료들 얘기 들으면 어떤 생각이 들어요?","o":["나만 못 모은 것 같아","나도 투자라도 해야 하나","다들 각자 사정이 있겠지","그런 얘기는 듣기 싫어"],"n":null},"W4-3.3.3":{"q":"가족 사이 비교가 더 아픈 이유는?","o":["대놓고 비교당해서 더 아파","실망시킨 것 같아서 더 아파","늘 비교받아 와서 더 아파","벗어날 수 없어서 더 아파"],"n":null},"W4-3.3.4":{"q":"SNS 속 사람들은 진짜 같아요?","o":["다 보여주기겠지 싶어","그래도 부러운 건 어쩔 수 없어","나만 뒤처진 느낌이 들어","그래서 안 보려고 해"],"n":null},"W4-3.4.1":{"q":"회사가 어려워지면 뭐부터 걱정돼요?","o":["당장 생활비가 걱정돼","다시 구할 수 있을지 걱정돼","경력이 끊길까 걱정돼","가족 반응이 걱정돼"],"n":null},"W4-3.4.2":{"q":"계약 끝나면 어떻게 할 생각이에요?","o":["연장되면 좋겠다고 바라고 있어","이미 알아보는 중이야","아직 생각 안 해봤어","생각하면 막막해"],"n":null},"W4-3.4.3":{"q":"몸이 안 좋은데도 일하는 이유는?","o":["쉬면 돈이 없어서 일해","회사 눈치가 보여서 일해","아직은 버틸 만해서 일해","쉬는 게 더 불안해서 일해"],"n":null},"W4-3.4.4":{"q":"불안이 클 때 어떻게 달래요?","o":["잠으로 피하려고 해","돈 계산을 계속 하게 돼","누군가한테 얘기를 해","그냥 견디고 있어"],"n":null},"W4-4.1.1":{"q":"한참 남은 걸 생각하면 어때요?","o":["생각하면 너무 막막해","그냥 꾸준히 갚아가고 있어","좀 억울하기도 해","생각 안 하려고 해"],"n":null},"W4-4.1.2":{"q":"반쯤 왔을 때 제일 힘든 건?","o":["끝이 안 보여서 힘들어","다른 데 쓸 돈이 없어서 힘들어","이자 때문에 힘들어","그래도 버틸 만해"],"n":null},"W4-4.1.3":{"q":"다 갚으면 제일 먼저 하고 싶은 건?","o":["저축부터 하고 싶어","여행을 가고 싶어","나한테 선물을 주고 싶어","이사를 하고 싶어"],"n":null},"W4-4.1.4":{"q":"확인하기 싫은 이유는?","o":["숫자를 보면 우울해져","어차피 갚는 거라 안 봐","바빠서 확인을 못 했어","보는 게 너무 무서워"],"n":null},"W4-4.2.1":{"q":"월급이 다 나가면 한 달은 어떻게 버텨요?","o":["또 카드를 쓰게 돼","최대한 안 쓰려고 해","가족 도움을 받아","버티기가 너무 힘들어"],"n":null},"W4-4.2.2":{"q":"최소 결제만 하면 마음은 어때요?","o":["불안한데 어쩔 수 없어","이자가 너무 무서워","일단 넘기고 보는 거야","계속 쌓이는 게 눈에 보여"],"n":null},"W4-4.2.3":{"q":"돌려막기는 얼마나 됐어요?","o":["몇 달 정도 됐어","1년 넘게 이러고 있어","막 시작한 참이야","끊고 싶은데 못 끊겠어"],"n":null},"W4-4.2.4":{"q":"겨우 맞추는 걸 언제까지 할 수 있을까요?","o":["오래는 못 할 것 같아","더 버틸 수 있을 것 같아","수입이 늘면 괜찮을 것 같아","모르겠어, 감이 안 와"],"n":null},"W4-4.3.1":{"q":"집 대출 이자는 감당할 만해요?","o":["이자가 너무 버거워","빠듯하게 감당하고 있어","금리가 오를까 걱정돼","아직은 괜찮은 편이야"],"n":null},"W4-4.3.2":{"q":"생활비 대출을 받을 때 어떤 마음이었어요?","o":["그땐 어쩔 수 없었어","받는 게 창피했어","금방 갚을 줄 알았어","받을 때 무서웠어"],"n":null},"W4-4.3.3":{"q":"사업이나 투자는 지금 어때요?","o":["이미 손해를 봤어","아직 진행 중인 상태야","이제 다 정리했어","솔직히 말하기 어려워"],"n":null},"W4-4.3.4":{"q":"빚을 빚으로 막으면서 드는 생각은?","o":["끝이 안 보이는 것 같아","한 번만 버티면 될 것 같아","누군가 도와줬으면 좋겠어","생각하기도 싫어"],"n":null},"W4-4.4.1":{"q":"미안한 마음을 전한 적 있어요?","o":["미안하다고 자주 말해","아직 말을 못 했어","행동으로 보여주려고 해","자꾸 피하게 돼"],"n":null},"W4-4.4.2":{"q":"어색해진 관계, 회복하고 싶어요?","o":["꼭 회복하고 싶어","갚고 나면 괜찮아지겠지","이미 멀어진 것 같아","어떻게 하고 싶은지 모르겠어"],"n":null},"W4-4.4.3":{"q":"빨리 갚기 위해 뭘 해볼 수 있을까요?","o":["지출을 줄여볼 수 있을 것 같아","부업을 해볼 수 있을 것 같아","조금씩 나눠 갚을 수 있어","아직 계획이 없어"],"n":null},"W4-4.4.4":{"q":"갚을 방법이 안 보이면 어떻게 해요?","o":["혼자 끙끙 앓게 돼","솔직하게 말할까 고민돼","피하기만 하고 있어","도움을 받고 싶어"],"n":null}}}