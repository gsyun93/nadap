{"start":"M3-0","nodes":{"M3-0":{"q":"언제 그 마음이 제일 크게 들어요?","o":["실수했을 때","거울 볼 때","남이랑 비교할 때","혼자 있을 때"],"n":["M3-1","M3-2","M3-3","M3-4"]},"M3-1":{"q":"어떤 실수에서 그 마음이 커져요?","o":["일에서 실수할 때 특히 심해","사람한테 말실수하면 커져","같은 실수를 반복하면 더 커져","작은 실수에도 마음이 커져"],"n":["M3-1.1","M3-1.2","M3-1.3","M3-1.4"]},"M3-2":{"q":"거울을 보면 어떤 생각이 들어요?","o":["내 얼굴이 영 마음에 안 들어","내 몸이 마음에 안 들어","내가 많이 지쳐 보여","그냥 거울 보기가 싫어"],"n":["M3-2.1","M3-2.2","M3-2.3","M3-2.4"]},"M3-3":{"q":"누구와 비교할 때 제일 작아져요?","o":["친구랑 비교하면 작아져","동료랑 비교하면 작아져","SNS 속 사람들 보면 작아져","가족이랑 비교하면 작아져"],"n":["M3-3.1","M3-3.2","M3-3.3","M3-3.4"]},"M3-4":{"q":"혼자 있을 때 어떤 생각이 커져요?","o":["내가 한 말이나 행동이 떠올라","나는 쓸모없나 싶어","아무도 날 안 찾는 것 같아","앞으로가 너무 막막해"],"n":["M3-4.1","M3-4.2","M3-4.3","M3-4.4"]},"M3-1.1":{"q":"일에서 실수하면 어떤 생각이 들어요?","o":["난 왜 이럴까 싶어","다들 날 무능하게 볼 것 같아","잘릴까 봐 너무 무서워","자꾸 계속 곱씹게 돼"],"n":["M3-1.1.1","M3-1.1.2","M3-1.1.3","M3-1.1.4"]},"M3-1.2":{"q":"말실수를 하고 나면 어떻게 돼요?","o":["그 장면이 계속 떠올라","상대가 날 싫어할 것 같아","다시 연락하기가 어려워","사과해도 마음이 안 놓여"],"n":["M3-1.2.1","M3-1.2.2","M3-1.2.3","M3-1.2.4"]},"M3-1.3":{"q":"반복되는 실수는 어떤 거예요?","o":["늦거나 깜빡할 때가 많아","말을 너무 많이 하는 편이야","자꾸 미루게 돼","감정을 잘 못 참겠어"],"n":["M3-1.3.1","M3-1.3.2","M3-1.3.3","M3-1.3.4"]},"M3-1.4":{"q":"작은 실수에도 그런 이유는 뭐 같아요?","o":["완벽해야 할 것 같아서 그래","혼나며 자라서 그런 것 같아","실수가 쌓여서 그런 것 같아","원래 내가 예민해서 그래"],"n":["M3-1.4.1","M3-1.4.2","M3-1.4.3","M3-1.4.4"]},"M3-2.1":{"q":"얼굴 중 제일 신경 쓰이는 부분은?","o":["피부가 제일 신경 쓰여","이목구비가 제일 신경 쓰여","표정이 제일 신경 쓰여","나이 들어 보이는 게 걸려"],"n":["M3-2.1.1","M3-2.1.2","M3-2.1.3","M3-2.1.4"]},"M3-2.2":{"q":"몸에서 마음에 안 드는 건?","o":["체형이 마음에 안 들어","체중이 마음에 안 들어","체력이 마음에 안 들어","자세나 분위기가 아쉬워"],"n":["M3-2.2.1","M3-2.2.2","M3-2.2.3","M3-2.2.4"]},"M3-2.3":{"q":"지쳐 보이는 건 무엇 때문일까요?","o":["잠이 너무 부족한 것 같아","일이 너무 힘들어서 그래","마음이 지쳐서 그런 것 같아","내가 나를 안 챙겨서 그래"],"n":["M3-2.3.1","M3-2.3.2","M3-2.3.3","M3-2.3.4"]},"M3-2.4":{"q":"거울을 보기 싫은 마음은 언제부터였어요?","o":["최근 들어 그런 것 같아","꽤 오래전부터 그랬어","어떤 일을 겪고 나서부터야","생각해 보면 늘 그랬어"],"n":["M3-2.4.1","M3-2.4.2","M3-2.4.3","M3-2.4.4"]},"M3-3.1":{"q":"친구의 어떤 점과 비교돼요?","o":["친구랑 외모가 비교돼","성격이나 인기가 비교돼","능력이나 성공이 비교돼","연애나 관계가 비교돼"],"n":["M3-3.1.1","M3-3.1.2","M3-3.1.3","M3-3.1.4"]},"M3-3.2":{"q":"동료와 비교될 때는 언제예요?","o":["평가받을 때 비교가 돼","칭찬받는 걸 보면 비교돼","같은 일을 할 때 비교가 돼","회의 때 제일 비교가 돼"],"n":["M3-3.2.1","M3-3.2.2","M3-3.2.3","M3-3.2.4"]},"M3-3.3":{"q":"SNS 속 사람들은 나를 어떻게 만들어요?","o":["보고 있으면 내가 초라해져","보고 있으면 마음이 조급해져","보면 자극이 되긴 해","그냥 보는 것만으로 피곤해"],"n":["M3-3.3.1","M3-3.3.2","M3-3.3.3","M3-3.3.4"]},"M3-3.4":{"q":"가족 중 누구와 비교돼요?","o":["형제자매랑 비교당하곤 해","남의 집 자식이랑 비교당해","사촌이랑 자꾸 비교돼","부모님 자신이랑 비교돼"],"n":["M3-3.4.1","M3-3.4.2","M3-3.4.3","M3-3.4.4"]},"M3-4.1":{"q":"떠오르는 말이나 행동은 언제 일이에요?","o":["오늘 있었던 일이 떠올라","며칠 전 일이 떠올라","아주 오래된 일이 떠올라","그때그때 매번 달라"],"n":["M3-4.1.1","M3-4.1.2","M3-4.1.3","M3-4.1.4"]},"M3-4.2":{"q":"쓸모없다는 생각은 어디서 와요?","o":["일에서 인정을 못 받는 것 같아","누구한테도 필요 없는 것 같아","이룬 게 없다고 느껴져","그냥 이유 없이 그렇게 느껴져"],"n":["M3-4.2.1","M3-4.2.2","M3-4.2.3","M3-4.2.4"]},"M3-4.3":{"q":"아무도 안 찾는다고 느끼는 때는?","o":["주말에 특히 그렇게 느껴져","연락이 없을 때 그런 것 같아","단톡방이 조용하면 그래","생일이나 기념일에 그래"],"n":["M3-4.3.1","M3-4.3.2","M3-4.3.3","M3-4.3.4"]},"M3-4.4":{"q":"앞으로가 막막한 이유는?","o":["뭘 해야 할지 모르겠어","나아질 것 같지가 않아","혼자일까 봐 겁이 나","돈이나 일이 너무 불안해"],"n":["M3-4.4.1","M3-4.4.2","M3-4.4.3","M3-4.4.4"]},"M3-1.1.1":{"q":"그 생각이 들 때 스스로에게 뭐라고 해요?","o":["넌 늘 그렇다고 말하게 돼","바보 같다고 말하게 돼","다음엔 잘하자고 말해 줘","아무 말도 안 하게 돼"],"n":null},"M3-1.1.2":{"q":"남의 시선이 제일 신경 쓰이는 사람은?","o":["상사 눈치가 제일 보여","동료 시선이 제일 신경 쓰여","후배가 어떻게 볼지 신경 써","모두의 시선이 다 신경 쓰여"],"n":null},"M3-1.1.3":{"q":"그 불안은 얼마나 자주 와요?","o":["거의 매일 그런 불안이 와","실수할 때마다 불안이 와","가끔씩 그런 불안이 와","큰 실수를 했을 때만 와"],"n":null},"M3-1.1.4":{"q":"곱씹는 건 얼마나 오래 가요?","o":["하루 종일 곱씹게 되는 편이야","며칠씩 계속 곱씹게 돼","잘 때까지 계속 생각나","몇 달 전 일도 자꾸 떠올라"],"n":null},"M3-1.2.1":{"q":"그 장면이 떠오르면 어떤 기분이에요?","o":["너무 창피한 기분이 들어","그냥 숨고 싶은 기분이야","괜히 화가 나기도 해","저절로 한숨이 나와"],"n":null},"M3-1.2.2":{"q":"상대가 싫어할 거라고 생각하는 이유는?","o":["상대 표정이 변한 것 같아","연락이 줄어든 것 같아","그냥 그런 느낌이 들어","나라도 날 싫어할 것 같아"],"n":null},"M3-1.2.3":{"q":"다시 연락하기 어려운 이유는?","o":["또 실수할까 봐 겁이 나","괜히 어색할 것 같아","상대가 나를 피할 것 같아","뭐라고 할지 모르겠어"],"n":null},"M3-1.2.4":{"q":"사과했는데도 마음이 안 놓이는 이유는?","o":["진짜 용서했는지 모르겠어","내가 나를 용서 못 하겠어","같은 일이 또 생길 것 같아","원래 마음이 잘 안 놓여"],"n":null},"M3-1.3.1":{"q":"늦거나 깜빡할 때 나 자신에게 어떤 마음이에요?","o":["나 자신이 한심하게 느껴져","또 그랬구나 싶기만 해","이제 정말 고치고 싶어","이젠 그냥 체념했어"],"n":null},"M3-1.3.2":{"q":"말을 많이 하고 나면 어떤 생각이 들어요?","o":["내가 왜 그랬나 싶어","다들 질렸을 것 같아","다음엔 조용히 해야겠어","그래도 즐거웠던 것 같아"],"n":null},"M3-1.3.3":{"q":"미루고 나면 어떤 기분이에요?","o":["죄책감이 많이 들어","불안한 마음이 커져","나를 믿을 수가 없어","마감 직전에 몰아치게 돼"],"n":null},"M3-1.3.4":{"q":"감정을 못 참았을 때 후에 어때요?","o":["너무 부끄러운 마음이 들어","상대한테 미안한 마음뿐이야","내가 나를 미워하게 돼","내가 왜 그랬는지 알고 싶어"],"n":null},"M3-1.4.1":{"q":"완벽해야 한다는 마음은 누가 심어줬을까요?","o":["부모님이 심어준 것 같아","학교나 회사에서 생긴 것 같아","내가 스스로 만든 것 같아","누가 그랬는지 모르겠어"],"n":null},"M3-1.4.2":{"q":"혼났던 기억 중 아직 남은 게 있어요?","o":["혼났던 기억이 아직 많아","몇 장면이 아직 남아 있어","잘 기억이 나지 않아","그 얘기는 하고 싶지 않아"],"n":null},"M3-1.4.3":{"q":"쌓인 실수 때문에 나를 어떻게 보게 됐어요?","o":["나를 믿을 수 없는 사람 같아","나는 부족한 사람 같아","그래도 노력하는 사람 같아","나를 어떻게 봐야 할지 모르겠어"],"n":null},"M3-1.4.4":{"q":"예민함이 나를 힘들게 할 때는?","o":["사람 만날 때 예민해서 힘들어","일할 때 예민해서 힘들어","혼자 생각할 때 힘들어","예민해서 늘 힘들어"],"n":null},"M3-2.1.1":{"q":"그 부분 때문에 피하는 게 있어요?","o":["사진 찍는 걸 피하게 돼","사람 만나기를 피하게 돼","맨얼굴로 나가기가 싫어","딱히 피하는 건 없어"],"n":null},"M3-2.1.2":{"q":"이목구비를 보면 어떤 마음이에요?","o":["이목구비를 바꾸고 싶어","남들이랑 자꾸 비교돼","그냥 받아들이려고 하고 있어","싫지만 어쩔 수 없어"],"n":null},"M3-2.1.3":{"q":"내 표정이 어떻게 보여요?","o":["내 표정이 늘 피곤해 보여","내 표정이 너무 무표정해","내 표정이 화나 보여","내 표정이 슬퍼 보여"],"n":null},"M3-2.1.4":{"q":"나이 들어 보이는 게 왜 걸려요?","o":["시간이 아깝다는 생각이 들어","남들 시선이 신경 쓰여","이룬 것도 없는데 늙은 것 같아","그냥 마음이 속상해"],"n":null},"M3-2.2.1":{"q":"체형 때문에 신경 쓰는 게 있어요?","o":["옷 고르기가 제일 신경 쓰여","사진 찍을 때 신경 쓰여","사람들 시선이 신경 쓰여","운동하는 곳이 신경 쓰여"],"n":null},"M3-2.2.2":{"q":"체중 얘기를 들을 때 어떤 마음이에요?","o":["그 얘기를 들으면 위축돼","그 얘기에 화가 나","애써 신경 안 쓰려고 해","계속 그 말이 생각나"],"n":null},"M3-2.2.3":{"q":"체력이 떨어진 걸 느낄 때는?","o":["계단 오를 때 체력이 느껴져","퇴근하면 체력이 바닥이야","주말에도 피곤할 때 느껴져","예전이랑 비교하면 느껴져"],"n":null},"M3-2.2.4":{"q":"어떤 분위기를 갖고 싶어요?","o":["자신감 있는 분위기면 좋겠어","편안한 분위기를 갖고 싶어","단정한 분위기였으면 좋겠어","생기 있는 분위기가 좋아"],"n":null},"M3-2.3.1":{"q":"잠이 부족한 이유는?","o":["일이 늦게 끝나서 못 자","생각이 많아서 잠이 안 와","폰을 보다가 늦게 자","자도 계속 피곤해"],"n":null},"M3-2.3.2":{"q":"일이 나를 어떻게 지치게 해요?","o":["일의 양이 너무 많아","같이 일하는 사람이 힘들어","일에 의미를 못 느끼겠어","쉴 틈이 하나도 없어"],"n":null},"M3-2.3.3":{"q":"마음이 지친 건 언제부터예요?","o":["최근에 마음이 지친 것 같아","몇 달째 계속 지쳐 있어","마음이 지친 지 오래됐어","언제부터인지 잘 모르겠어"],"n":null},"M3-2.3.4":{"q":"나를 챙기지 못하는 이유는?","o":["나를 챙길 시간이 없어","나를 챙길 가치를 못 느껴","어떻게 챙기는지 모르겠어","남을 먼저 챙기게 돼"],"n":null},"M3-2.4.1":{"q":"최근 무슨 변화가 있었어요?","o":["최근에 몸이 변한 것 같아","생활이 많이 망가졌어","최근에 힘든 일이 있었어","딱히 변한 건 없는 것 같아"],"n":null},"M3-2.4.2":{"q":"오래된 마음, 계기가 있었을까요?","o":["놀림받은 기억이 남아 있어","비교당한 기억이 남아 있어","사춘기 때부터 그랬던 것 같아","계기가 기억나지 않아"],"n":null},"M3-2.4.3":{"q":"그 일이 나를 보는 눈을 어떻게 바꿨어요?","o":["그 뒤로 나를 탓하게 됐어","그 뒤로 자신감이 사라졌어","그 뒤로 다 싫어졌어","아직 마음이 정리가 안 돼"],"n":null},"M3-2.4.4":{"q":"나를 좋게 봤던 때가 있었어요?","o":["어릴 때는 나를 좋아했어","아주 잠깐은 좋아했던 것 같아","나를 좋게 본 적이 거의 없어","그런 적이 있었는지 기억 안 나"],"n":null},"M3-3.1.1":{"q":"외모 비교가 나를 어떻게 만들어요?","o":["같이 사진 찍기가 싫어져","나도 자꾸 꾸미게 돼","비교하면 위축돼","솔직히 질투가 나"],"n":null},"M3-3.1.2":{"q":"그 친구 성격의 어떤 점이 부러워요?","o":["그 친구의 밝은 모습이 부러워","그 친구의 자신감이 부러워","사람들이 좋아하는 게 부러워","편해 보이는 모습이 부러워"],"n":null},"M3-3.1.3":{"q":"친구가 잘되는 걸 보면 어떤 마음이에요?","o":["축하하면서도 마음이 씁쓸해","나도 뭔가 해야 할 것 같아","나는 안 될 것 같아","진심으로 기쁜 마음이 들어"],"n":null},"M3-3.1.4":{"q":"친구 관계를 보면 나는 어때요?","o":["그걸 보면 외로운 마음이 들어","나도 사랑받고 싶어","내가 부족한 것 같아","그냥 나랑은 다르다고 느껴"],"n":null},"M3-3.2.1":{"q":"평가가 나를 작게 만드는 이유는?","o":["숫자로 비교되는 게 싫어","기대보다 낮은 결과가 속상해","평가가 공정하지 않은 것 같아","내가 부족해서 그런 것 같아"],"n":null},"M3-3.2.2":{"q":"칭찬받는 동료를 보면 어떤 생각이 들어요?","o":["나는 왜 안 될까 싶어","나도 칭찬받고 싶어","저 사람은 운이 좋았나 봐","저 사람한테 배우고 싶어"],"n":null},"M3-3.2.3":{"q":"같은 일을 할 때 차이가 느껴지는 건?","o":["일하는 속도에서 차이가 느껴져","결과물에서 차이가 느껴져","말하는 방식에서 차이가 느껴져","자신감에서 차이가 느껴져"],"n":null},"M3-3.2.4":{"q":"회의에서 나는 어떤 편이에요?","o":["회의에서는 말을 아끼게 돼","말하고 나면 후회가 돼","생각이 잘 정리가 안 돼","주로 듣기만 하게 돼"],"n":null},"M3-3.3.1":{"q":"초라함이 들면 어떻게 해요?","o":["그래도 계속 더 보게 돼","그럴 땐 앱을 꺼 버려","나도 뭔가 올리고 싶어져","그냥 우울해지고 말아"],"n":null},"M3-3.3.2":{"q":"무엇이 제일 조급해져요?","o":["성공에 대해 제일 조급해져","외모에 대해 제일 조급해져","관계에 대해 제일 조급해져","나이에 대해 제일 조급해져"],"n":null},"M3-3.3.3":{"q":"자극이 실제로 도움이 된 적 있어요?","o":["자극이 도움 된 적도 있어","도움은 잠깐뿐인 것 같아","오히려 더 힘들어질 때가 많아","도움이 됐는지 잘 모르겠어"],"n":null},"M3-3.3.4":{"q":"그래도 계속 보는 이유는?","o":["그냥 습관처럼 보게 돼","심심해서 계속 보게 돼","사람들 소식이 궁금해서 봐","끊고 싶은데 끊기가 어려워"],"n":null},"M3-3.4.1":{"q":"형제와의 비교는 언제부터였어요?","o":["어릴 때부터 비교당했어","성인이 되고 나서 비교당했어","최근 들어 비교당하는 것 같아","비교는 늘 있었던 것 같아"],"n":null},"M3-3.4.2":{"q":"그 비교를 들으면 어떤 마음이에요?","o":["내가 실망스러운 자식 같아","듣고 있으면 화가 나","이젠 무뎌져 버렸어","나도 증명하고 싶어져"],"n":null},"M3-3.4.3":{"q":"사촌과의 비교는 어디서 들려요?","o":["명절 때 그런 말이 들려","부모님 말에서 듣게 돼","친척 단톡방에서 느껴져","직접 느끼게 되는 것 같아"],"n":null},"M3-3.4.4":{"q":"부모님처럼 살지 못한다는 생각이 들어요?","o":["부모님처럼 못 산다는 생각이 자주 들어","가끔 부모님처럼 못 사는 것 같아","오히려 부모님처럼 살기는 싫어","그런 생각이 드는지 잘 모르겠어"],"n":null},"M3-4.1.1":{"q":"오늘 일을 곱씹으면 어떤 기분이에요?","o":["오늘 일이 너무 후회돼","오늘 일이 너무 창피해","오늘 일에 화가 나","오늘 일 때문에 잠이 안 와"],"n":null},"M3-4.1.2":{"q":"며칠 지나도 남는 이유는?","o":["상대 반응이 계속 신경 쓰여","내가 너무 실망스러워서 그래","해결이 안 돼서 남아 있어","그냥 잘 안 잊혀"],"n":null},"M3-4.1.3":{"q":"오래된 일이 아직 떠오르는 이유는?","o":["그때 상처가 너무 컸거든","그때의 내가 너무 싫어서 그래","비슷한 일이 반복되는 것 같아","왜 그런지 모르겠어"],"n":null},"M3-4.1.4":{"q":"곱씹는 걸 멈추고 싶을 때 뭘 해요?","o":["그럴 땐 폰을 보게 돼","그럴 땐 잠을 청해 봐","그럴 땐 다른 일을 해","멈추고 싶어도 멈출 수가 없어"],"n":null},"M3-4.2.1":{"q":"인정받았던 순간이 있었어요?","o":["있긴 했는데 오래된 일이야","조금은 인정받은 적이 있어","인정받은 적이 거의 없어","그런 순간이 기억이 안 나"],"n":null},"M3-4.2.2":{"q":"누구에게 필요한 사람이고 싶어요?","o":["가족에게 필요한 사람이고 싶어","친구에게 필요한 사람이고 싶어","연인에게 필요한 사람이고 싶어","같이 일하는 사람에게 필요하고 싶어"],"n":null},"M3-4.2.3":{"q":"이룬 게 없다고 느끼는 기준은?","o":["나이를 생각하면 이룬 게 없어","남들이랑 비교하면 이룬 게 없어","내가 세운 목표에 못 미쳐","부모님 기대에 못 미치는 것 같아"],"n":null},"M3-4.2.4":{"q":"그 느낌이 들 때 무엇이 조금 도움이 돼요?","o":["누군가와 얘기하면 조금 나아","좋아하는 걸 하면 조금 나아","잠을 자면 조금 나아져","딱히 도움 되는 게 없어"],"n":null},"M3-4.3.1":{"q":"연락이 없을 때 나는 먼저 하는 편이에요?","o":["나는 먼저 연락하는 편이야","하고 싶은데 못 하겠어","그냥 연락 오기를 기다려","아예 먼저 연락 안 해"],"n":null},"M3-4.3.2":{"q":"먼저 연락하기 어려운 이유는?","o":["귀찮아할까 봐 걱정돼","거절당할까 봐 무서워","딱히 할 말이 없어","괜히 자존심이 상해"],"n":null},"M3-4.3.3":{"q":"단톡방이 조용하면 어떤 생각이 들어요?","o":["나만 빼고 얘기하나 싶어","다들 바빠서 그렇겠지 싶어","나도 끼기가 어려워","별로 신경 안 쓰려고 해"],"n":null},"M3-4.3.4":{"q":"기념일에 혼자면 어떤 마음이에요?","o":["너무 서운한 마음이 들어","이제는 익숙해졌어","나라도 나를 챙기려고 해","아무렇지 않은 척하게 돼"],"n":null},"M3-4.4.1":{"q":"방향을 찾기 위해 해본 게 있어요?","o":["그냥 고민만 하고 있어","이것저것 해본 적은 있어","상담이나 검사를 해봤어","아직 해본 게 없어"],"n":null},"M3-4.4.2":{"q":"나아지지 않을 것 같다고 느끼는 이유는?","o":["계속 그래왔으니까 그렇지","바꿀 힘이 내겐 없어","환경이 그대로라서 그래","내가 그대로라서 그래"],"n":null},"M3-4.4.3":{"q":"혼자일까 봐 두려울 때 어떻게 해요?","o":["그럴 땐 사람을 찾게 돼","그럴 땐 더 움츠러들어","그럴 땐 일에 몰두해","그냥 견디고 말아"],"n":null},"M3-4.4.4":{"q":"돈이나 일 중 뭐가 더 불안해요?","o":["돈이 더 불안한 것 같아","일이 더 불안한 것 같아","둘 다 불안한 것 같아","둘 다 아니고 내 마음이 문제야"],"n":null}}}