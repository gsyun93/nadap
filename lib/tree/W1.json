{"start":"W1-0","nodes":{"W1-0":{"q":"이런 생각, 언제부터 자주 들었어요?","o":["요즘 들어 부쩍 자주","몇 달째 계속 맴돌아","연차 쌓일수록 점점 더","입사 때부터 조금씩 있었어"],"n":["W1-1","W1-2","W1-3","W1-4"]},"W1-1":{"q":"최근에 이런 생각이 든 계기가 있었어요?","o":["주변에서 이직한 사람이 있었어","일이 갑자기 지루해졌거든","회사 분위기가 확 바뀌었어","딱히 계기는 없는 것 같아"],"n":["W1-1.1","W1-1.2","W1-1.3","W1-1.4"]},"W1-2":{"q":"몇 달 동안 이 생각을 행동으로 옮겨본 적 있어요?","o":["채용 공고만 계속 봤어","이력서를 한번 써봤어","누구한테 털어놔 봤어","아무것도 안 하고 있어"],"n":["W1-2.1","W1-2.2","W1-2.3","W1-2.4"]},"W1-3":{"q":"연차가 쌓이면서 뭐가 제일 달라졌어요?","o":["책임만 자꾸 늘어난 것 같아","예전의 설렘이 사라졌어","위아래 눈치 볼 일이 늘었어","옮기기가 점점 더 어려워졌어"],"n":["W1-3.1","W1-3.2","W1-3.3","W1-3.4"]},"W1-4":{"q":"입사할 때 이 회사를 고른 이유는 뭐였어요?","o":["조건이 괜찮아서 골랐어","빨리 취업하고 싶었거든","하고 싶던 일이었어","딱히 이유는 없었어"],"n":["W1-4.1","W1-4.2","W1-4.3","W1-4.4"]},"W1-1.1":{"q":"그 소식 듣고 어떤 마음이 들었어요?","o":["나만 제자리인 것 같았어","부러운데 겁도 났어","나도 나갈 수 있을까 싶었어","별생각 없었는데 계속 떠올라"],"n":["W1-1.1.1","W1-1.1.2","W1-1.1.3","W1-1.1.4"]},"W1-1.2":{"q":"지루하게 느껴지는 건 어떤 순간이에요?","o":["매일 같은 일만 할 때 그래","성과가 안 보일 때 지루해","할 일이 너무 없을 때 그래","회의만 계속될 때 지루해"],"n":["W1-1.2.1","W1-1.2.2","W1-1.2.3","W1-1.2.4"]},"W1-1.3":{"q":"어떤 변화가 제일 크게 느껴져요?","o":["윗사람이 바뀐 게 커","좋던 사람들이 나간 게 커","일하는 방식이 바뀐 게 커","회사 사정이 안 좋아진 게 커"],"n":["W1-1.3.1","W1-1.3.2","W1-1.3.3","W1-1.3.4"]},"W1-1.4":{"q":"그럼 요즘 일상은 어떤 편이에요?","o":["그냥 무난하게 흘러가고 있어","퇴근하면 지쳐서 뻗어버려","일 말고는 즐거운 게 없어","하루하루가 똑같이 흘러가"],"n":["W1-1.4.1","W1-1.4.2","W1-1.4.3","W1-1.4.4"]},"W1-2.1":{"q":"공고를 보면서 어떤 마음이 들었어요?","o":["갈 만한 데가 없어 보였어","괜찮은 곳은 조건이 높더라","지원할 용기가 안 나더라","보는 것만으로 위안이 됐어"],"n":["W1-2.1.1","W1-2.1.2","W1-2.1.3","W1-2.1.4"]},"W1-2.2":{"q":"이력서 쓰면서 제일 막혔던 건?","o":["내세울 성과가 없는 것 같아","경력이 짧아 보이는 게 걸려","내가 뭘 원하는지 모르겠어","자기소개 쓰는 게 어려워"],"n":["W1-2.2.1","W1-2.2.2","W1-2.2.3","W1-2.2.4"]},"W1-2.3":{"q":"털어놓은 사람은 뭐라고 했어요?","o":["그냥 버텨보라고 하더라","차라리 나가라고 하더라","잘 모르겠다고 하더라","내 편을 들어줬어"],"n":["W1-2.3.1","W1-2.3.2","W1-2.3.3","W1-2.3.4"]},"W1-2.4":{"q":"몇 달째 그대로인 이유는 뭐 같아요?","o":["너무 바빠서 못 했어","뭐부터 해야 할지 몰랐어","귀찮고 지쳐서 못 했어","아직은 견딜 만하거든"],"n":["W1-2.4.1","W1-2.4.2","W1-2.4.3","W1-2.4.4"]},"W1-3.1":{"q":"늘어난 책임 중 제일 무거운 건?","o":["후배 챙기는 게 제일 무거워","결과에 대한 압박이 커","윗사람 기대가 무겁게 느껴져","혼자 떠맡는 일이 너무 많아"],"n":["W1-3.1.1","W1-3.1.2","W1-3.1.3","W1-3.1.4"]},"W1-3.2":{"q":"처음엔 이 일의 어떤 점이 좋았어요?","o":["배우는 재미가 좋았어","같이 일하던 사람들이 좋았어","일 자체가 좋았던 것 같아","그냥 붙은 것만으로 좋았어"],"n":["W1-3.2.1","W1-3.2.2","W1-3.2.3","W1-3.2.4"]},"W1-3.3":{"q":"누구 눈치가 제일 많이 보여요?","o":["위에 있는 상사 눈치가 보여","아래 후배 눈치가 보여","같은 연차 동료 눈치가 보여","회사 전체 분위기가 눈치 보여"],"n":["W1-3.3.1","W1-3.3.2","W1-3.3.3","W1-3.3.4"]},"W1-3.4":{"q":"옮기기 어려워졌다고 느끼는 이유는?","o":["나이가 자꾸 마음에 걸려","연봉 맞추기가 어려울 것 같아","내 경력이 한쪽에만 쏠려 있어","다시 적응할 자신이 없어"],"n":["W1-3.4.1","W1-3.4.2","W1-3.4.3","W1-3.4.4"]},"W1-4.1":{"q":"그 조건, 지금도 만족스러워요?","o":["연봉은 아직 괜찮은 편이야","안정적인 건 확실히 좋아","생각보다는 별로였던 것 같아","조건 말고는 남는 게 없어"],"n":["W1-4.1.1","W1-4.1.2","W1-4.1.3","W1-4.1.4"]},"W1-4.2":{"q":"그때 급하게 결정한 게 아쉬워요?","o":["좀 더 찾아볼 걸 그랬어","그때는 그게 최선이었어","아쉽긴 한데 후회는 아니야","지금도 마음이 급한 것 같아"],"n":["W1-4.2.1","W1-4.2.2","W1-4.2.3","W1-4.2.4"]},"W1-4.3":{"q":"하고 싶던 일인데 왜 흔들릴까요?","o":["생각과 현실이 달랐던 것 같아","환경이 나랑 안 맞아","내가 잘하는지 모르겠어","다른 게 더 끌리는 것 같아"],"n":["W1-4.3.1","W1-4.3.2","W1-4.3.3","W1-4.3.4"]},"W1-4.4":{"q":"처음부터 이 일엔 마음이 없었던 걸까요?","o":["처음부터 마음이 없었던 것 같아","하다 보면 생길 줄 알았어","마음 둘 곳이 없었던 것 같아","아니야, 그런 건 아니야"],"n":["W1-4.4.1","W1-4.4.2","W1-4.4.3","W1-4.4.4"]},"W1-1.1.1":{"q":"제자리라고 느끼는 건 어떤 부분이에요?","o":["연봉이 계속 그대로인 것 같아","배우는 게 없다고 느껴져","직급이 안 올라서 답답해","하는 일이 매일 똑같아"],"n":null},"W1-1.1.2":{"q":"겁이 나는 건 뭐 때문이에요?","o":["새 곳에 적응 못할까 봐 겁나","지금보다 나빠질까 봐 걱정돼","내 실력이 부족할까 봐 무서워","다시 처음부터 해야 해서 겁나"],"n":null},"W1-1.1.3":{"q":"나간다면 어디로 가고 싶어요?","o":["같은 일로 더 좋은 회사 가고 싶어","아예 다른 직무로 가고 싶어","내 일을 한번 해보고 싶어","아직 잘 모르겠어"],"n":null},"W1-1.1.4":{"q":"그 생각이 주로 언제 떠올라요?","o":["출근길에 자꾸 떠올라","일하다 멍할 때 떠올라","자기 전에 문득 떠올라","월급날에 특히 떠올라"],"n":null},"W1-1.2.1":{"q":"같은 일이 반복될 때 제일 아쉬운 건?","o":["내가 크는 느낌이 없어서 아쉬워","시간이 아깝다는 생각이 들어","내 능력을 못 쓰는 것 같아","그냥 재미가 없어서 아쉬워"],"n":null},"W1-1.2.2":{"q":"성과가 안 보이면 어떤 기분이에요?","o":["내가 쓸모없나 싶어져","인정받고 싶은 마음이 커져","나도 모르게 대충 하게 돼","다른 데서 증명하고 싶어져"],"n":null},"W1-1.2.3":{"q":"일이 적을 때 그 시간엔 주로 뭐 해요?","o":["딴짓하면서 그냥 버텨","다른 일을 찾아보곤 해","그 시간에 공부를 해","그냥 눈치만 보고 있어"],"n":null},"W1-1.2.4":{"q":"회의가 많을 때 제일 힘든 건?","o":["정작 일할 시간이 없어서 힘들어","결론 없이 끝나서 힘들어","내 의견이 안 먹혀서 힘들어","그냥 기운이 쭉 빠져서 힘들어"],"n":null},"W1-1.3.1":{"q":"새 윗사람과는 어때요?","o":["스타일이 너무 달라서 힘들어","나를 잘 몰라주는 것 같아","아직은 적응하는 중이야","오히려 괜찮은 편인 것 같아"],"n":null},"W1-1.3.2":{"q":"그 사람들이 나간 뒤 어때요?","o":["마음 둘 데가 없어진 것 같아","일이 나한테 다 몰려와","나도 나가야 하나 싶어져","회사가 낯설게 느껴져"],"n":null},"W1-1.3.3":{"q":"바뀐 방식에서 제일 불편한 건?","o":["보고할 게 너무 많아서 불편해","자율이 줄어든 게 불편해","속도만 강조하는 게 불편해","기준이 자꾸 바뀌는 게 불편해"],"n":null},"W1-1.3.4":{"q":"회사 사정, 얼마나 걱정돼요?","o":["회사가 망할까 봐 불안해","월급이 밀릴까 봐 걱정돼","구조조정이 될까 봐 걱정돼","아직은 지켜보는 중이야"],"n":null},"W1-1.4.1":{"q":"무난한데도 이대로 괜찮은지 묻게 되는 이유는?","o":["이대로 늙을까 봐 걱정돼","더 잘할 수 있을 것 같아","남들은 앞서가는 것 같아","뭔가 빠진 느낌이 들어"],"n":null},"W1-1.4.2":{"q":"지친 건 일 때문일까요, 다른 이유도 있을까요?","o":["거의 일 때문인 것 같아","출퇴근이 너무 힘든 것 같아","사람 상대하는 게 피곤해","잘 모르겠어, 이유가 뭘까"],"n":null},"W1-1.4.3":{"q":"예전엔 뭘 할 때 즐거웠어요?","o":["운동이나 몸 쓸 때 즐거웠어","사람 만날 때 즐거웠어","뭔가 만들 때 즐거웠어","기억이 잘 안 나는 것 같아"],"n":null},"W1-1.4.4":{"q":"똑같은 하루에서 딱 하나 바꾼다면?","o":["하는 일 자체를 바꾸고 싶어","일하는 장소를 바꾸고 싶어","퇴근 후 시간을 바꾸고 싶어","만나는 사람들을 바꾸고 싶어"],"n":null},"W1-2.1.1":{"q":"갈 데가 없어 보인 이유는 뭐 같아요?","o":["내 경력이 애매해서 그런 것 같아","원하는 조건이 높아서 그래","업계가 좁아서 그런 것 같아","내가 제대로 안 찾아봐서 그래"],"n":null},"W1-2.1.2":{"q":"그 조건 중 제일 걸리는 건?","o":["경력 연수가 제일 걸려","자격증이나 학력이 걸려","특정 경험이 없어서 걸려","나이가 제일 걸리는 것 같아"],"n":null},"W1-2.1.3":{"q":"지원을 망설이게 하는 건 뭐예요?","o":["떨어질까 봐 망설여져","붙어도 고민될 것 같아서 그래","지금 회사에 미안한 마음이 들어","아직 준비가 덜 된 것 같아"],"n":null},"W1-2.1.4":{"q":"공고 보는 게 위안이 되는 이유는?","o":["나갈 수 있단 느낌이 들어서야","지금을 버티게 해주는 것 같아","비교해보면 여기도 괜찮아 보여","그냥 습관처럼 보게 됐어"],"n":null},"W1-2.2.1":{"q":"성과가 없다고 느끼는 이유는?","o":["숫자로 보여줄 게 없는 것 같아","내가 한 일이 아닌 것 같아","평범한 일만 해온 것 같아","정리를 안 해놔서 기억 안 나"],"n":null},"W1-2.2.2":{"q":"경력이 짧아 보이는 이유가 뭐예요?","o":["이직이 잦았던 게 걸려","한 곳에 너무 짧게 있었어","중간에 공백이 있어서 걸려","연차에 비해 경험이 적은 것 같아"],"n":null},"W1-2.2.3":{"q":"원하는 게 흐릿한 건 왜일까요?","o":["다 비슷비슷해 보여서 그래","해본 게 별로 없어서 그래","이것저것 다 끌려서 그래","생각할 여유가 없었던 것 같아"],"n":null},"W1-2.2.4":{"q":"나를 소개하기 어려운 건 왜예요?","o":["내 장점이 뭔지 모르겠어","쓰고 나면 다 거짓말 같아","자랑하는 게 너무 어색해","남과 다른 게 없는 것 같아"],"n":null},"W1-2.3.1":{"q":"버티라는 말에 어떤 마음이 들었어요?","o":["듣고 보니 맞는 말 같아","내 마음을 몰라주는 것 같아","오히려 더 답답해졌어","조금은 안심이 됐어"],"n":null},"W1-2.3.2":{"q":"나가라는 말에 어떤 마음이 들었어요?","o":["듣고 나니 용기가 생겼어","너무 쉽게 말하는 것 같았어","오히려 겁이 나더라","고민이 더 커져버렸어"],"n":null},"W1-2.3.3":{"q":"결국 누구 말을 제일 듣고 싶어요?","o":["가족 말이 제일 듣고 싶어","친한 친구 말이 듣고 싶어","같은 업계 선배 말이 듣고 싶어","결국 내 마음을 듣고 싶어"],"n":null},"W1-2.3.4":{"q":"편을 들어줬는데도 고민이 남는 건?","o":["현실이 바뀌진 않으니까 그래","결정은 결국 내 몫이라서 그래","위로만으로는 부족한 것 같아","나도 내 마음을 모르겠어"],"n":null},"W1-2.4.1":{"q":"바빠도 하루에 생각할 틈은 있어요?","o":["생각할 틈이 거의 없어","자기 전에 잠깐 생각하긴 해","주말엔 생각할 시간이 있어","시간은 있는데 쉬고 싶어"],"n":null},"W1-2.4.2":{"q":"제일 먼저 알고 싶은 건 뭐예요?","o":["내가 뭘 잘하는지 알고 싶어","내가 갈 수 있는 곳이 궁금해","지금 내 시장 가치가 궁금해","내가 뭘 원하는지 알고 싶어"],"n":null},"W1-2.4.3":{"q":"지친 건 언제부터였어요?","o":["올해 들어서 지친 것 같아","벌써 몇 년째 지쳐 있어","이 회사 오고부터 그런 것 같아","원래 늘 그랬던 것 같아"],"n":null},"W1-2.4.4":{"q":"견딜 만하다가 못 견딜 순간은 언제일까요?","o":["몸이 아프면 못 견딜 것 같아","사람과 크게 부딪히면 힘들 것 같아","돈이 안 모이면 못 견딜 것 같아","그게 언제일지 잘 모르겠어"],"n":null},"W1-3.1.1":{"q":"후배를 챙기면서 힘든 건?","o":["내 일할 시간이 없어져서 힘들어","후배가 잘 안 따라와서 힘들어","가르치는 게 나랑 안 맞아","해도 돌아오는 대가가 없어"],"n":null},"W1-3.1.2":{"q":"압박을 느낄 때 주로 어떻게 해요?","o":["혼자 끙끙 앓는 편이야","밤늦게까지 붙잡고 일해","나도 모르게 대충 넘기게 돼","누구한테 털어놓곤 해"],"n":null},"W1-3.1.3":{"q":"그 기대가 부담스러운 이유는?","o":["실망시킬까 봐 부담돼","내 능력보다 기대가 커서 부담돼","보상이 없어서 부담스러워","원하지 않는 방향이라 부담돼"],"n":null},"W1-3.1.4":{"q":"일을 떠맡게 되는 이유는?","o":["내가 거절을 잘 못 해서 그래","할 사람이 없어서 그런 것 같아","내가 하는 게 더 빨라서 그래","회사 구조가 원래 그런 것 같아"],"n":null},"W1-3.2.1":{"q":"지금은 더 배울 게 없다고 느껴요?","o":["이제 거의 다 아는 것 같아","배울 건 있는데 기회가 없어","배우고 싶은 건 다른 분야야","이제 배울 의욕이 없어"],"n":null},"W1-3.2.2":{"q":"그 사람들은 지금 어때요?","o":["많이들 떠나버렸어","남았는데 사이가 변했어","다들 지쳐 보이더라","여전히 다들 좋아"],"n":null},"W1-3.2.3":{"q":"일 자체는 지금도 좋아요?","o":["일은 좋은데 환경이 문제야","좋았는데 이제 질렸어","예전만큼은 아닌 것 같아","원래 좋은 척한 것 같아"],"n":null},"W1-3.2.4":{"q":"그럼 이 일을 계속하는 이유는?","o":["그냥 돈 때문에 하고 있어","딱히 다른 게 없어서 해","그냥 익숙해서 계속하고 있어","경력을 쌓으려고 하는 거야"],"n":null},"W1-3.3.1":{"q":"상사 눈치를 볼 때 제일 신경 쓰이는 건?","o":["내 평가가 제일 신경 쓰여","말투나 기분이 신경 쓰여","내 실수가 제일 신경 쓰여","야근이나 근태가 신경 쓰여"],"n":null},"W1-3.3.2":{"q":"후배 눈치가 보이는 이유는?","o":["꼰대 될까 봐 눈치가 보여","나보다 잘해서 눈치가 보여","내가 본보기가 못 되는 것 같아","일 시키기가 미안해서 눈치 봐"],"n":null},"W1-3.3.3":{"q":"동료랑은 어떤 신경전이 있어요?","o":["승진 경쟁 때문에 신경전이 있어","일 분배 때문에 신경전이 있어","비교당하는 게 신경 쓰여","말없이 서로 피하게 돼"],"n":null},"W1-3.3.4":{"q":"회사 분위기가 어떻길래요?","o":["다들 몸을 사리는 분위기야","말 한마디도 조심스러워","성과 압박이 너무 커","누가 나갈지 수군거려"],"n":null},"W1-3.4.1":{"q":"나이가 걸리는 건 어떤 부분에서요?","o":["신입처럼 새로 시작을 못 해","나를 뽑아줄까 싶어","가족들이 걱정을 많이 해","체력이 예전 같지 않아"],"n":null},"W1-3.4.2":{"q":"연봉을 낮춰서라도 옮길 생각 있어요?","o":["조금 낮춰도 괜찮을 것 같아","연봉 낮추는 건 절대 안 돼","하고 싶은 일이면 가능해","잘 모르겠어, 고민돼"],"n":null},"W1-3.4.3":{"q":"다른 분야로 간다면 어디로?","o":["지금 일과 비슷한 쪽으로 갈래","완전히 다른 쪽으로 가보고 싶어","배우던 걸 살리는 쪽이 좋아","생각해본 적이 없는 것 같아"],"n":null},"W1-3.4.4":{"q":"적응이 두려운 건 어떤 부분이에요?","o":["새로운 사람들이 제일 두려워","새 업무가 제일 두려워","처음부터 인정받아야 하는 게 겁나","실패할까 봐 제일 두려워"],"n":null},"W1-4.1.1":{"q":"연봉 말고 아쉬운 건 뭐예요?","o":["성장이 안 되는 게 아쉬워","사람들이 아쉬운 것 같아","일의 의미가 아쉬워","워라밸이 아쉬운 것 같아"],"n":null},"W1-4.1.2":{"q":"안정감을 놓기 어려운 이유는?","o":["생활비가 걸려서 놓기 어려워","가족이 있어서 못 놓겠어","불안한 건 정말 싫어","다시 구하기 힘들까 봐 걱정돼"],"n":null},"W1-4.1.3":{"q":"생각과 달랐던 건 어떤 점이에요?","o":["하는 일이 생각이랑 달랐어","회사 문화가 생각이랑 달랐어","성장 기회가 생각보다 적어","실제 대우가 생각이랑 달랐어"],"n":null},"W1-4.1.4":{"q":"조건 말고 원하는 게 생겼어요?","o":["재미있는 일을 하고 싶어졌어","인정받는 느낌을 원하게 됐어","좋은 사람들과 일하고 싶어","내 시간이 갖고 싶어졌어"],"n":null},"W1-4.2.1":{"q":"그때 더 찾았다면 뭘 봤을 것 같아요?","o":["하고 싶은 일을 찾았을 것 같아","더 큰 회사를 봤을 것 같아","더 좋은 사람들을 만났을 것 같아","뭘 봤을지 잘 모르겠어"],"n":null},"W1-4.2.2":{"q":"그 선택을 지금 다시 본다면?","o":["그래도 잘 버텨왔다고 생각해","이젠 다음으로 갈 때인 것 같아","그래도 아쉬운 마음은 있어","다시 해도 같은 선택일 거야"],"n":null},"W1-4.2.3":{"q":"아쉬움이 커지는 순간은 언제예요?","o":["친구 소식 들을 때 아쉬워져","일이 힘들 때 아쉬워져","월급날에 특히 아쉬워","혼자 있을 때 아쉬움이 커져"],"n":null},"W1-4.2.4":{"q":"지금 급한 건 뭐 때문이에요?","o":["나이 때문에 마음이 급해","돈 때문에 마음이 급해","주변 시선 때문에 급해","지쳐서 마음이 급해진 것 같아"],"n":null},"W1-4.3.1":{"q":"생각과 가장 다른 부분은?","o":["일의 내용이 생각과 달라","보상이 생각과 달라","인정받는 게 생각과 달라","일의 속도가 생각과 달라"],"n":null},"W1-4.3.2":{"q":"안 맞는 환경은 어떤 거예요?","o":["사람들이 나랑 안 맞아","조직 문화가 나랑 안 맞아","업무 방식이 나랑 안 맞아","회사 규모가 나랑 안 맞아"],"n":null},"W1-4.3.3":{"q":"잘하는지 모르겠다는 생각은 왜 들어요?","o":["피드백이 없어서 모르겠어","남이 더 잘해 보여서 그래","결과가 안 나와서 그래","스스로 만족이 안 돼서 그래"],"n":null},"W1-4.3.4":{"q":"더 끌리는 건 어떤 거예요?","o":["비슷한 다른 일이 끌려","완전 다른 분야가 끌려","내 사업을 해보고 싶어","아직은 막연하게 끌리는 정도야"],"n":null},"W1-4.4.1":{"q":"마음이 없는데도 지금까지 온 이유는?","o":["그냥 흘러서 여기까지 왔어","그만둘 이유가 딱히 없었어","돈 때문에 계속 다녔어","다른 걸 몰라서 계속했어"],"n":null},"W1-4.4.2":{"q":"정이 들지 않은 이유는 뭐 같아요?","o":["일이 나랑 안 맞는 것 같아","회사에 애정이 안 생겼어","성과가 없어서 정이 안 든 것 같아","시간이 부족했던 것 같아"],"n":null},"W1-4.4.3":{"q":"마음 둘 곳이 있다면 어떤 곳이었으면?","o":["인정받는 곳이면 좋겠어","편한 사람들이 있는 곳이면 좋겠어","성장하는 곳이면 좋겠어","내가 주인인 곳이면 좋겠어"],"n":null},"W1-4.4.4":{"q":"그럼 지금 제일 큰 고민은 뭐예요?","o":["계속 다닐지가 제일 고민이야","언제 나갈지가 제일 고민이야","뭘 할지가 제일 고민이야","그냥 다 막막한 느낌이야"],"n":null}}}