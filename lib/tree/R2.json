{"start":"R2-0","nodes":{"R2-0":{"q":"이 생각, 언제부터 들기 시작했어요?","o":["최근에 크게 다툰 뒤로","몇 달 전부터 조금씩","처음부터 뭔가 걸렸어","다른 사람이 신경 쓰이면서"],"n":["R2-1","R2-2","R2-3","R2-4"]},"R2-1":{"q":"무엇 때문에 크게 다퉜어요?","o":["연락이나 약속 때문에 다퉜어","서로 말투나 태도가 문제였어","돈이랑 미래 문제로 싸웠어","다른 사람 때문에 다퉜어"],"n":["R2-1.1","R2-1.2","R2-1.3","R2-1.4"]},"R2-2":{"q":"몇 달 동안 뭐가 조금씩 달라졌어요?","o":["예전만큼 설레지가 않아","둘이 대화가 많이 줄었어","요즘 자꾸 부딪히게 돼","혼자 있고 싶을 때가 많아"],"n":["R2-2.1","R2-2.2","R2-2.3","R2-2.4"]},"R2-3":{"q":"처음부터 걸렸던 건 뭐였어요?","o":["성격이 잘 안 맞았어","가치관이 좀 달랐어","조건이나 환경이 걸렸어","내 마음이 확실치 않았어"],"n":["R2-3.1","R2-3.2","R2-3.3","R2-3.4"]},"R2-4":{"q":"다른 사람이 신경 쓰인다는 건 누구예요?","o":["새로 마음 가는 사람이 있어","그 사람 곁의 이성이 걸려","예전 연인이 신경 쓰여","주변 시선이 자꾸 신경 쓰여"],"n":["R2-4.1","R2-4.2","R2-4.3","R2-4.4"]},"R2-1.1":{"q":"연락이나 약속, 어떤 게 문제였어요?","o":["연락이 너무 뜸해서 힘들어","약속을 자꾸 어겨서 속상해","나만 맞추는 것 같아","서로 기대하는 게 달라"],"n":["R2-1.1.1","R2-1.1.2","R2-1.1.3","R2-1.1.4"]},"R2-1.2":{"q":"말투나 태도에서 뭐가 상처였어요?","o":["무시하는 말투가 상처였어","화를 크게 내서 놀랐어","대화를 피해서 서운했어","비꼬는 말이 아팠어"],"n":["R2-1.2.1","R2-1.2.2","R2-1.2.3","R2-1.2.4"]},"R2-1.3":{"q":"돈이나 미래 문제, 어떤 차이가 있어요?","o":["돈 쓰는 방식이 서로 달라","결혼 생각이 서로 달라","사는 곳이나 계획이 달라","한쪽만 준비하는 느낌이야"],"n":["R2-1.3.1","R2-1.3.2","R2-1.3.3","R2-1.3.4"]},"R2-1.4":{"q":"다른 사람 때문에 어떤 일이 있었어요?","o":["이성 친구 문제가 있었어","가족 문제가 얽혀 있었어","친구들과의 관계가 문제야","예전 연인 문제가 있었어"],"n":["R2-1.4.1","R2-1.4.2","R2-1.4.3","R2-1.4.4"]},"R2-2.1":{"q":"설렘이 줄어든 지금은 어떤 감정이에요?","o":["지금은 편안한 정이 커","그냥 습관처럼 만나는 것 같아","의무감으로 만나는 것 같아","내 감정을 잘 모르겠어"],"n":["R2-2.1.1","R2-2.1.2","R2-2.1.3","R2-2.1.4"]},"R2-2.2":{"q":"대화가 줄어든 이유는 뭐 같아요?","o":["둘 다 너무 바빠서 그래","딱히 할 말이 없는 것 같아","얘기만 하면 싸우게 돼서야","서로 관심이 줄어든 것 같아"],"n":["R2-2.2.1","R2-2.2.2","R2-2.2.3","R2-2.2.4"]},"R2-2.3":{"q":"부딪히는 건 주로 어떤 일이에요?","o":["사소한 습관 때문에 부딪혀","연락 문제로 자주 부딪혀","서로 서운한 게 쌓여서 그래","말투 때문에 자꾸 싸워"],"n":["R2-2.3.1","R2-2.3.2","R2-2.3.3","R2-2.3.4"]},"R2-2.4":{"q":"혼자 있고 싶어지는 이유는?","o":["만나면 너무 피곤해","내 시간이 좀 필요해","마음이 식은 것 같아","다른 고민이 너무 많아서야"],"n":["R2-2.4.1","R2-2.4.2","R2-2.4.3","R2-2.4.4"]},"R2-3.1":{"q":"성격 중 어떤 부분이 안 맞아요?","o":["감정 표현 방식이 서로 달라","생활 습관이 잘 안 맞아","사교성이 많이 달라","문제 푸는 방식이 달라"],"n":["R2-3.1.1","R2-3.1.2","R2-3.1.3","R2-3.1.4"]},"R2-3.2":{"q":"가치관 중 어떤 게 제일 달라요?","o":["돈에 대한 생각이 달라","가족에 대한 생각이 달라","일과 삶의 균형이 달라","결혼이나 미래 생각이 달라"],"n":["R2-3.2.1","R2-3.2.2","R2-3.2.3","R2-3.2.4"]},"R2-3.3":{"q":"어떤 조건이나 환경이 걸려요?","o":["거리가 멀어서 걸려","나이 차이가 신경 쓰여","경제적 차이가 걸려","집안의 반대가 걸려"],"n":["R2-3.3.1","R2-3.3.2","R2-3.3.3","R2-3.3.4"]},"R2-3.4":{"q":"처음 내 마음은 어땠어요?","o":["외로워서 시작했던 것 같아","상대가 적극적이라 시작했어","좋긴 한데 확신은 없었어","주변 권유로 만나게 됐어"],"n":["R2-3.4.1","R2-3.4.2","R2-3.4.3","R2-3.4.4"]},"R2-4.1":{"q":"새로 마음 가는 사람이 생긴 거예요?","o":["응, 그 사람한테 좀 끌려","그냥 자꾸 비교가 돼","내 마음이 확실하진 않아","그 사람도 날 좋아하는 것 같아"],"n":["R2-4.1.1","R2-4.1.2","R2-4.1.3","R2-4.1.4"]},"R2-4.2":{"q":"연인 곁의 이성이 신경 쓰이는 이유는?","o":["둘이 너무 친해 보여","둘이 연락이 너무 잦아","나한테 뭔가 숨기는 것 같아","내가 불안한 것 같아"],"n":["R2-4.2.1","R2-4.2.2","R2-4.2.3","R2-4.2.4"]},"R2-4.3":{"q":"예전 연인이 왜 신경 쓰여요?","o":["아직도 그 사람이 생각나","예전 연인한테 연락이 왔어","지금 연인이랑 자꾸 비교돼","그 사람 소식이 자꾸 들려"],"n":["R2-4.3.1","R2-4.3.2","R2-4.3.3","R2-4.3.4"]},"R2-4.4":{"q":"어떤 시선이 신경 쓰여요?","o":["가족 시선이 신경 쓰여","친구들 시선이 신경 쓰여","회사나 주변 사람이 신경 쓰여","사회적인 기준이 신경 쓰여"],"n":["R2-4.4.1","R2-4.4.2","R2-4.4.3","R2-4.4.4"]},"R2-1.1.1":{"q":"뜸한 연락에서 제일 서운한 건?","o":["나를 안 궁금해하는 게 서운해","하루 종일 소식이 없어서 서운해","내가 먼저 해야 해서 서운해","이유도 말 안 해줘서 서운해"],"n":null},"R2-1.1.2":{"q":"약속을 어길 때 나는 어떻게 했어요?","o":["그냥 참고 넘어갔어","서운하다고 얘기했어","크게 화를 내버렸어","나도 신경 끄려고 했어"],"n":null},"R2-1.1.3":{"q":"나만 맞춘다고 느끼는 부분은?","o":["시간을 늘 내가 맞춰줘","장소도 내가 맞추는 편이야","연락 방식도 내가 맞춰","감정 표현도 내가 맞춰줘"],"n":null},"R2-1.1.4":{"q":"서로 기대가 다르다는 걸 언제 느꼈어요?","o":["싸울 때마다 느꼈던 것 같아","대화해보니까 알게 됐어","그 사람 행동을 보고 느꼈어","이번에 처음으로 느꼈어"],"n":null},"R2-1.2.1":{"q":"무시당한다고 느낄 때 어떤 마음이에요?","o":["내가 자꾸 작아지는 기분이야","화가 나서 참기 힘들어","정이 점점 떨어지는 것 같아","그냥 마음이 너무 슬퍼"],"n":null},"R2-1.2.2":{"q":"화를 크게 낼 때 나는 어떻게 해요?","o":["무서워서 일단 피하게 돼","나도 같이 화내게 돼","일단은 꾹 참고 있어","나중에 따로 얘기하려고 해"],"n":null},"R2-1.2.3":{"q":"대화를 피하면 어떻게 돼요?","o":["문제가 그대로 남아 있어","나만 애가 타는 것 같아","나도 지쳐서 포기하게 돼","시간이 지나면 풀리기도 해"],"n":null},"R2-1.2.4":{"q":"비꼬는 말을 들으면 어때요?","o":["그 말이 오래 마음에 남아","나도 똑같이 받아치게 돼","내가 잘못했나 싶기도 해","이제는 그냥 익숙해졌어"],"n":null},"R2-1.3.1":{"q":"돈 쓰는 방식이 어떻게 달라요?","o":["한쪽이 너무 아끼는 편이야","한쪽이 너무 쓰는 편이야","데이트 비용이 부담돼","돈 얘기를 자꾸 피하게 돼"],"n":null},"R2-1.3.2":{"q":"결혼 생각이 어떻게 달라요?","o":["나는 결혼하고 싶어","그 사람은 결혼하고 싶어 해","결혼하고 싶은 시기가 달라","둘 다 아직 모르겠어"],"n":null},"R2-1.3.3":{"q":"계획이 다르면 어떻게 될 것 같아요?","o":["결국 헤어질 것 같아","맞춰갈 수 있을 것 같아","내가 포기해야 하나 싶어","어떻게 될지 모르겠어"],"n":null},"R2-1.3.4":{"q":"한쪽만 준비하는 게 왜 힘들어요?","o":["나만 진지한 것 같아서 힘들어","혼자 짊어지는 느낌이 들어","미래가 잘 안 보여서 답답해","그냥 너무 부담돼"],"n":null},"R2-1.4.1":{"q":"이성 친구 문제에서 뭐가 걸려요?","o":["둘이 연락이 너무 잦아","나보다 그 친구를 우선해","나한테 숨기는 게 있어","내가 예민한 건가 싶어"],"n":null},"R2-1.4.2":{"q":"가족 문제는 어떤 거예요?","o":["상대 가족이 날 안 좋아해","내 가족이 반대하고 있어","가족 일에 너무 끌려가","가족 얘기로 자주 싸워"],"n":null},"R2-1.4.3":{"q":"친구들과는 어떤 게 문제예요?","o":["나보다 친구를 더 챙겨","내 친구들을 싫어하는 것 같아","모임에 날 안 불러","내 말보다 친구 말을 믿어"],"n":null},"R2-1.4.4":{"q":"예전 연인 문제는 어떤 거예요?","o":["아직도 연락하고 있는 것 같아","자꾸 나랑 비교하는 것 같아","아직 못 잊은 것 같아","내가 자꾸 신경 쓰여"],"n":null},"R2-2.1.1":{"q":"편안함도 사랑이라고 생각해요?","o":["응, 편안한 게 진짜 같아","그래도 설렘은 필요한 것 같아","반반인 것 같아","솔직히 잘 모르겠어"],"n":null},"R2-2.1.2":{"q":"습관처럼 만나는 게 느껴질 때는?","o":["만나도 할 말이 없어","맨날 같은 데이트만 해","연락이 의무처럼 느껴져","혼자가 더 편한 것 같아"],"n":null},"R2-2.1.3":{"q":"의무감이 드는 이유는?","o":["너무 오래 만나서 그런 것 같아","헤어지면 미안할 것 같아서야","주변 기대 때문인 것 같아","혼자가 될까 봐 무서워서야"],"n":null},"R2-2.1.4":{"q":"설렘을 다시 느낀다면 뭘 해보고 싶어요?","o":["새로운 데이트를 해보고 싶어","같이 여행을 가보고 싶어","솔직하게 대화해보고 싶어","굳이 안 해도 될 것 같아"],"n":null},"R2-2.2.1":{"q":"바빠도 꼭 나누고 싶은 대화는?","o":["하루 일상은 꼭 나누고 싶어","고민은 꼭 나누고 싶어","미래 얘기는 꼭 하고 싶어","서로 감정은 꼭 나누고 싶어"],"n":null},"R2-2.2.2":{"q":"할 말이 없어진 건 누구 쪽이에요?","o":["내가 할 말이 없어진 것 같아","그 사람이 할 말이 없는 것 같아","둘 다 그런 것 같아","누가 먼저인지 잘 모르겠어"],"n":null},"R2-2.2.3":{"q":"싸움이 될까 봐 피하는 얘기는?","o":["서운한 점은 말하기 겁나","미래 계획 얘기는 피하게 돼","돈 얘기는 늘 싸움이 돼","가족 얘기는 꺼내기 어려워"],"n":null},"R2-2.2.4":{"q":"관심이 줄었다고 느낀 순간은?","o":["내 얘기를 잘 안 들어줘","나한테 궁금한 게 없어 보여","만나면 폰만 보고 있어","만나도 딴생각을 하는 것 같아"],"n":null},"R2-2.3.1":{"q":"사소한 습관이 왜 크게 느껴져요?","o":["쌓이다 보니 결국 터져","말해도 안 고쳐서 힘들어","존중받지 못하는 느낌이야","원래 내가 좀 예민한 편이야"],"n":null},"R2-2.3.2":{"q":"연락 문제로 또 부딪히면 어떤 생각이 들어요?","o":["이것도 못 맞추나 싶어","나만 원하는 건가 싶어","그냥 너무 지쳐","이번엔 내가 맞춰볼까 싶어"],"n":null},"R2-2.3.3":{"q":"서운함을 말하면 그 사람 반응은?","o":["미안하다고 먼저 말해줘","오히려 나한테 화를 내","그냥 대충 넘어가려 해","자기도 서운하다고 말해"],"n":null},"R2-2.3.4":{"q":"말투 때문에 싸우면 어떻게 끝나요?","o":["내가 먼저 사과하고 끝나","그 사람이 먼저 사과해","그냥 흐지부지 끝나버려","며칠 동안 냉전이 이어져"],"n":null},"R2-2.4.1":{"q":"만남이 피곤한 건 어떤 부분이에요?","o":["맞춰주는 게 너무 힘들어","감정 소모가 너무 커","체력이 따라주질 않아","대화가 좀 지루해"],"n":null},"R2-2.4.2":{"q":"내 시간이 생기면 뭘 하고 싶어요?","o":["그냥 푹 쉬고 싶어","취미 생활을 하고 싶어","친구들을 만나고 싶어","내 미래를 준비하고 싶어"],"n":null},"R2-2.4.3":{"q":"마음이 식었다고 느끼는 신호는?","o":["요즘은 얼굴 보고 싶단 생각이 안 들어","연락 오면 반갑기보다 그냥 그래","스킨십이 하려 하면 자꾸 불편해져","이 사람과의 미래가 도무지 안 그려져"],"n":null},"R2-2.4.4":{"q":"다른 고민이 연애에 영향을 주고 있어요?","o":["일 때문에 여유가 없어","돈 걱정 때문에 힘들어","내 문제로 너무 지쳤어","영향이 있는지 잘 모르겠어"],"n":null},"R2-3.1.1":{"q":"감정 표현이 어떻게 달라요?","o":["한쪽은 감정을 다 말해","한쪽은 감정을 숨기는 편이야","둘 다 표현이 서툴러","원하는 표현의 양이 달라"],"n":null},"R2-3.1.2":{"q":"생활 습관 중 제일 부딪히는 건?","o":["시간 약속에서 제일 부딪혀","청결이나 정리에서 부딪혀","소비 습관에서 제일 부딪혀","잠자는 시간이 안 맞아"],"n":null},"R2-3.1.3":{"q":"사교성 차이가 어떤 문제를 만들어요?","o":["만나는 사람 수가 서로 달라","모임 참석 정도가 서로 달라","혼자 있는 시간이 서로 달라","친구 관계 방식이 서로 달라"],"n":null},"R2-3.1.4":{"q":"문제가 생기면 각자 어떻게 해요?","o":["한쪽은 바로 풀고 싶어 해","한쪽은 시간이 필요하대","서로 문제를 피하게 돼","결국 내가 다 맞추게 돼"],"n":null},"R2-3.2.1":{"q":"돈 생각이 다르면 뭐가 힘들어요?","o":["돈 쓸 때마다 눈치가 보여","미래 계획이 서로 안 맞아","존중받지 못하는 느낌이야","결국 늘 싸움이 돼버려"],"n":null},"R2-3.2.2":{"q":"가족 생각이 어떻게 달라요?","o":["가족 우선순위가 서로 달라","가족과의 거리감이 서로 달라","가족에 대한 책임감이 달라","명절이나 행사 생각이 달라"],"n":null},"R2-3.2.3":{"q":"일과 삶의 균형은 어떻게 달라요?","o":["한쪽은 일이 먼저인 사람이야","한쪽은 여유가 더 중요해","쉬는 방식이 서로 달라","만날 시간이 잘 안 맞아"],"n":null},"R2-3.2.4":{"q":"미래 생각이 다른데도 만나는 이유는?","o":["언젠가 바뀔 거라 믿고 있어","지금이 좋아서 만나는 거야","헤어지는 게 너무 어려워","아직 결정을 못 하겠어"],"n":null},"R2-3.3.1":{"q":"거리 때문에 힘든 건?","o":["자주 못 만나서 힘들어","연락에만 기대게 돼서 힘들어","비용과 시간이 많이 들어","미래가 잘 안 그려져"],"n":null},"R2-3.3.2":{"q":"나이 차이가 걸리는 부분은?","o":["대화나 관심사가 안 맞아","결혼 시기가 걸려","주변 시선이 신경 쓰여","체력이나 생활 패턴이 달라"],"n":null},"R2-3.3.3":{"q":"경제적 차이가 어떻게 느껴져요?","o":["내가 자꾸 작아지는 것 같아","데이트 비용을 늘 내가 내","앞으로가 좀 불안해","생각보다 괜찮은 것 같아"],"n":null},"R2-3.3.4":{"q":"반대를 이길 자신이 있어요?","o":["응, 이겨낼 자신 있어","솔직히 잘 모르겠어","점점 지쳐가고 있어","그 사람이 버텨줄지 모르겠어"],"n":null},"R2-3.4.1":{"q":"지금은 외로움 말고 다른 마음도 있어요?","o":["지금은 정이 많이 들었어","아직도 외로움이 커","헤어지면 더 외로울까 봐 겁나","내 마음을 잘 모르겠어"],"n":null},"R2-3.4.2":{"q":"적극적인 그 사람에게 끌려간 느낌이에요?","o":["조금은 끌려간 것 같아","그래도 내가 원해서 만났어","거절을 못 해서 만난 것 같아","지금은 내가 더 좋아해"],"n":null},"R2-3.4.3":{"q":"확신이 없던 마음은 지금 어때요?","o":["확신은 여전히 없어","확신이 조금 생긴 것 같아","오히려 확신이 더 줄었어","내 마음을 모르겠어"],"n":null},"R2-3.4.4":{"q":"주변 권유로 시작한 게 마음에 걸려요?","o":["내 선택 같지가 않아","그래도 괜찮았던 것 같아","주변 눈치 때문에 못 헤어져","그런 건 상관없는 것 같아"],"n":null},"R2-4.1.1":{"q":"그 사람의 어떤 점이 끌려요?","o":["지금 연인에게 없는 게 있어","대화가 잘 통해서 끌려","그 사람은 새로운 느낌이야","나를 알아주는 게 좋아"],"n":null},"R2-4.1.2":{"q":"비교하게 되는 부분은?","o":["나를 대하는 태도가 비교돼","대화하는 게 자꾸 비교돼","외모나 분위기가 비교돼","미래 가능성이 비교돼"],"n":null},"R2-4.1.3":{"q":"확실하지 않은 마음, 어떻게 하고 싶어요?","o":["일단 거리를 두고 싶어","좀 더 지켜보고 싶어","지금 연애부터 정리하고 싶어","어떻게 하고 싶은지 모르겠어"],"n":null},"R2-4.1.4":{"q":"그 사람 마음까지 느껴지면 어떤 기분이에요?","o":["솔직히 좀 설레","죄책감이 들어서 불편해","마음이 너무 혼란스러워","이러다 어떻게 될지 무서워"],"n":null},"R2-4.2.1":{"q":"친해 보이는 모습 중 제일 걸리는 건?","o":["둘만 아는 얘기가 제일 걸려","스킨십하는 모습이 제일 신경 쓰여","만나는 횟수가 너무 잦은 것 같아","그 사람 태도가 제일 마음에 걸려"],"n":null},"R2-4.2.2":{"q":"잦은 연락을 알게 된 뒤 어떻게 했어요?","o":["그냥 바로 물어봤어","모르는 척 넘어갔어","순간 화가 나서 화냈어","말 못 하고 혼자 끙끙댔어"],"n":null},"R2-4.2.3":{"q":"숨긴다고 느끼는 이유는?","o":["폰을 자꾸 숨기는 것 같아","하는 말이 자꾸 바뀌어","만난 걸 말 안 해줘","그냥 그런 느낌이 들어"],"n":null},"R2-4.2.4":{"q":"불안이 내 문제일까 봐 걱정돼요?","o":["응, 예전부터 내가 그랬어","아니, 상대 때문인 것 같아","반반인 것 같아, 둘 다야","잘 모르겠어, 헷갈려"],"n":null},"R2-4.3.1":{"q":"생각나는 건 그 사람이에요, 그때예요?","o":["그 사람 자체가 생각나","그때의 내가 생각나는 것 같아","그때의 설렘이 그리운 것 같아","뭐가 생각나는지 모르겠어"],"n":null},"R2-4.3.2":{"q":"연락이 와서 어떻게 했어요?","o":["나도 모르게 답장했어","그냥 읽고 무시했어","답장할지 아직 고민 중이야","지금 연인한테 다 말했어"],"n":null},"R2-4.3.3":{"q":"비교할 때 어떤 차이가 느껴져요?","o":["예전이 더 잘 맞았던 것 같아","지금이 더 안정적인 것 같아","둘 다 아쉬운 점이 있어","비교하는 내가 싫어져"],"n":null},"R2-4.3.4":{"q":"소식을 듣고 어떤 마음이었어요?","o":["마음이 좀 흔들렸어","잘 지낸다니 다행이다 싶었어","솔직히 좀 질투 났어","별 감정이 안 들었어"],"n":null},"R2-4.4.1":{"q":"가족은 뭐라고 해요?","o":["가족은 우리 사이를 반대해","가족이 결혼을 재촉해","가족은 별말이 없어","가족이 나를 많이 걱정해"],"n":null},"R2-4.4.2":{"q":"친구들 반응은 어때요?","o":["친구들은 헤어지라고 해","친구들은 잘 어울린대","친구들은 신경 안 써","친구들은 말을 아끼는 편이야"],"n":null},"R2-4.4.3":{"q":"주변 사람들 시선이 어떻게 느껴져요?","o":["뒤에서 수군거리는 것 같아","다들 우리를 부러워하는 것 같아","자꾸 남들이랑 비교당하는 것 같아","그냥 괜히 의식이 돼"],"n":null},"R2-4.4.4":{"q":"어떤 기준에 맞춰야 한다고 느껴요?","o":["나이에 맞춰야 할 것 같아","결혼 시기에 맞춰야 할 것 같아","조건을 맞춰야 할 것 같아","남들 보기 좋은 연애여야 할 것 같아"],"n":null}}}