","R4-2.4.3","R4-2.4.4"]},"R4-3.1":{"q":"남아 있는 마음은 어떤 마음이에요?","o":["나 아직 그 사람 좋아해","그냥 미련이 남아 있는 거야","그 사람한테 고마운 마음이야","미안한 마음이 남아 있어"],"n":["R4-3.1.1","R4-3.1.2","R4-3.1.3","R4-3.1.4"]},"R4-3.2":{"q":"그만한 사람이 없다고 느끼는 이유는?","o":["나를 제일 잘 알던 사람이야","그렇게 편한 사람이 없었어","다른 사람은 별로인 것 같아","내 기준이 높아진 것 같아"],"n":["R4-3.2.1","R4-3.2.2","R4-3.2.3","R4-3.2.4"]},"R4-3.3":{"q":"정리가 안 된 건 어떤 부분이에요?","o":["제대로 대화를 못 해봤어","왜 끝났는지 모르겠어","그 사람 물건이나 흔적이 남아 있어","아직 연락하고 지내는 사이야"],"n":["R4-3.3.1","R4-3.3.2","R4-3.3.3","R4-3.3.4"]},"R4-3.4":{"q":"이유를 모른다면 지금 마음은 어때요?","o":["그냥 습관처럼 생각나는 것 같아","외로워서 그런가 싶어","요즘 삶이 공허해서 그런가 봐","그 사람이 특별했던 것 같아"],"n":["R4-3.4.1","R4-3.4.2","R4-3.4.3","R4-3.4.4"]},"R4-4.1":{"q":"요즘 외로운 이유는 뭐 같아요?","o":["혼자 지낸 지 너무 오래됐어","주변은 다 짝이 있더라","일이나 삶이 공허하게 느껴져","사람 만날 기회가 없었어"],"n":["R4-4.1.1","R4-4.1.2","R4-4.1.3","R4-4.1.4"]},"R4-4.2":{"q":"비슷한 사람을 봤을 때 어땠어요?","o":["그 순간 깜짝 놀랐어","그냥 많이 그리웠어","마음이 너무 아팠어","오히려 담담하더라"],"n":["R4-4.2.1","R4-4.2.2","R4-4.2.3","R4-4.2.4"]},"R4-4.3":{"q":"어떤 소식을 들었어요?","o":["그 사람 결혼이나 연애 소식이야","그 사람이 잘 지낸다는 얘기야","그 사람이 힘들다는 얘기야","그 사람이 나를 찾는대"],"n":["R4-4.3.1","R4-4.3.2","R4-4.3.3","R4-4.3.4"]},"R4-4.4":{"q":"마음 한켠에 둔 채로 지내는 건 어때요?","o":["나는 아무렇지 않은 것 같아","가끔씩 마음이 아프긴 해","새 관계를 막는 것 같아","놓고 싶은데 자꾸 안 돼"],"n":["R4-4.4.1","R4-4.4.2","R4-4.4.3","R4-4.4.4"]},"R4-1.1.1":{"q":"지친 마음은 지금 좀 나아졌어요?","o":["지금은 조금 나아진 것 같아","오히려 마음이 공허해졌어","끝낸 걸 후회하게 돼","아직 잘 모르겠어"],"n":null},"R4-1.1.2":{"q":"미래가 안 보였던 이유는?","o":["서로 생각이 너무 달랐어","조건이 잘 안 맞았거든","그 사람이 안 바뀔 것 같았어","나만 노력하는 느낌이었어"],"n":null},"R4-1.1.3":{"q":"받은 상처가 아직 남아 있어요?","o":["그 상처가 아직 많이 남아 있어","조금씩 아물어 가는 중이야","생각하면 아직도 아파","그 사람 탓만은 아닌 것 같아"],"n":null},"R4-1.1.4":{"q":"식은 마음인데 왜 자꾸 생각날까요?","o":["그냥 습관처럼 떠오르는 것 같아","외로워서 생각나는 것 같아","그 사람한테 미안해서 그래","좋았던 때가 자꾸 떠올라"],"n":null},"R4-1.2.1":{"q":"예상 못 한 이별, 이유는 들었어요?","o":["들었는데 납득이 안 돼","이유를 제대로 못 들었어","내 탓인 것 같아","다른 사람이 있는 것 같아"],"n":null},"R4-1.2.2":{"q":"알고 있었는데도 힘든 이유는?","o":["그래도 기대하고 있었나 봐","막상 닥치니까 느낌이 달라","혼자가 된 게 낯설어","내가 부족했던 것 같아"],"n":null},"R4-1.2.3":{"q":"붙잡았을 때 그 사람 반응은?","o":["그 사람은 단호했어","조금 흔들리는 것 같았어","시간을 달라고 하더라","연락을 피하는 것 같았어"],"n":null},"R4-1.2.4":{"q":"그때 하지 못한 말이 있어요?","o":["미안하다는 말을 못 했어","고마웠다는 말을 못 했어","왜냐고 묻고 싶었는데 못 했어","가지 말라는 말을 못 했어"],"n":null},"R4-1.3.1":{"q":"싸움이 반복된 이유는 뭐 같아요?","o":["같은 문제로 계속 싸웠어","서로 이해를 못 했던 것 같아","둘 다 너무 예민했나 봐","사소한 게 계속 쌓였거든"],"n":null},"R4-1.3.2":{"q":"대화가 줄어든 건 누구 쪽이었어요?","o":["내가 먼저 줄인 것 같아","그 사람이 먼저 줄였어","둘 다 줄였던 것 같아","누가 먼저인지 잘 모르겠어"],"n":null},"R4-1.3.3":{"q":"상황이 달랐다면 지금도 만났을까요?","o":["상황만 달랐어도 지금도 만났을 것 같아","상황이 달라도 결국 끝났을 것 같아","솔직히 어땠을지 잘 모르겠어","그 생각을 하면 더 마음이 아파"],"n":null},"R4-1.3.4":{"q":"거리 때문에 제일 힘들었던 건?","o":["자주 못 보는 게 힘들었어","연락에만 기대야 해서 힘들었어","미래가 안 그려져서 힘들었어","그냥 너무 외로웠어"],"n":null},"R4-1.4.1":{"q":"이유를 알면 좀 나을 것 같아요?","o":["이유를 알면 훨씬 나을 것 같아","알면 오히려 더 아플 것 같아","그래도 이유는 알고 싶어","나아질지 잘 모르겠어"],"n":null},"R4-1.4.2":{"q":"버려진 기분은 지금도 남아 있어요?","o":["그 기분이 아직 많이 남아 있어","가끔씩 그 기분이 올라와","그 기분이 조금씩 줄었어","다른 관계에도 영향이 가는 것 같아"],"n":null},"R4-1.4.3":{"q":"그 화는 누구를 향해 있어요?","o":["그 사람한테 화가 나","나 자신한테 화가 나","둘 다한테 화가 나","그 상황 자체가 화가 나"],"n":null},"R4-1.4.4":{"q":"기다리는 마음을 어떻게 하고 싶어요?","o":["이 기다림을 내려놓고 싶어","한 번은 연락해보고 싶어","그냥 계속 기다리고 싶어","어떻게 하고 싶은지 모르겠어"],"n":null},"R4-2.1.1":{"q":"좋았던 기억 중 제일 자주 떠오르는 건?","o":["처음 만났을 때가 떠올라","같이 갔던 곳이 생각나","힘들 때 곁에 있어준 게 떠올라","사소한 일상이 제일 생각나"],"n":null},"R4-2.1.2":{"q":"잘못했다고 느끼는 건 뭐예요?","o":["내가 너무 예민했던 것 같아","표현을 못 한 게 후회돼","상처 준 말이 계속 걸려","붙잡지 못한 게 후회돼"],"n":null},"R4-2.1.3":{"q":"다시 만나면 달라질 것 같아요?","o":["이번엔 잘할 수 있을 것 같아","결국 똑같을 것 같아","반반인 것 같아","그냥 상상만 해보는 거야"],"n":null},"R4-2.1.4":{"q":"그 사람 근황이 궁금한 이유는?","o":["아직 좋아해서 궁금한 거야","잘 지내는지 걱정돼서 그래","나만 힘든지 확인하고 싶어","그냥 습관처럼 궁금해져"],"n":null},"R4-2.2.1":{"q":"울컥한 마음은 어떻게 달래요?","o":["그냥 울면서 풀어","다른 걸로 마음을 돌려","친구한테 연락해서 풀어","꾹 참고 넘기는 편이야"],"n":null},"R4-2.2.2":{"q":"피하는 게 많아져서 불편하진 않아요?","o":["생활이 점점 좁아진 것 같아","아직은 괜찮은 것 같아","피하는 게 오히려 더 힘들어","언젠간 괜찮아지겠지 싶어"],"n":null},"R4-2.2.3":{"q":"그리움이 클 때 연락하고 싶어져요?","o":["그리울 때마다 연락하고 싶어","가끔 연락하고 싶어져","연락하고 싶은 걸 참고 있어","실제로 연락해본 적도 있어"],"n":null},"R4-2.2.4":{"q":"덤덤해진 걸 느낄 때 어떤 마음이에요?","o":["덤덤해져서 다행인 것 같아","덤덤한 게 조금 서운해","덤덤한 내가 좀 이상해","아직 확신은 안 서"],"n":null},"R4-2.3.1":{"q":"잘 지내는 모습이 왜 서운해요?","o":["나만 힘든 것 같아서 서운해","나 없이도 괜찮아 보여서 그래","내가 아직 좋아해서 그래","나랑 비교가 돼서 그래"],"n":null},"R4-2.3.2":{"q":"새 사람이 있다면 어떨 것 같아요?","o":["그러면 많이 힘들 것 같아","그래야 나도 정리될 것 같아","그런 건 상상하기도 싫어","그래도 축하해주고 싶긴 해"],"n":null},"R4-2.3.3":{"q":"나만 못 잊었다는 생각이 들면 어때요?","o":["그런 생각이 들면 비참해져","내가 바보 같다는 생각이 들어","그래도 어쩔 수 없다 싶어","이제 그만하고 싶어져"],"n":null},"R4-2.3.4":{"q":"그만 보려면 뭐가 필요할까요?","o":["차단하거나 숨김 처리해야 해","바쁜 일상이 필요한 것 같아","새로운 관심사가 생기면 좋겠어","아직은 못 끊을 것 같아"],"n":null},"R4-2.4.1":{"q":"비교할 때 그 사람이 더 좋게 느껴져요?","o":["대부분 그 사람이 더 좋아 보여","좋은 점만 기억나서 그런 것 같아","비교하는 내가 싫어져","꼭 그 사람이 낫진 않아"],"n":null},"R4-2.4.2":{"q":"마음이 안 열리는 이유는?","o":["또 상처받을까 봐 겁나","아직 마음에 그 사람이 있어","너무 지쳐서 마음이 안 열려","나한테 맞는 사람이 없는 것 같아"],"n":null},"R4-2.4.3":{"q":"누구한테 미안한 마음이 들어요?","o":["새로 만난 사람한테 미안해","예전 그 사람한테 미안해","나 자신한테 미안한 것 같아","누구한테 미안한 건지 모르겠어"],"n":null},"R4-2.4.4":{"q":"만날 생각이 없는 지금은 괜찮아요?","o":["지금은 혼자가 편한 것 같아","솔직히 외롭긴 해","아직 준비가 안 된 것 같아","정리부터 하고 싶어"],"n":null},"R4-3.1.1":{"q":"아직 좋아한다면 어떻게 하고 싶어요?","o":["다시 만나고 싶은 마음이야","그냥 마음에 담아두고 싶어","이제는 정리하고 싶어","어떻게 하고 싶은지 모르겠어"],"n":null},"R4-3.1.2":{"q":"미련은 무엇에 대한 거예요?","o":["그 사람 자체에 미련이 남아","함께한 시간이 아쉬워서 그래","이루지 못한 계획이 아쉬워","내가 못 해준 게 마음에 걸려"],"n":null},"R4-3.1.3":{"q":"고마운 마음을 전하고 싶어요?","o":["응, 꼭 전하고 싶어","마음속으로만 간직할래","전할 방법이 없는 것 같아","아직은 전하고 싶지 않아"],"n":null},"R4-3.1.4":{"q":"미안한 마음은 어디서 와요?","o":["내가 한 상처 준 말 때문이야","끝낸 방식이 마음에 걸려","끝까지 노력 못 한 게 미안해","어디서 오는지 잘 모르겠어"],"n":null},"R4-3.2.1":{"q":"나를 잘 알아줬던 순간은?","o":["말 안 해도 알아주는 사람이었어","힘들 때 늘 옆에 있어줬어","내 단점도 다 받아줬어","내 취향을 다 기억해줬어"],"n":null},"R4-3.2.2":{"q":"그 편안함을 다른 데서 느껴본 적 있어요?","o":["그런 편안함은 전혀 못 느꼈어","친구한테선 조금 느꼈어","가족한테선 느낀 적 있어","아직 그런 사람을 찾는 중이야"],"n":null},"R4-3.2.3":{"q":"다른 사람이 별로인 이유는?","o":["자꾸 그 사람이랑 비교돼서 그래","내가 마음을 안 열어서 그런 것 같아","진짜로 안 맞는 것 같아","만날 기회가 없어서 그런 것 같아"],"n":null},"R4-3.2.4":{"q":"높아진 기준이 나를 지키는 걸까요?","o":["나를 지켜주는 기준인 것 같아","오히려 나를 막고 있는 것 같아","지키기도 하고 막기도 하는 것 같아","아직은 잘 모르겠어"],"n":null},"R4-3.3.1":{"q":"마지막으로 나누고 싶은 대화는?","o":["왜 끝났는지 묻고 싶어","서로 고마웠던 걸 말하고 싶어","미안했던 걸 말하고 싶어","잘 지내라고 인사하고 싶어"],"n":null},"R4-3.3.2":{"q":"이유를 모르면 어떤 마음이 계속돼요?","o":["내 탓인 것 같아 계속 마음에 걸려","억울한 마음이 계속 들어","자꾸 이유를 추측하게 돼","다음 관계가 무서워져"],"n":null},"R4-3.3.3":{"q":"흔적을 치우지 못하는 이유는?","o":["아직 마음이 안 따라줘서 그래","버리면 다 끝날 것 같아서 그래","그게 내 기억이라서 못 버려","솔직히 귀찮아서 그래"],"n":null},"R4-3.3.4":{"q":"연락하고 지내는 게 도움이 돼요?","o":["연락하니까 오히려 정리가 안 돼","친구로 지내는 게 좋은 것 같아","다시 만날 희망이 생기곤 해","이제 끊어야 할 것 같아"],"n":null},"R4-3.4.1":{"q":"습관을 끊는다면 뭘 바꿔볼까요?","o":["생각나면 다른 걸 해볼까 해","SNS를 안 보면 좋을 것 같아","새로운 루틴을 만들어볼까 해","뭘 바꿔야 할지 모르겠어"],"n":null},"R4-3.4.2":{"q":"외로움이 클 때는 언제예요?","o":["주말에 제일 외로운 것 같아","밤이 되면 더 외로워져","기념일 같은 날엔 외로워","친구들 연애하는 걸 보면 외로워"],"n":null},"R4-3.4.3":{"q":"지금 삶에서 비어 있는 건?","o":["요즘 설렘이 하나도 없어","함께할 사람이 없는 것 같아","삶의 목표가 없는 것 같아","즐거운 일이 별로 없어"],"n":null},"R4-3.4.4":{"q":"그 사람이 특별했던 이유는?","o":["그 사람이 내 처음이었거든","가장 오래 만난 사람이야","가장 힘들 때 만난 사람이야","나를 바꿔준 사람이었어"],"n":null},"R4-4.1.1":{"q":"오래 혼자 지내면서 달라진 건?","o":["이제는 혼자가 편해졌어","누군가한테 다가가는 게 어려워졌어","기대하는 게 점점 줄었어","오히려 더 외로워졌어"],"n":null},"R4-4.1.2":{"q":"주변 커플들을 보면 어떤 마음이에요?","o":["커플들 보면 솔직히 부러워","보면 괜히 조급해져","혼자도 괜찮다 싶기도 해","그럴 때 그 사람이 떠올라"],"n":null},"R4-4.1.3":{"q":"공허함은 어디서 오는 것 같아요?","o":["반복되는 일상 때문인 것 같아","목표가 없어서 그런 것 같아","털어놓을 사람이 없어서 그래","어디서 오는지 잘 모르겠어"],"n":null},"R4-4.1.4":{"q":"사람 만날 기회를 만든다면?","o":["소개를 받아볼까 해","모임이나 취미를 찾아볼까 해","앱을 써볼까 싶기도 해","아직 어떻게 할지 모르겠어"],"n":null},"R4-4.2.1":{"q":"그 순간 무슨 생각이 들었어요?","o":["혹시 그 사람일까 싶었어","잘 지내고 있을까 궁금했어","다시 보고 싶다는 생각이 들었어","지나간 일이라고 생각했어"],"n":null},"R4-4.2.2":{"q":"그리움은 그 사람일까요, 그때의 나일까요?","o":["내가 그리운 건 그 사람이야","그때의 내가 그리운 것 같아","그 사람도 나도 다 그리워","어느 쪽인지 잘 모르겠어"],"n":null},"R4-4.2.3":{"q":"아직 아픈 이유는?","o":["끝이 미완성 같아서 아파","내가 상처를 줘서 아픈 것 같아","그 사람이 너무 소중했거든","다시 못 볼 것 같아서 아파"],"n":null},"R4-4.2.4":{"q":"담담했다면 이제 정리된 걸까요?","o":["거의 정리된 것 같아","겉으로만 담담한 것 같아","정리된 줄 알았는데 아니야","정리됐는지 잘 모르겠어"],"n":null},"R4-4.3.1":{"q":"그 소식에 어떤 마음이 들었어요?","o":["진심으로 축하해주고 싶어","마음이 와르르 무너졌어","이제 진짜 끝이구나 싶었어","생각보다 덤덤하더라"],"n":null},"R4-4.3.2":{"q":"잘 지낸다니 어떤 생각이 들어요?","o":["잘 지낸다니 다행이다 싶어","나만 제자리인 것 같아","잘 지낸다니 좀 서운해","나도 잘 지내고 싶어졌어"],"n":null},"R4-4.3.3":{"q":"힘들다는 소식에 어떻게 하고 싶어요?","o":["연락해보고 싶은 마음이 들어","걱정만 되고 어쩌지 못하겠어","내 일이 아니라고 생각해","마음이 자꾸 흔들려"],"n":null},"R4-4.3.4":{"q":"나를 찾는다니 어떤 마음이에요?","o":["솔직히 마음이 설레","한편으로는 불안해","다시 상처받을까 봐 무서워","한번 만나보고 싶어"],"n":null},"R4-4.4.1":{"q":"아무렇지 않은데 왜 지금 이 고민을 골랐어요?","o":["그냥 문득 궁금해서 골랐어","사실은 신경이 쓰였나 봐","이제 정리하고 싶어서 골랐어","나도 왜 골랐는지 모르겠어"],"n":null},"R4-4.4.2":{"q":"아플 때는 어떻게 지나가요?","o":["그냥 꾹 견디고 말아","다른 데 집중하면서 넘겨","누구한테 얘기하면서 풀어","혼자 울면서 보내"],"n":null},"R4-4.4.3":{"q":"새 관계를 막는다고 느낀 순간은?","o":["다가오는 사람을 밀어냈던 적 있어","자꾸 그 사람이랑 비교했어","누굴 만나도 설렘이 안 생겨","새로 시작하는 게 무서워"],"n":null},"R4-4.4.4":{"q":"놓으려면 뭐가 필요할까요?","o":["그 사람과 마지막 대화가 필요해","그냥 시간이 필요한 것 같아","새로운 사람이 필요한 것 같아","나를 용서하는 게 필요해"],"n":null}}}