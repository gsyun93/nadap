{"start":"M2-0","nodes":{"M2-0":{"q":"주로 누구랑 비교하게 돼요?","o":["친구들","SNS 속 사람들","형제나 가족","같은 나이 또래 전체"],"n":["M2-1","M2-2","M2-3","M2-4"]},"M2-1":{"q":"친구들의 어떤 모습과 비교돼요?","o":["친구들 직장이랑 연봉이 신경 쓰여","친구들 결혼이나 연애가 눈에 들어와","친구들 집이나 재산이 비교돼","하고 싶은 일 하는 모습이 부러워"],"n":["M2-1.1","M2-1.2","M2-1.3","M2-1.4"]},"M2-2":{"q":"SNS에서 어떤 걸 볼 때 제일 비교돼요?","o":["여행 다니는 여유가 제일 부러워","성공하고 돈 번 모습이 비교돼","외모나 몸 보면 나도 모르게 비교해","관계나 연애 올린 게 눈에 밟혀"],"n":["M2-2.1","M2-2.2","M2-2.3","M2-2.4"]},"M2-3":{"q":"가족 중 누구와 비교돼요?","o":["형제자매랑 비교될 때가 많아","사촌이나 친척이랑 비교돼","부모님 세대랑 비교하게 돼","남의 집 자식 얘기가 제일 힘들어"],"n":["M2-3.1","M2-3.2","M2-3.3","M2-3.4"]},"M2-4":{"q":"또래 전체와 비교할 때 뭐가 제일 늦은 것 같아요?","o":["커리어가 제일 늦은 것 같아","결혼이나 가정이 늦은 것 같아","돈이나 집이 제일 늦은 것 같아","나만의 무언가가 없어서 늦은 것 같아"],"n":["M2-4.1","M2-4.2","M2-4.3","M2-4.4"]},"M2-1.1":{"q":"친구 직장 얘기를 들으면 어떤 마음이에요?","o":["친구 직장이 그냥 부러워","듣고 나면 내가 초라해 보여","오히려 자극이 되는 것 같아","그 얘기가 나오면 자꾸 피하게 돼"],"n":["M2-1.1.1","M2-1.1.2","M2-1.1.3","M2-1.1.4"]},"M2-1.2":{"q":"친구들 결혼이나 연애 소식에 어떤 마음이에요?","o":["축하는 하는데 마음이 조급해","나만 혼자인 것 같아서 쓸쓸해","부럽진 않은데 자꾸 신경 쓰여","주변에서 자꾸 물어봐서 힘들어"],"n":["M2-1.2.1","M2-1.2.2","M2-1.2.3","M2-1.2.4"]},"M2-1.3":{"q":"집이나 재산 얘기에서 뭐가 걸려요?","o":["나만 모아둔 게 없는 것 같아","부모님 도움 차이가 크게 느껴져","투자로 번 사람들 얘기가 걸려","내 집 마련이 제일 마음에 걸려"],"n":["M2-1.3.1","M2-1.3.2","M2-1.3.3","M2-1.3.4"]},"M2-1.4":{"q":"하고 싶은 일 하는 친구를 보면?","o":["그 용기가 정말 부러워","나도 한번 해볼까 싶어져","나는 왜 못 하나 싶어","응원하면서도 마음이 씁쓸해"],"n":["M2-1.4.1","M2-1.4.2","M2-1.4.3","M2-1.4.4"]},"M2-2.1":{"q":"여유로운 모습을 보면 어떤 마음이에요?","o":["나만 바쁘게 사는 것 같아","보다 보면 훌쩍 떠나고 싶어져","부럽긴 한데 현실은 안 돼","그냥 별생각 없이 넘겨"],"n":["M2-2.1.1","M2-2.1.2","M2-2.1.3","M2-2.1.4"]},"M2-2.2":{"q":"성공한 사람들을 보면 어떤 생각이 들어요?","o":["나는 지금 뭐 하고 있나 싶어","저 사람은 운이 좋았겠지 싶어","나도 저렇게 되고 싶어","보고 있으면 괜히 피곤해져"],"n":["M2-2.2.1","M2-2.2.2","M2-2.2.3","M2-2.2.4"]},"M2-2.3":{"q":"외모나 몸을 보면 어떤 마음이에요?","o":["보다 보면 내 모습이 싫어져","나도 관리해야겠다 싶어","다 보정한 거겠지 싶어","자존감이 자꾸 떨어지는 것 같아"],"n":["M2-2.3.1","M2-2.3.2","M2-2.3.3","M2-2.3.4"]},"M2-2.4":{"q":"행복한 관계를 보면 어떤 마음이에요?","o":["나만 혼자인 것 같아","그냥 부러운 마음이 들어","내 관계가 초라하게 느껴져","저게 진짜일까 싶어"],"n":["M2-2.4.1","M2-2.4.2","M2-2.4.3","M2-2.4.4"]},"M2-3.1":{"q":"형제와 어떤 부분이 비교돼요?","o":["직업이나 돈 차이가 신경 쓰여","결혼이나 가정 쪽이 비교돼","부모님 사랑이 다른 것 같아","성격이나 능력이 비교돼"],"n":["M2-3.1.1","M2-3.1.2","M2-3.1.3","M2-3.1.4"]},"M2-3.2":{"q":"친척들 사이에서 어떤 일이 있어요?","o":["명절마다 비교당하는 게 싫어","근황 묻는 게 너무 부담돼","잘된 친척 얘기만 해서 힘들어","아예 안 가고 싶은 마음이야"],"n":["M2-3.2.1","M2-3.2.2","M2-3.2.3","M2-3.2.4"]},"M2-3.3":{"q":"부모님 세대와 비교하면 어떤 생각이 들어요?","o":["그 나이엔 다 이뤘다는 게 걸려","시대가 다른데도 자꾸 비교돼","부모님 기대가 너무 무거워","나는 그렇게 못 살 것 같아"],"n":["M2-3.3.1","M2-3.3.2","M2-3.3.3","M2-3.3.4"]},"M2-3.4":{"q":"남의 집 자식 얘기를 들으면 어때요?","o":["비교당하는 게 정말 싫어","부모님을 실망시킨 것 같아","듣다 보면 반발심이 들어","이제는 그냥 무덤덤해졌어"],"n":["M2-3.4.1","M2-3.4.2","M2-3.4.3","M2-3.4.4"]},"M2-4.1":{"q":"커리어에서 늦었다고 느끼는 부분은?","o":["직급이 제일 늦은 것 같아","연봉이 많이 뒤처진 것 같아","전문성이 부족하다고 느껴져","회사를 자주 옮긴 게 마음에 걸려"],"n":["M2-4.1.1","M2-4.1.2","M2-4.1.3","M2-4.1.4"]},"M2-4.2":{"q":"결혼이나 가정에서 조급함이 느껴질 때는?","o":["친구 결혼식 갈 때 조급해져","부모님 말씀 들으면 조급해져","혼자 있는 밤에 조급해져","아이를 보면 마음이 조급해져"],"n":["M2-4.2.1","M2-4.2.2","M2-4.2.3","M2-4.2.4"]},"M2-4.3":{"q":"돈이나 집에서 늦었다고 느끼는 이유는?","o":["모아둔 게 너무 적은 것 같아","집값이 너무 올라서 막막해","시작 자체가 늦었던 것 같아","빚이 있어서 마음이 무거워"],"n":["M2-4.3.1","M2-4.3.2","M2-4.3.3","M2-4.3.4"]},"M2-4.4":{"q":"나만의 무언가가 없다고 느끼는 이유는?","o":["나는 잘하는 게 없는 것 같아","딱히 취미라고 할 것도 없어","내 이야기라고 할 게 없어","내 모습이 다 평범한 것 같아"],"n":["M2-4.4.1","M2-4.4.2","M2-4.4.3","M2-4.4.4"]},"M2-1.1.1":{"q":"제일 부러운 건 뭐예요?","o":["친구 연봉이 제일 부러워","회사 이름이 제일 부러워","일하는 환경이 제일 부러워","인정받는 모습이 제일 부러워"],"n":null},"M2-1.1.2":{"q":"초라함이 느껴질 때 어떻게 해요?","o":["그럴 땐 혼자 속으로 삭여","괜히 센 척하게 돼","모임을 슬쩍 피하게 돼","털어놓을 친구가 있긴 해"],"n":null},"M2-1.1.3":{"q":"자극을 받으면 행동으로 이어져요?","o":["자극받으면 공고부터 찾아봐","다짐만 하고 끝나는 편이야","며칠 가다가 흐지부지돼","실제로 바꿔본 적도 있어"],"n":null},"M2-1.1.4":{"q":"피하면 친구 관계는 어때져요?","o":["친구랑 조금씩 멀어지는 것 같아","피해도 관계는 그대로야","나만 혼자 불편한 것 같아","친구한테 괜히 미안해져"],"n":null},"M2-1.2.1":{"q":"조급함은 어디서 와요?","o":["내 나이 때문에 조급해져","부모님 때문에 조급해져","혼자 늙을까 봐 걱정돼","친구들이 멀어질까 봐 불안해"],"n":null},"M2-1.2.2":{"q":"혼자라는 느낌이 들 때 어떻게 해요?","o":["혼자 있는 걸 즐겨보려고 해","소개라도 받아볼까 싶어","오히려 더 외로워지기도 해","그럴 땐 일에 몰두하게 돼"],"n":null},"M2-1.2.3":{"q":"부럽지 않은데 신경 쓰이는 이유는?","o":["나만 비교당할까 봐 신경 쓰여","내가 뒤처진 것 같아서 그래","대화에 못 끼는 게 싫어서야","왜 신경 쓰이는지 나도 모르겠어"],"n":null},"M2-1.2.4":{"q":"사람들이 물어보면 어떻게 답해요?","o":["그냥 웃으면서 넘겨","아직 생각 없다고 말해","솔직히 불편하다고 말해","대답을 슬쩍 피하게 돼"],"n":null},"M2-1.3.1":{"q":"모은 게 없다고 느낄 때 드는 생각은?","o":["그동안 나는 뭐 했나 싶어","지금이라도 시작해야지 싶어","어차피 안 될 것 같아","그냥 남 일이라고 생각해"],"n":null},"M2-1.3.2":{"q":"출발선이 다르다고 느낄 때 어떤 마음이에요?","o":["솔직히 좀 억울한 마음이 들어","어쩔 수 없는 거라고 생각해","내 힘으로 해내고 싶어","부모님께 괜히 미안해져"],"n":null},"M2-1.3.3":{"q":"투자 얘기를 들으면 어때요?","o":["나도 투자해야 하나 싶어","솔직히 좀 겁이 나","나는 이미 늦은 것 같아","투자엔 별로 관심이 없어"],"n":null},"M2-1.3.4":{"q":"내 집은 어떻게 생각하고 있어요?","o":["내 집은 꼭 갖고 싶어","내 집은 이미 포기했어","언젠간 되겠지 싶어","굳이 내 집이 필요 없어"],"n":null},"M2-1.4.1":{"q":"그 용기는 어디서 나온 것 같아요?","o":["여유가 있어서 가능한 것 같아","원래 그런 성격이라 그럴 것 같아","확신이 있어서 그런 것 같아","어디서 나오는지 나도 모르겠어"],"n":null},"M2-1.4.2":{"q":"나도 해보고 싶은 게 있어요?","o":["해보고 싶은 건 있는데 못 해","아직 뭘 하고 싶은지 모르겠어","그냥 생각만 하고 있어","조금씩 준비하는 중이야"],"n":null},"M2-1.4.3":{"q":"못 하는 이유를 하나만 꼽는다면?","o":["돈이 제일 걸려서 못 해","시간이 없어서 못 하는 것 같아","겁이 나서 못 하는 것 같아","방향을 몰라서 못 하고 있어"],"n":null},"M2-1.4.4":{"q":"씁쓸함은 어디서 와요?","o":["나만 제자리인 것 같아서 그래","질투가 나서 그런 것 같아","나도 할 수 있었는데 싶어서야","요즘 너무 지쳐서 그런 것 같아"],"n":null},"M2-2.1.1":{"q":"바쁜 일상에서 제일 아쉬운 건?","o":["쉴 시간이 없는 게 아쉬워","나를 위한 시간이 없어서 아쉬워","사람 만날 시간이 없어서 아쉬워","생각할 시간이 없어서 아쉬워"],"n":null},"M2-2.1.2":{"q":"떠난다면 어디로 가고 싶어요?","o":["바다로 훌쩍 떠나고 싶어","해외로 멀리 떠나고 싶어","조용한 시골로 가고 싶어","어디든 일단 떠나고 싶어"],"n":null},"M2-2.1.3":{"q":"현실이 안 되는 이유는?","o":["돈이 부족해서 안 돼","휴가를 내기가 어려워","같이 갈 사람이 없어","마음의 여유가 없어서 안 돼"],"n":null},"M2-2.1.4":{"q":"그냥 넘길 수 있는 비결이 있어요?","o":["다 보여주기라는 걸 알고 있어","그냥 안 보려고 노력해","아직은 잘 안 넘어가","원래 별로 관심이 없어"],"n":null},"M2-2.2.1":{"q":"지금 하고 있는 걸 어떻게 평가해요?","o":["나는 아무것도 안 하는 것 같아","나름 열심히 하고 있어","방향이 틀린 것 같아","지금 상태를 잘 모르겠어"],"n":null},"M2-2.2.2":{"q":"운이라고 생각하면 마음이 편해요?","o":["운이라 생각하면 조금 편해져","그래도 여전히 부러워","운이라는 말이 핑계 같기도 해","진짜 운이 좋았던 거야"],"n":null},"M2-2.2.3":{"q":"나도 하고 싶은 성공은 어떤 거예요?","o":["나도 돈을 많이 벌고 싶어","나도 인정받는 성공을 하고 싶어","나도 자유로운 성공을 하고 싶어","내 이름을 걸고 성공하고 싶어"],"n":null},"M2-2.2.4":{"q":"보는 게 피곤하면 왜 계속 보게 될까요?","o":["그냥 습관이라서 계속 보게 돼","자극이 필요해서 계속 보게 돼","심심해서 계속 보게 돼","나도 모르게 계속 보고 있어"],"n":null},"M2-2.3.1":{"q":"내 모습 중 제일 신경 쓰이는 건?","o":["내 얼굴이 제일 신경 쓰여","내 몸이 제일 신경 쓰여","옷이나 스타일이 신경 쓰여","내 분위기가 제일 신경 쓰여"],"n":null},"M2-2.3.2":{"q":"관리를 시작하면 오래 가요?","o":["관리해도 며칠 가다 말아","시작하면 꾸준히 하는 편이야","시작하는 게 제일 어려워","관리할 여유가 없어"],"n":null},"M2-2.3.3":{"q":"보정이라는 걸 알아도 신경 쓰이는 이유는?","o":["알아도 결국 비교가 돼","남들도 그렇게 볼까 봐 걱정돼","나도 그렇게 되고 싶어서야","왜 신경 쓰이는지 모르겠어"],"n":null},"M2-2.3.4":{"q":"자존감이 떨어지면 어떻게 돼요?","o":["자존감 떨어지면 사람을 피해","거울을 아예 안 보게 돼","괜히 짜증이 많이 나","오히려 더 자꾸 보게 돼"],"n":null},"M2-2.4.1":{"q":"혼자라는 느낌은 언제 제일 커요?","o":["주말에 혼자라는 느낌이 제일 커","밤이 되면 혼자라는 느낌이 커","기념일에 혼자라는 게 크게 느껴져","힘든 일이 있을 때 제일 커져"],"n":null},"M2-2.4.2":{"q":"어떤 관계가 부러워요?","o":["연인 사이가 제일 부러워","친구 무리가 제일 부러워","가족 관계가 제일 부러워","동료 관계가 제일 부러워"],"n":null},"M2-2.4.3":{"q":"내 관계에서 아쉬운 건?","o":["깊은 대화가 없어서 아쉬워","함께하는 시간이 적어서 아쉬워","표현을 잘 못 해서 아쉬워","아는 사람 수가 적어서 아쉬워"],"n":null},"M2-2.4.4":{"q":"진짜가 아니라면 왜 그렇게 올릴까요?","o":["보여주고 싶어서 올리는 거야","외로워서 올리는 걸 거야","그냥 습관이라서 올리는 거야","진짜일 수도 있다고 생각해"],"n":null},"M2-3.1.1":{"q":"직업이나 돈 차이가 나를 어떻게 만들어요?","o":["그 차이 때문에 내가 작아져","오히려 자극이 되기도 해","가족 모임이 불편해져","별로 신경 안 쓰는 편이야"],"n":null},"M2-3.1.2":{"q":"형제의 가정을 보면 어떤 마음이에요?","o":["형제 가정이 부럽게 느껴져","그 모습이 괜히 부담돼","나는 나대로 다른 길이야","보고 있으면 마음이 조급해져"],"n":null},"M2-3.1.3":{"q":"부모님 사랑이 기울었다고 느낀 때는?","o":["어릴 때부터 그렇게 느꼈어","성인이 되고 나서부터 느꼈어","형제가 잘되면서부터 느꼈어","지금도 계속 그렇게 느껴져"],"n":null},"M2-3.1.4":{"q":"성격이나 능력 비교는 누가 해요?","o":["주로 부모님이 비교하셔","친척들이 많이 비교해","형제 본인이 비교하는 것 같아","사실 나 스스로 비교해"],"n":null},"M2-3.2.1":{"q":"명절에 제일 듣기 싫은 말은?","o":["취업이나 연봉 얘기가 듣기 싫어","결혼은 언제 하냐는 말이 싫어","누구는 어떻다더라 하는 말이 싫어","살이 빠졌네 쪘네 하는 말이 싫어"],"n":null},"M2-3.2.2":{"q":"근황을 물을 때 어떻게 대답해요?","o":["그냥 잘 지낸다고 대답해","대충 둘러대고 넘어가","솔직하게 말하는 편이야","불편해서 자리를 피하게 돼"],"n":null},"M2-3.2.3":{"q":"잘된 친척 얘기를 들으면?","o":["나는 뭐 하나 싶어져","부모님 표정이 신경 쓰여","그냥 흘려듣고 말아","솔직히 화가 나"],"n":null},"M2-3.2.4":{"q":"안 가고 싶은데 가는 이유는?","o":["부모님 때문에 가는 거야","안 가면 더 말이 나올 것 같아","그래도 가족이라서 가는 거야","이번엔 안 갈 거야"],"n":null},"M2-3.3.1":{"q":"부모님이 그 나이에 이룬 것 중 제일 걸리는 건?","o":["그 나이에 집이 있었던 게 걸려","결혼과 자녀가 제일 걸려","안정된 직장이 제일 걸려","가족을 부양한 게 제일 걸려"],"n":null},"M2-3.3.2":{"q":"시대가 다르다는 걸 알면서도 비교되는 이유는?","o":["부모님이 자꾸 비교하셔서 그래","나도 그 기준으로 자라서 그래","주변도 다 그렇게 보니까 그래","왜 비교되는지 모르겠어"],"n":null},"M2-3.3.3":{"q":"부모님 기대 중 제일 무거운 건?","o":["안정적인 직업이 제일 무거워","결혼해야 한다는 게 제일 무거워","효도해야 한다는 게 제일 무거워","성공해야 한다는 게 제일 무거워"],"n":null},"M2-3.3.4":{"q":"그렇게 못 산다면 어떻게 살고 싶어요?","o":["내 방식대로 살고 싶어","조금 느리게 살고 싶어","어떻게 살지 아직 모르겠어","그래도 따라가고 싶긴 해"],"n":null},"M2-3.4.1":{"q":"그 말에 어떻게 반응해요?","o":["그냥 듣고만 있어","그만하라고 말하는 편이야","말없이 방으로 들어가","웃어넘기고 말아"],"n":null},"M2-3.4.2":{"q":"실망시켰다는 마음은 언제 제일 커요?","o":["부모님 표정 볼 때 제일 커져","친척 모임 때 제일 커져","혼자 생각할 때 제일 커져","부모님이 늙어 보일 때 커져"],"n":null},"M2-3.4.3":{"q":"반발심이 들면 어떻게 돼요?","o":["일부러 반대로 하고 싶어져","더 증명하고 싶어져","대화를 그냥 끊어버려","속으로만 화가 나"],"n":null},"M2-3.4.4":{"q":"무덤덤해진 건 괜찮은 걸까요?","o":["이렇게 무덤덤한 게 편해","그냥 포기한 것 같기도 해","아직 상처는 남아 있어","괜찮은 건지 모르겠어"],"n":null},"M2-4.1.1":{"q":"직급이 걸리는 이유는?","o":["후배가 나보다 앞서가는 게 걸려","나이에 비해 직급이 낮은 것 같아","인정받지 못하는 느낌이 들어","이직할 때 불리할 것 같아"],"n":null},"M2-4.1.2":{"q":"연봉 차이를 느낀 계기는?","o":["친구 얘기를 듣고 느꼈어","공고나 통계를 보고 느꼈어","이직 면접에서 느꼈어","그냥 느낌이 그랬어"],"n":null},"M2-4.1.3":{"q":"전문성이 부족하다고 느끼는 이유는?","o":["한 분야를 오래 못 해서 그래","내세울 게 없는 것 같아서 그래","배울 기회가 없었던 것 같아","그냥 나한테 자신이 없어서야"],"n":null},"M2-4.1.4":{"q":"회사를 자주 옮긴 게 어떻게 느껴져요?","o":["자주 옮긴 게 후회돼","그래도 경험은 쌓였어","이력서가 걱정돼","옮길 때마다 이유가 있었어"],"n":null},"M2-4.2.1":{"q":"결혼식에 다녀오면 어떤 마음이에요?","o":["축하하면서도 마음이 허전해","다녀오면 나도 하고 싶어져","결혼식이 괜히 부담돼","별생각 없이 다녀와"],"n":null},"M2-4.2.2":{"q":"부모님은 뭐라고 하세요?","o":["빨리 하라고 하셔","걱정을 많이 하셔","말은 안 하셔도 느껴져","아무 말도 안 하셔"],"n":null},"M2-4.2.3":{"q":"혼자인 밤에 드는 생각은?","o":["이대로 혼자일까 싶어","편하긴 한데 외롭기도 해","누군가 곁에 있었으면 해","그냥 생각 안 하려고 해"],"n":null},"M2-4.2.4":{"q":"아이를 보면 어떤 마음이 들어요?","o":["나도 아이를 갖고 싶어","나한테 시간이 없는 것 같아","나는 못 할 것 같아","아직은 잘 모르겠어"],"n":null},"M2-4.3.1":{"q":"지금부터 모으면 따라잡을 수 있을까요?","o":["지금부터 해도 가능할 것 같아","따라잡기 어려울 것 같아","굳이 따라잡을 필요 없어","솔직히 잘 모르겠어"],"n":null},"M2-4.3.2":{"q":"집값을 보면 어떤 마음이에요?","o":["보면 그냥 포기하게 돼","솔직히 화가 나","언젠간 되겠지 싶어","나랑은 먼 남 얘기 같아"],"n":null},"M2-4.3.3":{"q":"시작이 늦어진 이유는?","o":["공부가 길어서 늦어졌어","일을 늦게 시작해서 그래","돈 관리를 안 해서 그래","가족을 돕느라 늦어졌어"],"n":null},"M2-4.3.4":{"q":"빚이 있는 게 나를 어떻게 만들어요?","o":["빚 때문에 마음이 조급해져","빚 때문에 자꾸 위축돼","오히려 더 열심히 하게 돼","빚 때문에 무기력해져"],"n":null},"M2-4.4.1":{"q":"잘하는 게 없다고 느끼는 순간은?","o":["자기소개할 때 그런 생각이 들어","남들 재능 볼 때 그런 생각이 들어","일에서 밀릴 때 그런 생각이 들어","그냥 늘 그렇게 느껴져"],"n":null},"M2-4.4.2":{"q":"취미를 찾아본 적 있어요?","o":["해봤는데 오래 못 갔어","시간이 없어서 못 찾았어","뭘 해야 할지 모르겠어","지금 찾는 중이야"],"n":null},"M2-4.4.3":{"q":"내 이야기가 있다면 어떤 거였으면 해요?","o":["도전한 이야기가 있었으면 해","누군가를 도운 이야기면 좋겠어","좋아하는 걸 해낸 이야기면 해","어떤 게 좋을지 모르겠어"],"n":null},"M2-4.4.4":{"q":"평범하다는 게 왜 싫어요?","o":["나도 특별해지고 싶어서야","기억되는 사람이 되고 싶어서야","남들은 다 특별해 보여서야","사실 평범한 게 나쁘진 않아"],"n":null}}}