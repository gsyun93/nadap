# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 넣으세요.
# .env.local 은 git에 올라가지 않습니다. API 키는 서버에서만 쓰이고 브라우저로 가지 않아요.
# 키가 비어 있으면 예비(FALLBACK) 질문과 예시 결과로 화면을 끝까지 돌려볼 수 있어요.

# ── 질문 생성용 (빠르고 싼 모델, 상담 1회에 수십~100번 호출) ──
# 회사: anthropic | google | openai
QUESTION_PROVIDER=
# 모델 ID (예: claude-haiku-5-5 / gemini-3.1-flash-lite / gpt-5.4-nano)
QUESTION_MODEL=
QUESTION_API_KEY=

# ── 결과 생성용 (똑똑한 모델, 상담 1회에 1번, 스트리밍) ──
# 회사: anthropic | google | openai
RESULT_PROVIDER=
# 모델 ID (예: claude-sonnet-5-5 / claude-opus-5-5 / gemini-3.1-pro-preview)
RESULT_MODEL=
RESULT_API_KEY=
